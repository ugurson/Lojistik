@page
@model Lojistik.Pages.SistemAdmin.Firmalar.CreateModel
@{
    ViewData["Title"] = "Yeni Firma";
}

<style>
    .form-card { background:white; border:1px solid #e2e8f0; border-radius:12px; padding:28px 32px; }
    .section-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px;
                     color:#94a3b8; margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid #f1f5f9; }
    .form-label { font-size:12px; font-weight:600; color:#374151; margin-bottom:4px; }
    .required::after { content:" *"; color:#ef4444; }
</style>

<!-- Başlık -->
<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/SistemAdmin/Firmalar" class="btn btn-sm btn-outline-secondary">← Geri</a>
    <div>
        <h5 class="mb-0" style="color:#1e293b;font-weight:700;">➕ Yeni Firma Ekle</h5>
        <small style="color:#64748b;">Sisteme yeni bir program firması kaydedilecek</small>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Hata))
{
    <div class="alert alert-danger mb-3" style="font-size:13px;">⚠ @Model.Hata</div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-card mb-3">
        <div class="section-title">🏢 Temel Bilgiler</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label required">Firma Kodu</label>
                <input type="text" name="FirmaKodu" value="@Model.FirmaKodu"
                       class="form-control form-control-sm text-uppercase"
                       maxlength="20" placeholder="ör: LOJISTIK01" required />
                <small class="text-muted" style="font-size:11px;">Otomatik büyük harfe çevrilir</small>
            </div>
            <div class="col-md-5">
                <label class="form-label required">Firma Adı</label>
                <input type="text" name="FirmaAdi" value="@Model.FirmaAdi"
                       class="form-control form-control-sm"
                       maxlength="200" placeholder="Firma tam adı" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Paket Adı</label>
                <input type="text" name="PaketAdi" value="@Model.PaketAdi"
                       class="form-control form-control-sm"
                       maxlength="100" placeholder="ör: Standart, Pro, Enterprise" />
            </div>
        </div>
    </div>

    <div class="form-card mb-3">
        <div class="section-title">👥 Kullanıcı & Ücret</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label required">Kullanıcı Limiti</label>
                <input type="number" name="KullaniciLimiti" value="@Model.KullaniciLimiti"
                       class="form-control form-control-sm" min="1" max="9999" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Aylık Ücret</label>
                <input type="number" name="AylikUcret" value="@Model.AylikUcret"
                       class="form-control form-control-sm" step="0.01" min="0" placeholder="0.00" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Para Birimi</label>
                <select name="ParaBirimi" class="form-select form-select-sm">
                    @{ var _pb = Model.ParaBirimi ?? "TL"; }
                    @if (_pb == "TL")  { <option value="TL" selected>TL</option> }   else { <option value="TL">TL</option> }
                    @if (_pb == "USD") { <option value="USD" selected>USD</option> } else { <option value="USD">USD</option> }
                    @if (_pb == "EUR") { <option value="EUR" selected>EUR</option> } else { <option value="EUR">EUR</option> }
                </select>
            </div>
        </div>
    </div>

    <div class="form-card mb-3">
        <div class="section-title">📅 Tarihler & Durum</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label required">Başlama Tarihi</label>
                <input type="date" name="BaslamaTarihi"
                       value="@Model.BaslamaTarihi.ToString("yyyy-MM-dd")"
                       class="form-control form-control-sm" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Bitiş Tarihi</label>
                <input type="date" name="BitisTarihi"
                       value="@(Model.BitisTarihi?.ToString("yyyy-MM-dd") ?? "")"
                       class="form-control form-control-sm" />
                <small class="text-muted" style="font-size:11px;">Boş bırakılırsa süresiz</small>
            </div>
            <div class="col-md-2 d-flex flex-column justify-content-end">
                <div class="form-check mb-1">
                    <input type="checkbox" name="IsActive" value="true" id="chkIsActive"
                           class="form-check-input" @(Model.IsActive ? "checked" : "") />
                    <input type="hidden" name="IsActive" value="false" />
                    <label class="form-check-label" for="chkIsActive" style="font-size:13px;">Aktif</label>
                </div>
            </div>
        </div>
    </div>

    <div class="form-card mb-3">
        <div class="section-title">🧪 Demo Ayarları</div>
        <div class="row g-3 align-items-end">
            <div class="col-md-2 d-flex flex-column justify-content-end">
                <div class="form-check mb-1">
                    <input type="checkbox" name="DemoMu" value="true" id="chkDemoMu"
                           class="form-check-input" @(Model.DemoMu ? "checked" : "")
                           onchange="toggleDemo(this)" />
                    <input type="hidden" name="DemoMu" value="false" />
                    <label class="form-check-label" for="chkDemoMu" style="font-size:13px;">Demo Firma</label>
                </div>
            </div>
            <div class="col-md-3" id="demoLimitDiv" style="@(Model.DemoMu ? "" : "display:none;")">
                <label class="form-label">Demo Kayıt Limiti</label>
                <input type="number" name="DemoKayitLimiti" value="@Model.DemoKayitLimiti"
                       class="form-control form-control-sm" min="1" placeholder="ör: 50" />
                <small class="text-muted" style="font-size:11px;">Kayıt sayısı limiti</small>
            </div>
        </div>
    </div>

    <div class="form-card mb-4">
        <div class="section-title">📝 Notlar</div>
        <textarea name="Notlar" class="form-control" rows="3"
                  maxlength="500" placeholder="İsteğe bağlı notlar...">@Model.Notlar</textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">💾 Kaydet</button>
        <a href="/SistemAdmin/Firmalar" class="btn btn-outline-secondary px-4">İptal</a>
    </div>
</form>

<script>
    function toggleDemo(cb) {
        document.getElementById('demoLimitDiv').style.display = cb.checked ? '' : 'none';
    }
    // Firma kodu büyük harf
    document.querySelector('input[name=FirmaKodu]')?.addEventListener('input', function () {
        this.value = this.value.toUpperCase();
    });
</script>
