@* Pages/SeferSevkiyatlar/Create.cshtml *@
@page
@model Lojistik.Pages.SeferSevkiyatlar.CreateModel
@{
    ViewData["Title"] = "Sefer-Sevkiyat Bağla";
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Sefer-Sevkiyat Bağla</h2>
        <a asp-page="/Seferler/Index" class="btn btn-pastel-blue btn-sm">← Seferler</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.SeferID" class="form-label">Sefer</label>
                        <select asp-for="Input.SeferID" asp-items="Model.SeferSelect" class="form-select">
                            <option value="">Seçiniz...</option>
                        </select>
                        <span asp-validation-for="Input.SeferID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.SevkiyatID" class="form-label">Sevkiyat</label>
                        <select asp-for="Input.SevkiyatID" asp-items="Model.SevkiyatSelect" class="form-select">
                            <option value="">Seçiniz...</option>
                        </select>
                        <span asp-validation-for="Input.SevkiyatID" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.Yon" class="form-label">Yön</label>
                        <select asp-for="Input.Yon" class="form-select">
                            <option value="0">Gidiş</option>
                            <option value="1">Dönüş</option>
                        </select>
                        <span asp-validation-for="Input.Yon" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Notlar" class="form-label">Notlar</label>
                        <textarea asp-for="Input.Notlar" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Input.Notlar" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-pastel-green" type="submit">Kaydet</button>
                    <a asp-page="/Seferler/Index" class="btn btn-pastel-blue">İptal</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
