@page "{id:int}"
@model Lojistik.Pages.SeferSevkiyatlar.DeleteModel
@{
    ViewData["Title"] = "Sefer–Sevkiyat Sil";
    var x = Model.Data!;
}

<div class="lj-page-compact">

    <h2 class="mb-3 text-danger">Sefer–Sevkiyat Sil</h2>

    <div class="alert alert-danger">
        <strong>Bu bağlantıyı silmek istediğinize emin misiniz?</strong>
        Bu işlem geri alınamaz.
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold">Bağlantı Özeti</div>
        <div class="card-body">
            <div class="row g-2" style="font-size:0.875rem;">
                <div class="col-sm-3 text-muted">Sefer</div>
                <div class="col-sm-9">
                    <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID">@(x.SeferKodu ?? ("SF-" + x.SeferID))</a>
                </div>
                <div class="col-sm-3 text-muted">Sevkiyat</div>
                <div class="col-sm-9">
                    <a asp-page="/Sevkiyatlar/Details" asp-route-id="@x.SevkiyatID">@(x.SevkiyatKodu ?? ("SV-" + x.SevkiyatID))</a>
                </div>
                <div class="col-sm-3 text-muted">Yön</div>
                <div class="col-sm-9">
                    <span class="badge bg-@(x.Yon == 0 ? "secondary" : "info") text-dark">@(x.Yon == 0 ? "Gidiş" : "Dönüş")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(x.CekiciPlaka))
                {
                    <div class="col-sm-3 text-muted">Çekici</div>
                    <div class="col-sm-9"><span class="badge bg-light text-dark border">@x.CekiciPlaka</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(x.SurucuAdi))
                {
                    <div class="col-sm-3 text-muted">Sürücü</div>
                    <div class="col-sm-9">@x.SurucuAdi</div>
                }
            </div>
        </div>
    </div>

    <form method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-pastel-red">Evet, Sil</button>
        <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID" class="btn btn-pastel-blue">Vazgeç</a>
    </form>

</div>
