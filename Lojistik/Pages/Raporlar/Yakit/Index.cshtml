@page
@model Lojistik.Pages.Raporlar.Yakit.IndexModel
@{
    ViewData["Title"] = "Yakıt Raporu";
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Yakıt Raporu</h2>
        <button type="button" class="btn btn-sm btn-outline-info"
                data-bs-toggle="modal" data-bs-target="#yardimModal"
                title="Bu sayfa hakkında yardım">
            ❓ Yardım
        </button>
    </div>

    @* ─── FİLTRE KARTI ──────────────────────────────────────────── *@
    <div class="card lj-filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Başlangıç</label>
                    <input type="date" name="Start" value="@(Model.Start?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Bitiş</label>
                    <input type="date" name="End" value="@(Model.End?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-6 col-md-4">
                    <label class="form-label">Ara</label>
                    <input name="q" value="@Model.q" class="form-control" placeholder="Sefer kodu / plaka / sürücü..." />
                </div>
                <div class="col-sm-6 col-md-3">
                    <label class="form-label">Yer</label>
                    <input name="yer" value="@Model.yer" class="form-control" placeholder="Örn: Opet, Shell, Gaziantep..." />
                </div>
                <div class="col-auto d-flex gap-1">
                    <button class="btn btn-pastel-blue" type="submit">Filtrele</button>
                    <a class="btn btn-pastel-blue" asp-page="./Index">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    @* ─── ÖZET KARTLAR ──────────────────────────────────────────── *@
    <div class="d-flex flex-wrap gap-2 mb-3">
        <div class="card px-3 py-2 border-0 bg-light">
            <div class="text-muted small">Toplam Litre</div>
            <div class="fw-bold fs-6">@Model.ToplamLitre.ToString("N3") L</div>
        </div>
        @if (Model.ToplamTutarPB.Count > 0)
        {
            @foreach (var kv in Model.ToplamTutarPB)
            {
                <div class="card px-3 py-2 border-0 bg-light">
                    <div class="text-muted small">Toplam Tutar (@kv.Key)</div>
                    <div class="fw-bold fs-6">@kv.Value.ToString("N2") @kv.Key</div>
                </div>
            }
        }
        <div class="card px-3 py-2 border-0 bg-light">
            <div class="text-muted small">Kayıt Sayısı</div>
            <div class="fw-bold fs-6">@Model.Items.Count</div>
        </div>
    </div>

    @* ─── TABLO ─────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tarih</th>
                    <th>Sefer</th>
                    <th>Çekici</th>
                    <th>Sürücü</th>
                    <th class="text-end">Litre</th>
                    <th>Yer</th>
                    <th class="text-end">Tutar</th>
                    <th>PB</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">
                        <div class="fs-4 mb-1">📭</div>Kayıt bulunamadı.
                    </td></tr>
                }
                else
                {
                    int sira = 1;
                    foreach (var r in Model.Items)
                    {
                        <tr>
                            <td class="text-muted">@sira</td>
                            <td>@r.Tarih.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.SeferKodu))
                                {
                                    <span class="badge bg-light text-dark border">@r.SeferKodu</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.CekiciPlaka))
                                {
                                    <span class="badge bg-light text-dark border">@r.CekiciPlaka</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(r.SurucuAdi) ? "—" : r.SurucuAdi)</td>
                            <td class="text-end fw-semibold">@r.Litre.ToString("N3")</td>
                            <td class="text-muted">@(string.IsNullOrWhiteSpace(r.Yer) ? "—" : r.Yer)</td>
                            <td class="text-end fw-semibold">@r.Tutar.ToString("N2")</td>
                            <td>@r.PB</td>
                        </tr>
                        sira++;
                    }
                }
            </tbody>
        </table>
    </div>

</div>

<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Yakıt Raporu — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa, araç ve şoför bazında yakıt tüketim verilerini detaylı listeler. Sefer başına yakıt masrafı ve litre başına maliyet analizine olanak tanır.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📈 Özet Kartlar</h6>
                    <ul class="mb-0">
                        <li><strong>Toplam Litre</strong> — Filtreye göre toplam yakıt miktarı.</li>
                        <li><strong>Toplam Tutar</strong> — Para birimi bazında toplam yakıt maliyeti.</li>
                        <li><strong>Kayıt Sayısı</strong> — Gösterilen yakıt alım kaydı sayısı.</li>
                    </ul>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📊 Tablo Sütunları</h6>
                    <ul class="mb-0">
                        <li><strong>Tarih</strong> — Yakıt alım tarihi.</li>
                        <li><strong>Sefer</strong> — İlgili sefer kodu.</li>
                        <li><strong>Çekici</strong> — Yakıt alan araç plakası.</li>
                        <li><strong>Sürücü</strong> — Yakıt alan şoför.</li>
                        <li><strong>Litre</strong> — Alınan yakıt miktarı.</li>
                        <li><strong>Yer</strong> — Yakıt alınan istasyon/konum.</li>
                        <li><strong>Tutar / PB</strong> — Yakıt maliyeti ve para birimi.</li>
                    </ul>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🔍 Filtreleme</h6>
                    <ul class="mb-0">
                        <li><strong>Tarih Aralığı</strong> — Belirli dönemde alınan yakıtları filtreleyin.</li>
                        <li><strong>Arama</strong> — Sefer kodu, plaka veya sürücüye göre arayın.</li>
                        <li><strong>Yer</strong> — İstasyon adına göre filtreleyin (Opet, Shell vb.).</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
