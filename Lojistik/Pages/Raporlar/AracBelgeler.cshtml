@page
@model Lojistik.Pages.Raporlar.AracBelgelerModel
@{
    ViewData["Title"] = "Araç Belge Raporu";
    var today = DateOnly.FromDateTime(DateTime.Today);

    string SortNext(string field) =>
        Model.SortField == field && Model.SortDir == "asc" ? "desc" : "asc";
    string SortIcon(string field) =>
        Model.SortField != field ? "↕" : Model.SortDir == "asc" ? "↑" : "↓";
    string SortCls(string field) =>
        Model.SortField == field ? "" : "text-muted";

    Dictionary<string, string?> Base() => new() {
        ["PageSize"]    = Model.PageSize.ToString(),
        ["SortField"]   = Model.SortField,
        ["SortDir"]     = Model.SortDir,
        ["Plaka"]       = Model.Plaka,
        ["BelgeTipi"]   = Model.BelgeTipi,
        ["BelgeNo"]     = Model.BelgeNo,
        ["Firma"]       = Model.Firma,
        ["pb"]          = Model.pb,
        ["Notlar"]      = Model.Notlar,
    };

    Dictionary<string, string?> SD(string field) {
        var d = Base();
        d["PageIndex"] = "1";
        d["SortField"] = field;
        d["SortDir"]   = SortNext(field);
        return d;
    }

    Dictionary<string, string?> PD(int pageIdx) {
        var d = Base();
        d["PageIndex"] = pageIdx.ToString();
        return d;
    }
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Araç Belge Raporu</h2>
    </div>

    @* ─── FİLTRE KARTI ──────────────────────────────────────────── *@
    <div class="card lj-filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="PageIndex"  value="1" />
                <input type="hidden" name="SortField"  value="@Model.SortField" />
                <input type="hidden" name="SortDir"    value="@Model.SortDir" />

                <div class="col-sm-4 col-md-2">
                    <label class="form-label">Plaka</label>
                    <input name="Plaka" value="@Model.Plaka" class="form-control" placeholder="Plaka..." />
                </div>
                <div class="col-sm-4 col-md-2">
                    <label class="form-label">Belge Tipi</label>
                    <input name="BelgeTipi" value="@Model.BelgeTipi" class="form-control" placeholder="Belge Tipi..." />
                </div>
                <div class="col-sm-4 col-md-2">
                    <label class="form-label">Belge No</label>
                    <input name="BelgeNo" value="@Model.BelgeNo" class="form-control" placeholder="Belge No..." />
                </div>
                <div class="col-sm-4 col-md-2">
                    <label class="form-label">Firma</label>
                    <input name="Firma" value="@Model.Firma" class="form-control" placeholder="Firma..." />
                </div>
                <div class="col-sm-4 col-md-1">
                    <label class="form-label">Para Birimi</label>
                    <select name="pb" class="form-select">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.pb))">Hepsi</option>
                        <option value="TL"  selected="@(string.Equals(Model.pb, "TL",  StringComparison.OrdinalIgnoreCase))">TL</option>
                        <option value="EUR" selected="@(string.Equals(Model.pb, "EUR", StringComparison.OrdinalIgnoreCase))">EUR</option>
                        <option value="USD" selected="@(string.Equals(Model.pb, "USD", StringComparison.OrdinalIgnoreCase))">USD</option>
                    </select>
                </div>
                <div class="col-sm-4 col-md-2">
                    <label class="form-label">Notlar</label>
                    <input name="Notlar" value="@Model.Notlar" class="form-control" placeholder="Notlar..." />
                </div>
                <div class="col-sm-2 col-md-1">
                    <label class="form-label">Sayfa</label>
                    <select name="PageSize" class="form-select" onchange="this.form.submit()">
                        @foreach (var s in new[] { 10, 20, 50, 100 })
                        {
                            <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-auto d-flex gap-1">
                    <button class="btn btn-pastel-blue" type="submit">Ara</button>
                    <a class="btn btn-pastel-blue" asp-page="./AracBelgeler">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    @* ─── ÖZET BAR ───────────────────────────────────────────────── *@
    <div class="d-flex align-items-center gap-3 mb-2">
        <small class="text-muted">
            Toplam <strong>@Model.TotalCount</strong> kayıt —
            Sayfa <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
        </small>
    </div>

    @* ─── TABLO ─────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th style="width:42px">#</th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("Plaka")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>Plaka</span><small class="@SortCls("Plaka")">@SortIcon("Plaka")</small>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("BelgeTipi")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>Belge Tipi</span><small class="@SortCls("BelgeTipi")">@SortIcon("BelgeTipi")</small>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("BelgeNo")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>Belge No</span><small class="@SortCls("BelgeNo")">@SortIcon("BelgeNo")</small>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("Firma")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>Firma</span><small class="@SortCls("Firma")">@SortIcon("Firma")</small>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("BaslangicTarihi")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>Başlangıç</span><small class="@SortCls("BaslangicTarihi")">@SortIcon("BaslangicTarihi")</small>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("BitisTarihi")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>Bitiş</span><small class="@SortCls("BitisTarihi")">@SortIcon("BitisTarihi")</small>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("Tutar")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>Tutar</span><small class="@SortCls("Tutar")">@SortIcon("Tutar")</small>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./AracBelgeler" asp-all-route-data="@SD("ParaBirimi")"
                           class="text-decoration-none text-reset d-flex align-items-center gap-1">
                            <span>PB</span><small class="@SortCls("ParaBirimi")">@SortIcon("ParaBirimi")</small>
                        </a>
                    </th>
                    <th>Notlar</th>
                    <th style="width:90px"></th>
                </tr>
            </thead>
            <tbody>
                @{ var sira = (Model.PageIndex - 1) * Model.PageSize + 1; }
                @if (!Model.Belgeler.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted py-4">
                        <div class="fs-4 mb-1">📭</div>Kayıt bulunamadı.
                    </td></tr>
                }
                @foreach (var item in Model.Belgeler)
                {
                    string bitisBadge = "";
                    string bitisText  = item.BitisTarihi?.ToString("dd.MM.yyyy") ?? "";
                    if (item.BitisTarihi.HasValue)
                    {
                        int kalan = item.BitisTarihi.Value.DayNumber - today.DayNumber;
                        if (kalan < 0)
                        {
                            bitisBadge = "badge bg-danger";
                            bitisText  = item.BitisTarihi.Value.ToString("dd.MM.yyyy") + " ⚠";
                        }
                        else if (kalan <= 7)
                        {
                            bitisBadge = "badge bg-danger";
                            bitisText  = item.BitisTarihi.Value.ToString("dd.MM.yyyy") + " (" + kalan + " gün)";
                        }
                        else if (kalan <= 30)
                        {
                            bitisBadge = "badge bg-warning text-dark";
                            bitisText  = item.BitisTarihi.Value.ToString("dd.MM.yyyy") + " (" + kalan + " gün)";
                        }
                    }
                    <tr>
                        <td class="text-muted">@sira</td>
                        <td><span class="badge bg-light text-dark border">@(item.Arac?.Plaka ?? "")</span></td>
                        <td class="fw-semibold">@item.BelgeTipi</td>
                        <td>@item.BelgeNo</td>
                        <td class="text-muted">@item.Firma</td>
                        <td>@item.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(bitisBadge))
                            {
                                <span class="@bitisBadge">@bitisText</span>
                            }
                            else
                            {
                                @bitisText
                            }
                        </td>
                        <td class="text-end fw-semibold">@(item.Tutar.HasValue ? item.Tutar.Value.ToString("N2") : "")</td>
                        <td>@item.ParaBirimi</td>
                        <td class="text-muted" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                            title="@item.Notlar">@item.Notlar</td>
                        <td class="text-end">
                            @if (!string.IsNullOrWhiteSpace(item.DosyaYolu))
                            {
                                <a class="btn btn-pastel-green btn-sm"
                                   href="@Url.Content(item.DosyaYolu)"
                                   target="_blank">Görsel</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-pastel-blue btn-sm disabled">Görsel</button>
                            }
                        </td>
                    </tr>
                    sira++;
                }
            </tbody>
        </table>
    </div>

    @* ─── SAYFALAMA ──────────────────────────────────────────────── *@
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">
                Toplam <strong>@Model.TotalCount</strong> — Sayfa <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
            </small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : null)">
                    <a class="page-link" asp-page="./AracBelgeler" asp-all-route-data="@PD(1)">İlk</a>
                </li>
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : null)">
                    <a class="page-link" asp-page="./AracBelgeler" asp-all-route-data="@PD(Model.PageIndex - 1)">‹ Önceki</a>
                </li>
                @{
                    int pgStart = Math.Max(1, Model.PageIndex - 2);
                    int pgEnd   = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                }
                @if (pgStart > 1)
                {
                    <li class="page-item"><a class="page-link" asp-page="./AracBelgeler" asp-all-route-data="@PD(1)">1</a></li>
                    @if (pgStart > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                }
                @for (int pg = pgStart; pg <= pgEnd; pg++)
                {
                    <li class="page-item @(pg == Model.PageIndex ? "active" : null)">
                        <a class="page-link" asp-page="./AracBelgeler" asp-all-route-data="@PD(pg)">@pg</a>
                    </li>
                }
                @if (pgEnd < Model.TotalPages)
                {
                    @if (pgEnd < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    <li class="page-item"><a class="page-link" asp-page="./AracBelgeler" asp-all-route-data="@PD(Model.TotalPages)">@Model.TotalPages</a></li>
                }
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : null)">
                    <a class="page-link" asp-page="./AracBelgeler" asp-all-route-data="@PD(Model.PageIndex + 1)">Sonraki ›</a>
                </li>
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : null)">
                    <a class="page-link" asp-page="./AracBelgeler" asp-all-route-data="@PD(Model.TotalPages)">Son</a>
                </li>
            </ul>
        </div>
    }

</div>
