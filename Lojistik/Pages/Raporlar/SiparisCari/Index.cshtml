@page
@model Lojistik.Pages.Raporlar.SiparisCari.IndexModel
@{
    ViewData["Title"] = "Sipariş Cari Raporu";
}

@functions {
    string DurumMetni(byte d) => d switch
    {
        0 => "Taslak",
        1 => "Yüklendi",
        2 => "Araca Bağlandı",
        3 => "Tamamlandı",
        7 => "Sonlandırıldı",
        _ => "?"
    };
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Sipariş Cari Raporu</h2>
    </div>

    @* ─── FİLTRE KARTI ──────────────────────────────────────────── *@
    <div class="card lj-filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Başlangıç</label>
                    <input type="date" name="Start" value="@(Model.Start?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Bitiş</label>
                    <input type="date" name="End" value="@(Model.End?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-6 col-md-3">
                    <label class="form-label">Arama</label>
                    <input name="q" value="@Model.q" class="form-control" placeholder="Sip.No / müşteri / evrak no..." />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Para Birimi</label>
                    <select name="PB" class="form-select">
                        <option value="">(Hepsi)</option>
                        <option value="TRY" selected="@(Model.PB == "TRY")">TRY</option>
                        <option value="EUR" selected="@(Model.PB == "EUR")">EUR</option>
                        <option value="USD" selected="@(Model.PB == "USD")">USD</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Cari Durum</label>
                    <select name="CariDurum" class="form-select">
                        <option value=""      selected="@(string.IsNullOrEmpty(Model.CariDurum))">(Hepsi)</option>
                        <option value="islendi"    selected="@(Model.CariDurum == "islendi")">İşlenmiş</option>
                        <option value="islenmedi"  selected="@(Model.CariDurum == "islenmedi")">İşlenmemiş</option>
                    </select>
                </div>
                <div class="col-auto d-flex gap-1">
                    <button class="btn btn-pastel-blue" type="submit">Filtrele</button>
                    <a class="btn btn-pastel-blue" asp-page="./Index">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    @* ─── ÖZET KARTLAR ──────────────────────────────────────────── *@
    <div class="d-flex flex-wrap gap-2 mb-3">
        <div class="card px-3 py-2 border-0 bg-light">
            <div class="text-muted small">İşlenmiş Adet</div>
            <div class="fw-bold fs-6">@Model.CountIslendi</div>
        </div>
        <div class="card px-3 py-2 border-0 bg-light">
            <div class="text-muted small">İşlenmemiş Adet</div>
            <div class="fw-bold fs-6">@Model.CountIslenmedi</div>
        </div>
        <div class="card px-3 py-2 border-0" style="background:#dcfce7;">
            <div class="text-muted small">İşlenmiş Toplam</div>
            <div class="fw-bold fs-6 text-success">@Model.SumIslendi.ToString("N2")</div>
        </div>
        <div class="card px-3 py-2 border-0" style="background:#fee2e2;">
            <div class="text-muted small">İşlenmemiş Toplam</div>
            <div class="fw-bold fs-6 text-danger">@Model.SumIslenmedi.ToString("N2")</div>
        </div>
        <div class="card px-3 py-2 border-0 bg-light">
            <div class="text-muted small">Toplam Kayıt</div>
            <div class="fw-bold fs-6">@Model.Items.Count</div>
        </div>
    </div>

    @* ─── TABLO ─────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Sip. No</th>
                    <th>Durum</th>
                    <th class="text-end">Tutar</th>
                    <th>PB</th>
                    <th>Gönderen</th>
                    <th>Alıcı</th>
                    <th>Ülke</th>
                    <th>Cari</th>
                    <th>Kimin Carisi</th>
                    <th>Evrak No</th>
                    <th>İşlem Tarihi</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted py-4">
                        <div class="fs-4 mb-1">📭</div>Kayıt bulunamadı.
                    </td></tr>
                }
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td>@r.Tarih.ToString("dd.MM.yyyy")</td>
                        <td class="fw-semibold">@r.SiparisID</td>
                        <td><span class="badge bg-secondary bg-opacity-75">@DurumMetni(r.Durum)</span></td>
                        <td class="text-end fw-semibold">@((r.Tutar ?? 0).ToString("N2"))</td>
                        <td>@r.ParaBirimi</td>
                        <td>@r.Gonderen</td>
                        <td>@r.Alici</td>
                        <td>@r.AliciUlke</td>
                        <td>
                            <span class="badge @(r.IsCariles ? "bg-success bg-opacity-75" : "bg-secondary")">
                                @(r.IsCariles ? "Carileşti" : "Carileşmedi")
                            </span>
                        </td>
                        <td>@r.CariHesap</td>
                        <td>@r.CariEvrakNo</td>
                        <td class="text-muted">@(r.CariIslemTarihi?.ToString("dd.MM.yyyy"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
