@page
@model Lojistik.Pages.Belgeler.CreateModel
@{
    ViewData["Title"] = "Yeni Belge";
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Yeni Belge <small class="text-muted fs-6 ms-2">@Model.Plaka</small></h2>
        <a class="btn btn-pastel-blue btn-sm" asp-page="/Araclar/Index">← Liste</a>
    </div>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
        <input type="hidden" asp-for="AracBelgesi.AracID" />

        <div class="card mb-3">
            <div class="card-header fw-semibold">Belge Bilgileri</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="AracBelgesi.BelgeTipi" class="form-label"></label>
                        <input asp-for="AracBelgesi.BelgeTipi" class="form-control" />
                        <span asp-validation-for="AracBelgesi.BelgeTipi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AracBelgesi.BelgeNo" class="form-label"></label>
                        <input asp-for="AracBelgesi.BelgeNo" class="form-control" />
                        <span asp-validation-for="AracBelgesi.BelgeNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AracBelgesi.Firma" class="form-label"></label>
                        <input asp-for="AracBelgesi.Firma" class="form-control" maxlength="100" />
                        <span asp-validation-for="AracBelgesi.Firma" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="AracBelgesi.BaslangicTarihi" class="form-label"></label>
                        <input asp-for="AracBelgesi.BaslangicTarihi" type="date" class="form-control" />
                        <span asp-validation-for="AracBelgesi.BaslangicTarihi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="AracBelgesi.BitisTarihi" class="form-label"></label>
                        <input asp-for="AracBelgesi.BitisTarihi" type="date" class="form-control" />
                        <span asp-validation-for="AracBelgesi.BitisTarihi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="AracBelgesi.Tutar" class="form-label"></label>
                        <input asp-for="AracBelgesi.Tutar" class="form-control" />
                        <span asp-validation-for="AracBelgesi.Tutar" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="AracBelgesi.ParaBirimi" class="form-label"></label>
                        <input asp-for="AracBelgesi.ParaBirimi" class="form-control" />
                        <span asp-validation-for="AracBelgesi.ParaBirimi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Belge Dosyası</label>
                        <input asp-for="Dosya" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                        <div class="form-text">PDF, JPG, PNG</div>
                        <span asp-validation-for="Dosya" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AracBelgesi.DosyaYolu" class="form-label"></label>
                        <input asp-for="AracBelgesi.DosyaYolu" class="form-control" />
                        <span asp-validation-for="AracBelgesi.DosyaYolu" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="AracBelgesi.Notlar" class="form-label"></label>
                        <textarea asp-for="AracBelgesi.Notlar" rows="2" class="form-control"></textarea>
                        <span asp-validation-for="AracBelgesi.Notlar" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-pastel-green">Kaydet</button>
            <a class="btn btn-pastel-blue" asp-page="/Araclar/Index">İptal</a>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
