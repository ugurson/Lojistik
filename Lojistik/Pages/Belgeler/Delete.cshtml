@page "{id:int}"
@model Lojistik.Pages.Belgeler.DeleteModel
@{
    ViewData["Title"] = "Belge Sil";
    var b = Model.AracBelgesi;
}

<div class="lj-page-compact">

    @if (b is null)
    {
        <div class="alert alert-warning">Kayıt bulunamadı.</div>
    }
    else
    {
        @* ─── BAŞLIK ────────────────────────────────────────────────── *@
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="mb-0 text-danger">Belge Sil</h2>
            <a class="btn btn-pastel-blue btn-sm"
               asp-page="/Araclar/Details" asp-route-id="@b.AracID">← Araç</a>
        </div>

        <div class="alert alert-danger py-2 mb-3">
            Bu belgeyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
        </div>

        @* ─── BELGE ÖZETİ ────────────────────────────────────────── *@
        <div class="card mb-3">
            <div class="card-body py-3">
                <div class="row g-3">
                    <div class="col-6 col-md-2">
                        <div class="text-muted small">Araç</div>
                        <div class="fw-semibold">@b.Arac?.Plaka</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Belge Tipi</div>
                        <div class="fw-semibold">@b.BelgeTipi</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Belge No</div>
                        <div>@b.BelgeNo</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted small">Firma</div>
                        <div>@b.Firma</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted small">Bitiş Tarihi</div>
                        <div>@(b.BitisTarihi?.ToString("dd.MM.yyyy") ?? "—")</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted small">Tutar</div>
                        <div>@(b.Tutar?.ToString("N2") ?? "—") @b.ParaBirimi</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(b.Notlar))
                    {
                        <div class="col-12">
                            <div class="text-muted small">Notlar</div>
                            <div>@b.Notlar</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="AracBelgesi.BelgeID" />
            <input type="hidden" name="aracId" value="@b.AracID" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-pastel-red">Evet, Sil</button>
                <a class="btn btn-pastel-blue"
                   asp-page="/Araclar/Details" asp-route-id="@b.AracID">İptal</a>
            </div>
        </form>
    }

</div>
