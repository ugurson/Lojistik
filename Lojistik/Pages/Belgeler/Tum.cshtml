@page "/Belgeler/Tum"
@model Lojistik.Pages.Belgeler.TumModel
@{
    ViewData["Title"] = "Tüm Belgeler";

    string TarihBadge(DateOnly? dt)
    {
        if (dt == null) return "";
        var days = (dt.Value.ToDateTime(TimeOnly.MinValue).Date - DateTime.Today).TotalDays;
        if (days < 0)   return "badge bg-danger";
        if (days <= 30) return "badge bg-warning text-dark";
        return "badge bg-success bg-opacity-75";
    }

    Dictionary<string, string?> BaseP() => new()
    {
        ["PageSize"]     = Model.PageSize.ToString(),
        ["Plaka"]        = Model.Plaka,
        ["BelgeTipi"]    = Model.BelgeTipi,
        ["BaslangicMin"] = Model.BaslangicMin?.ToString("yyyy-MM-dd"),
        ["BaslangicMax"] = Model.BaslangicMax?.ToString("yyyy-MM-dd"),
        ["BitisMin"]     = Model.BitisMin?.ToString("yyyy-MM-dd"),
        ["BitisMax"]     = Model.BitisMax?.ToString("yyyy-MM-dd"),
    };
    Dictionary<string, string?> PD(int pg) { var d = BaseP(); d["PageIndex"] = pg.ToString(); return d; }
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Tüm Belgeler</h2>
        <div class="d-flex gap-2">
            <partial name="_DownloadActions"
                     view-data='@(new ViewDataDictionary(ViewData) {
                         ["FileBase"] = "belgeler",
                         ["TableSelector"] = ".lj-table"
                     })' />
            <button type="button" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#yardimModal"
                    title="Bu sayfa hakkında yardım">
                ❓ Yardım
            </button>
        </div>
    </div>

    @* ─── FİLTRE KARTI ──────────────────────────────────────────── *@
    <div class="card lj-filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="PageIndex" value="1" />
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Plaka</label>
                    <input name="Plaka" value="@Model.Plaka" class="form-control" placeholder="Plaka..." />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Belge Tipi</label>
                    <input name="BelgeTipi" value="@Model.BelgeTipi" class="form-control" placeholder="Belge tipi..." />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Başlangıç ≥</label>
                    <input type="date" name="BaslangicMin" value="@(Model.BaslangicMin?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Başlangıç ≤</label>
                    <input type="date" name="BaslangicMax" value="@(Model.BaslangicMax?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Bitiş ≥</label>
                    <input type="date" name="BitisMin" value="@(Model.BitisMin?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label">Bitiş ≤</label>
                    <input type="date" name="BitisMax" value="@(Model.BitisMax?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-sm-4 col-md-2">
                    <label class="form-label">Sayfa Boyutu</label>
                    <select name="PageSize" class="form-select" onchange="this.form.submit()">
                        @foreach (var s in new[] { 10, 20, 50, 100 })
                        {
                            <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-auto d-flex gap-1">
                    <button type="submit" class="btn btn-pastel-blue">Filtrele</button>
                    <a class="btn btn-pastel-blue" asp-page="./Tum">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    @* ─── ÖZET BAR ──────────────────────────────────────────────── *@
    <div class="mb-2">
        <small class="text-muted">
            Toplam <strong>@Model.TotalCount</strong> kayıt
            @if (Model.TotalPages > 1)
            {
                <span class="ms-2">— Sayfa <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong></span>
            }
        </small>
    </div>

    @* ─── TABLO ─────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Plaka</th>
                    <th>Belge Tipi</th>
                    <th>Belge No</th>
                    <th>Firma</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th class="text-end">Tutar</th>
                    <th>PB</th>
                    <th>Notlar</th>
                    <th class="text-end" style="width:200px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Kayitlar.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted py-4">
                        <div class="fs-4 mb-1">📭</div>Kayıt bulunamadı.
                    </td></tr>
                }
                @{
                    var sira = (Model.PageIndex - 1) * Model.PageSize + 1;
                }
                @foreach (var b in Model.Kayitlar)
                {
                    var yol = string.IsNullOrWhiteSpace(b.DosyaYolu)
                        ? null
                        : (b.DosyaYolu!.StartsWith("~") ? b.DosyaYolu : "~/" + b.DosyaYolu!.TrimStart('/'));

                    <tr>
                        <td class="text-muted">@sira</td>
                        <td class="fw-semibold">@b.Arac?.Plaka</td>
                        <td>@b.BelgeTipi</td>
                        <td>@b.BelgeNo</td>
                        <td>@b.Firma</td>
                        <td>@b.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (b.BitisTarihi.HasValue)
                            {
                                <span class="@TarihBadge(b.BitisTarihi)">
                                    @b.BitisTarihi.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-end">@(b.Tutar?.ToString("N2") ?? "—")</td>
                        <td>@b.ParaBirimi</td>
                        <td class="text-truncate" style="max-width:200px;">@b.Notlar</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-pastel-blue"  asp-page="/Araclar/Details" asp-route-id="@b.AracID">Araç</a>
                                <a class="btn btn-pastel-amber" asp-page="/Belgeler/Edit"   asp-route-id="@b.BelgeID">Düzenle</a>
                                <a class="btn btn-pastel-red"   asp-page="/Belgeler/Delete" asp-route-id="@b.BelgeID">Sil</a>
                                @if (!string.IsNullOrWhiteSpace(yol))
                                {
                                    <a class="btn btn-pastel-green" href="@Url.Content(yol)" target="_blank" rel="noopener">Görsel</a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary" disabled>Görsel</button>
                                }
                            </div>
                        </td>
                    </tr>
                    sira++;
                }
            </tbody>
        </table>
    </div>

    @* ─── SAYFALAMA ─────────────────────────────────────────────── *@
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./Tum" asp-all-route-data="@PD(1)">«</a>
                </li>
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./Tum" asp-all-route-data="@PD(Model.PageIndex - 1)">‹</a>
                </li>

                @if (Math.Max(1, Model.PageIndex - 2) > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }

                @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-page="./Tum" asp-all-route-data="@PD(i)">@i</a>
                    </li>
                }

                @if (Math.Min(Model.TotalPages, Model.PageIndex + 2) < Model.TotalPages)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }

                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="./Tum" asp-all-route-data="@PD(Model.PageIndex + 1)">›</a>
                </li>
                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="./Tum" asp-all-route-data="@PD(Model.TotalPages)">»</a>
                </li>
            </ul>
        </nav>
    }

</div>

<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Tüm Belgeler — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa, filodaki tüm araçlara ait belgeler dahil, sistemdeki tüm belge kayıtlarını listeler. Plaka, belge tipi ve tarih aralıklarına göre filtreleme yapabilirsiniz.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🔍 Filtreleme</h6>
                    <ul class="mb-0">
                        <li><strong>Plaka</strong> — Belirli bir araca ait belgeleri görün.</li>
                        <li><strong>Belge Tipi</strong> — Sigorta, ruhsat, muayene vb. ile filtreleyin.</li>
                        <li><strong>Başlangıç / Bitiş</strong> — Tarih aralıklarına göre filtreleyin.</li>
                        <li><strong>Sayfa Boyutu</strong> — Sayfada gösterilecek kayıt sayısı.</li>
                    </ul>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🎨 Bitiş Tarihi Renk Kodları</h6>
                    <ul class="mb-0">
                        <li><span style="color:#198754;">Yeşil</span> — Geçerli, süre dolmamış.</li>
                        <li><span style="color:#b45309;">Sarı</span> — 30 gün içinde dolacak.</li>
                        <li><span style="color:#dc3545;">Kırmızı</span> — Süresi dolmuş.</li>
                    </ul>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ İşlemler</h6>
                    <ul class="mb-0">
                        <li><strong>Araç</strong> — Belgenin ait olduğu araç detayına gidin.</li>
                        <li><strong>Düzenle</strong> — Belgeyi güncelleyin.</li>
                        <li><strong>Sil</strong> — Belgeyi kaldırın.</li>
                        <li><strong>Görsel</strong> — Belge görselini/dosyasını görüntüleyin (yüklenmiş ise).</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
