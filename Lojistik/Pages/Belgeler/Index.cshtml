@page
@model Lojistik.Pages.Belgeler.IndexModel
@{
    ViewData["Title"] = "Belgeler";

    string TarihBadge(DateOnly? dt)
    {
        if (dt == null) return "";
        var days = (dt.Value.ToDateTime(TimeOnly.MinValue).Date - DateTime.Today).TotalDays;
        if (days < 0)   return "badge bg-danger";
        if (days <= 30) return "badge bg-warning text-dark";
        return "badge bg-success bg-opacity-75";
    }
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Belgeler</h2>
        <div class="d-flex gap-2">
            <a asp-page="Create" class="btn btn-pastel-green btn-sm">+ Yeni Belge</a>
            <button type="button" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#yardimModal"
                    title="Bu sayfa hakkında yardım">
                ❓ Yardım
            </button>
        </div>
    </div>

    @* ─── TABLO ─────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>Araç</th>
                    <th>Belge Tipi</th>
                    <th>Belge No</th>
                    <th>Firma</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th class="text-end">Tutar</th>
                    <th>PB</th>
                    <th>Notlar</th>
                    <th class="text-end" style="width:180px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.AracBelgesi.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">
                        <div class="fs-4 mb-1">📭</div>Kayıt bulunamadı.
                    </td></tr>
                }
                @foreach (var item in Model.AracBelgesi)
                {
                    <tr>
                        <td class="fw-semibold">@item.Arac?.Plaka</td>
                        <td>@item.BelgeTipi</td>
                        <td>@item.BelgeNo</td>
                        <td>@item.Firma</td>
                        <td>@item.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (item.BitisTarihi.HasValue)
                            {
                                <span class="@TarihBadge(item.BitisTarihi)">
                                    @item.BitisTarihi.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-end">@(item.Tutar?.ToString("N2") ?? "—")</td>
                        <td>@item.ParaBirimi</td>
                        <td class="text-truncate" style="max-width:200px;">@item.Notlar</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-page="./Details" asp-route-id="@item.BelgeID" class="btn btn-pastel-blue">Detay</a>
                                <a asp-page="./Edit"    asp-route-id="@item.BelgeID" class="btn btn-pastel-amber">Düzenle</a>
                                <a asp-page="./Delete"  asp-route-id="@item.BelgeID" class="btn btn-pastel-red">Sil</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Belgeler — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa araç belgelerinin takip sistemini gösterir. Sigorta, ruhsat, muayene gibi belgelerin geçerlilik tarihlerini izler ve süresi dolan ya da dolmak üzere olan belgeler için uyarı verir.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📊 Tablo Sütunları</h6>
                    <ul class="mb-0">
                        <li><strong>Araç</strong> — Belgenin ait olduğu araç plakası.</li>
                        <li><strong>Belge Tipi</strong> — Sigorta, ruhsat, muayene, vb.</li>
                        <li><strong>Belge No</strong> — Belge numarası veya poliçe no.</li>
                        <li><strong>Firma</strong> — Belgeyi düzenleyen sigorta/kurum adı.</li>
                        <li><strong>Başlangıç / Bitiş</strong> — Belgenin geçerlilik aralığı. Renk kodu: 🟢 Geçerli · 🟡 30 gün içinde bitiyor · 🔴 Süresi dolmuş.</li>
                        <li><strong>Tutar / PB</strong> — Belge için ödenen tutar ve para birimi.</li>
                    </ul>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ İşlemler</h6>
                    <ul class="mb-0">
                        <li><strong>+ Yeni Belge</strong> — Araca yeni belge ekleyin.</li>
                        <li><strong>Detay / Düzenle / Sil</strong> — Belge yönetimi işlemleri.</li>
                        <li>Süresi yaklaşan belgeler için <strong>Belge Takip</strong> sayfasını ziyaret edin.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
