@page
@model Lojistik.Pages.Kademeler.DeleteModel

@{
    ViewData["Title"] = "Kademe Sil";
    var k = Model.AracKademe;
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0 text-danger">Kademe Sil</h2>
        <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Liste</a>
    </div>

    <div class="alert alert-danger py-2 mb-3">
        <strong>Dikkat!</strong> Bu kademe kaydını silmek üzeresiniz. Devam etmek istediğinize emin misiniz?
    </div>

    <div class="card mb-4">
        <div class="card-body py-3">
            <div class="row g-3">
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Araç</div>
                    <div class="fw-semibold">
                        <span class="badge bg-light text-dark border">@k.Arac?.Plaka</span>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Tarih</div>
                    <div class="fw-semibold">@k.Tarih.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="text-muted small">Yapılan İşlem</div>
                    <div class="fw-semibold">@k.YapilanIslem</div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Tutar</div>
                    <div class="fw-semibold">@k.Tutar.ToString("N2") @k.ParaBirimi</div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">İşlem Firması</div>
                    <div>@k.IslemFirmasi</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(k.Notlar))
                {
                    <div class="col-12">
                        <div class="text-muted small">Notlar</div>
                        <div>@k.Notlar</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <form method="post" class="d-flex gap-2">
        <input type="hidden" asp-for="AracKademe.KademeID" />
        <button type="submit" class="btn btn-pastel-red">Evet, Sil</button>
        <a asp-page="./Index" class="btn btn-pastel-blue">İptal</a>
    </form>

</div>
