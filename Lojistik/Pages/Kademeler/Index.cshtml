@page
@model Lojistik.Pages.Kademeler.IndexModel
@{
    ViewData["Title"] = "Kademe İşlemleri";
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">
            @if (Model.AracID.HasValue)
            {
                <span class="badge bg-light text-dark border fs-6 me-1">@Model.Plaka</span>
                <span class="fw-normal text-muted">Kademe İşlemleri</span>
            }
            else
            {
                <span>Kademe İşlemleri</span>
            }
        </h2>
        <div class="d-flex gap-1">
            <partial name="_DownloadActions"
                     view-data='@(new ViewDataDictionary(ViewData) {
                         ["FileBase"] = "kademe_islemleri",
                         ["TableSelector"] = ".lj-table"
                     })' />
            @if (Model.AracID.HasValue)
            {
                <a class="btn btn-pastel-green btn-sm"
                   asp-page="Create"
                   asp-route-aracId="@Model.AracID"
                   asp-route-plaka="@Model.Plaka">+ Yeni Kademe</a>
                <a class="btn btn-pastel-blue btn-sm"
                   asp-page="/Araclar/Details"
                   asp-route-id="@Model.AracID">← Araca Dön</a>
            }
            else
            {
                <a class="btn btn-pastel-green btn-sm" asp-page="Create2">+ Yeni Kayıt</a>
            }
            <button type="button" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#yardimModal"
                    title="Bu sayfa hakkında yardım">
                ❓ Yardım
            </button>
        </div>
    </div>

    @* ─── FİLTRE KARTI ──────────────────────────────────────────── *@
    <div class="card lj-filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="aracId" value="@Model.AracID" />
                <input type="hidden" name="plaka"  value="@Model.Plaka" />

                <div class="col-auto">
                    <label class="form-label">Başlangıç</label>
                    <input type="date" class="form-control" name="Baslangic"
                           value="@(Model.Baslangic?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Bitiş</label>
                    <input type="date" class="form-control" name="Bitis"
                           value="@(Model.Bitis?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-auto">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" name="SadeceOdenmeyen" value="true"
                               @(Model.SadeceOdenmeyen ? "checked" : "") id="chkOdenmeyen" />
                        <label class="form-check-label" for="chkOdenmeyen">Sadece ödenmeyen</label>
                    </div>
                </div>
                <div class="col-auto d-flex gap-1">
                    <button class="btn btn-pastel-blue">Filtrele</button>
                    <a class="btn btn-pastel-blue"
                       asp-page="./Index"
                       asp-route-aracId="@Model.AracID"
                       asp-route-plaka="@Model.Plaka">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    @* ─── TABLO ─────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Araç</th>
                    <th>Yapılan İşlem</th>
                    <th>İşlem Firması</th>
                    <th class="text-end">Tutar</th>
                    <th>Para</th>
                    <th>Ödeme</th>
                    <th class="text-end" style="width:220px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Kademeler.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">
                        <div class="fs-4 mb-1">📭</div>Kayıt bulunamadı.
                    </td></tr>
                }
                @foreach (var item in Model.Kademeler)
                {
                    <tr class="@(item.Odeme == 0 ? "table-warning" : "")">
                        <td>@item.Tarih.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.Arac?.Plaka</span>
                        </td>
                        <td>@item.YapilanIslem</td>
                        <td class="text-muted">@item.IslemFirmasi</td>
                        <td class="text-end fw-semibold">@item.Tutar.ToString("N2")</td>
                        <td>@item.ParaBirimi</td>
                        <td>
                            @if (item.Odeme == 1)
                            {
                                <span class="badge bg-success bg-opacity-75">Ödendi</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Ödenmedi</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <form method="post" asp-page-handler="Odeme" class="d-inline">
                                    <input type="hidden" name="id"             value="@item.KademeID" />
                                    <input type="hidden" name="aracId"         value="@Model.AracID" />
                                    <input type="hidden" name="plaka"          value="@Model.Plaka" />
                                    <input type="hidden" name="Baslangic"      value="@(Model.Baslangic?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="Bitis"          value="@(Model.Bitis?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="SadeceOdenmeyen" value="@Model.SadeceOdenmeyen" />
                                    <button type="submit"
                                            class="btn @(item.Odeme == 1 ? "btn-pastel-amber" : "btn-pastel-green")"
                                            title="Ödeme durumunu değiştir">
                                        @(item.Odeme == 1 ? "İptal" : "Öde")
                                    </button>
                                </form>
                                <a class="btn btn-pastel-blue"  asp-page="Details" asp-route-id="@item.KademeID">Detay</a>
                                <a class="btn btn-pastel-amber" asp-page="Edit"    asp-route-id="@item.KademeID">Düzenle</a>
                                <a class="btn btn-pastel-red"   asp-page="Delete"  asp-route-id="@item.KademeID">Sil</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Kademe İşlemleri — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa, araçların yakıt istasyonlarında (kademe) aldıkları yakıt ve gerçekleştirdikleri diğer işlemleri listeler. Ödeme durumlarını takip edebilirsiniz.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📊 Tablo Sütunları</h6>
                    <ul class="mb-0">
                        <li><strong>Tarih</strong> — İşlem tarihi.</li>
                        <li><strong>Araç</strong> — İşlemi yapan araç plakası.</li>
                        <li><strong>Yapılan İşlem</strong> — Yakıt alımı veya diğer hizmetler.</li>
                        <li><strong>İşlem Firması</strong> — Hizmeti sağlayan kademe firması.</li>
                        <li><strong>Tutar / PB</strong> — İşlem tutarı ve para birimi.</li>
                        <li><strong>Ödeme</strong> — 🟡 Ödenmedi (sarı arka plan) · 🟢 Ödendi.</li>
                    </ul>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🔍 Filtreleme</h6>
                    <ul class="mb-0">
                        <li><strong>Tarih Aralığı</strong> — Belirli dönemdeki işlemleri görün.</li>
                        <li><strong>Sadece Ödenmeyen</strong> — Bekleyen ödemeleri hızlıca listeleyin.</li>
                    </ul>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ İşlemler</h6>
                    <ul class="mb-0">
                        <li><strong>Öde / İptal</strong> — Ödeme durumunu değiştirin.</li>
                        <li><strong>Detay / Düzenle / Sil</strong> — İşlem yönetimi.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
