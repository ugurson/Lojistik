@page
@model Lojistik.Pages.Kademeler.CreateModel
@{
    ViewData["Title"] = "Yeni Kademe";
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">
            Yeni Kademe
            @if (Model.Kademe.AracID > 0)
            {
                <span class="badge bg-light text-dark border fs-6 ms-1">@Model.Plaka</span>
            }
        </h2>
        @if (Model.Kademe.AracID > 0)
        {
            <a class="btn btn-pastel-blue btn-sm"
               asp-page="Index"
               asp-route-aracId="@Model.Kademe.AracID"
               asp-route-plaka="@Model.Plaka">← Liste</a>
        }
        else
        {
            <a class="btn btn-pastel-blue btn-sm" asp-page="Index">← Liste</a>
        }
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Kademe.AracID" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="row g-3">
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label">Tarih</label>
                        <input asp-for="Kademe.Tarih" class="form-control" type="date" />
                        <span asp-validation-for="Kademe.Tarih" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-5">
                        <label class="form-label">Yapılan İşlem</label>
                        <input asp-for="Kademe.YapilanIslem" class="form-control" />
                        <span asp-validation-for="Kademe.YapilanIslem" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-5">
                        <label class="form-label">Yapılan Firma</label>
                        <input asp-for="Kademe.IslemFirmasi" class="form-control" />
                        <span asp-validation-for="Kademe.IslemFirmasi" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label">Tutar</label>
                        <input asp-for="Kademe.Tutar" class="form-control" />
                        <span asp-validation-for="Kademe.Tutar" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label">Para Birimi</label>
                        <select asp-for="Kademe.ParaBirimi" class="form-select">
                            <option value="TRY">TRY</option>
                            <option value="EUR">EUR</option>
                            <option value="USD">USD</option>
                        </select>
                        <span asp-validation-for="Kademe.ParaBirimi" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notlar</label>
                        <textarea asp-for="Kademe.Notlar" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-pastel-green">Kaydet</button>
                    @if (Model.Kademe.AracID > 0)
                    {
                        <a class="btn btn-pastel-blue"
                           asp-page="Index"
                           asp-route-aracId="@Model.Kademe.AracID"
                           asp-route-plaka="@Model.Plaka">İptal</a>
                    }
                    else
                    {
                        <a class="btn btn-pastel-blue" asp-page="Index">İptal</a>
                    }
                </div>
            </form>
        </div>
    </div>

</div>
