@page
@model Lojistik.Pages.Araclar.DetailsModel

@{
    ViewData["Title"] = "Araç Detay";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="lj-page-compact">

@if (TempData["Msg"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Arac is null)
{
    <div class="alert alert-warning">Kayıt bulunamadı.</div>
}
else
{
    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">
            <span class="badge bg-light text-dark border fs-5">@Model.Arac.Plaka</span>
            <span class="ms-2 fw-normal fs-5 text-muted">Araç Detay</span>
        </h2>
        <div class="btn-group btn-group-sm">
            <a asp-page="./Edit"   asp-route-id="@Model.Arac.AracID" class="btn btn-pastel-amber">Düzenle</a>
            <a asp-page="./Delete" asp-route-id="@Model.Arac.AracID" class="btn btn-pastel-red">Sil</a>
            <a asp-page="./Index"  class="btn btn-pastel-blue">← Liste</a>
        </div>
    </div>

    @* ─── ARAÇ BİLGİLERİ KARTI ──────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-body py-3">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Plaka</div>
                    <div class="fw-semibold">
                        <span class="badge bg-light text-dark border">@Model.Arac.Plaka</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Marka / Model</div>
                    <div class="fw-semibold">@Model.Arac.Marka @Model.Arac.Model</div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Model Yılı</div>
                    <div class="fw-semibold">@Model.Arac.ModelYili</div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Araç Tipi</div>
                    <div class="fw-semibold">@Model.Arac.AracTipi</div>
                </div>
                <div class="col-6 col-md-1">
                    <div class="text-muted small">Tür</div>
                    <div>
                        <span class="badge @(Model.Arac.IsDorse ? "bg-info text-dark" : "bg-primary bg-opacity-75")">
                            @(Model.Arac.IsDorse ? "Dorse" : "Çekici")
                        </span>
                    </div>
                </div>
                <div class="col-6 col-md-1">
                    <div class="text-muted small">Durum</div>
                    <div>
                        <span class="badge @(Model.Arac.Durum == "Aktif" ? "bg-success bg-opacity-75" : "bg-secondary")">
                            @Model.Arac.Durum
                        </span>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Arac.Notlar))
                {
                    <div class="col-12">
                        <div class="text-muted small">Notlar</div>
                        <div>@Model.Arac.Notlar</div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ─── BELGELER ───────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h5 class="m-0">Belgeler</h5>
        <a asp-page="/Belgeler/Create" asp-route-aracId="@Model.Arac.AracID" class="btn btn-pastel-green btn-sm">+ Yeni Belge</a>
    </div>

    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>Belge Tipi</th>
                    <th>Belge No</th>
                    <th>Firma</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Tutar</th>
                    <th>Para</th>
                    <th class="text-end" style="width:200px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Belgeler.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-3">Belge kaydı yok.</td></tr>
            }
            @foreach (var b in Model.Belgeler)
            {
                string bitisBadge = "badge bg-secondary bg-opacity-50 text-dark";
                string bitisEtiket = b.BitisTarihi?.ToString("dd.MM.yyyy") ?? "-";
                if (b.BitisTarihi.HasValue)
                {
                    int kalan = b.BitisTarihi.Value.DayNumber - today.DayNumber;
                    if (kalan < 0)
                    {
                        bitisBadge = "badge bg-danger";
                        bitisEtiket = b.BitisTarihi.Value.ToString("dd.MM.yyyy") + " ⚠";
                    }
                    else if (kalan <= 7)
                    {
                        bitisBadge = "badge bg-danger";
                        bitisEtiket = b.BitisTarihi.Value.ToString("dd.MM.yyyy") + " (" + kalan + " gün)";
                    }
                    else if (kalan <= 30)
                    {
                        bitisBadge = "badge bg-warning text-dark";
                        bitisEtiket = b.BitisTarihi.Value.ToString("dd.MM.yyyy") + " (" + kalan + " gün)";
                    }
                }
                <tr>
                    <td class="fw-semibold">@b.BelgeTipi</td>
                    <td>@b.BelgeNo</td>
                    <td>@b.Firma</td>
                    <td>@b.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                    <td><span class="@bitisBadge">@bitisEtiket</span></td>
                    <td>@(b.Tutar?.ToString("N2") ?? "-")</td>
                    <td>@b.ParaBirimi</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-page="/Belgeler/Details" asp-route-id="@b.BelgeID" class="btn btn-pastel-blue">Detay</a>
                            <a asp-page="/Belgeler/Edit"    asp-route-id="@b.BelgeID" class="btn btn-pastel-amber">Düzenle</a>
                            <a asp-page="/Belgeler/Delete"  asp-route-id="@b.BelgeID" class="btn btn-pastel-red">Sil</a>
                            @if (!string.IsNullOrEmpty(b.DosyaYolu))
                            {
                                <a href="@b.DosyaYolu" target="_blank" rel="noopener" class="btn btn-pastel-green">Görsel</a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

</div>
