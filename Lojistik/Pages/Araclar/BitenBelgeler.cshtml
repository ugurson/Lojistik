@page
@model Lojistik.Pages.Araclar.BitenBelgelerModel
@{
    ViewData["Title"] = "Süresi Biten / Yaklaşan Belgeler";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Belge Takip</h2>
        <div class="d-flex gap-2">
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Araç Listesi</a>
            <button type="button" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#yardimModal"
                    title="Bu sayfa hakkında yardım">
                ❓ Yardım
            </button>
        </div>
    </div>

    @* ─── SÜRESİ BİTENLER ──────────────────────────────────────── *@
    <div id="bitenler" class="d-flex align-items-center gap-2 mb-2" style="scroll-margin-top:1rem;">
        <h5 class="m-0 text-danger">Süresi Biten Belgeler</h5>
        @if (Model.Bitenler?.Any() == true)
        {
            <span class="badge bg-danger">@Model.Bitenler.Count()</span>
        }
    </div>

    @if (Model.Bitenler == null || !Model.Bitenler.Any())
    {
        <div class="alert alert-success py-2 mb-4">Süresi biten belge yok.</div>
    }
    else
    {
        <div class="lj-table-wrap mb-4">
            <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
                <thead>
                    <tr>
                        <th>Plaka</th>
                        <th>Belge Tipi</th>
                        <th>Bitiş Tarihi</th>
                        <th class="text-end" style="width:200px">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bitenler)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border">@b.Arac?.Plaka</span>
                            </td>
                            <td class="fw-semibold">@b.BelgeTipi</td>
                            <td>
                                <span class="badge bg-danger">
                                    @b.BitisTarihi?.ToString("dd.MM.yyyy") ⚠
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="/Belgeler/Details" asp-route-id="@b.BelgeID"
                                       asp-route-aracId="@b.AracID" asp-route-returnUrl="/Araclar/BitenBelgeler"
                                       class="btn btn-pastel-blue">Detay</a>
                                    <a asp-page="/Belgeler/Edit" asp-route-id="@b.BelgeID"
                                       asp-route-aracId="@b.AracID" asp-route-returnUrl="/Araclar/BitenBelgeler"
                                       class="btn btn-pastel-amber">Düzenle</a>
                                    <a asp-page="/Belgeler/Delete" asp-route-id="@b.BelgeID"
                                       asp-route-aracId="@b.AracID" asp-route-returnUrl="/Araclar/BitenBelgeler"
                                       class="btn btn-pastel-red">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ─── 30 GÜN İÇİNDE BİTECEKLER ───────────────────────────── *@
    <div id="yaklasanlar" class="d-flex align-items-center gap-2 mb-2" style="scroll-margin-top:1rem;">
        <h5 class="m-0 text-warning">30 Gün İçinde Bitecek Belgeler</h5>
        @if (Model.Yaklasanlar?.Any() == true)
        {
            <span class="badge bg-warning text-dark">@Model.Yaklasanlar.Count()</span>
        }
    </div>

    @if (Model.Yaklasanlar == null || !Model.Yaklasanlar.Any())
    {
        <div class="alert alert-info py-2">30 gün içinde bitecek belge yok.</div>
    }
    else
    {
        <div class="lj-table-wrap">
            <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
                <thead>
                    <tr>
                        <th>Plaka</th>
                        <th>Belge Tipi</th>
                        <th>Bitiş Tarihi</th>
                        <th>Kalan</th>
                        <th class="text-end" style="width:200px">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Yaklasanlar)
                    {
                        var kalan = b.BitisTarihi.HasValue ? (b.BitisTarihi.Value.DayNumber - today.DayNumber) : 0;
                        var kalanBadge = kalan <= 7 ? "badge bg-danger" : "badge bg-warning text-dark";
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border">@b.Arac?.Plaka</span>
                            </td>
                            <td class="fw-semibold">@b.BelgeTipi</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @b.BitisTarihi?.ToString("dd.MM.yyyy")
                                </span>
                            </td>
                            <td>
                                <span class="@kalanBadge">@kalan gün</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="/Belgeler/Details" asp-route-id="@b.BelgeID"
                                       asp-route-aracId="@b.AracID" asp-route-returnUrl="/Araclar/BitenBelgeler"
                                       class="btn btn-pastel-blue">Detay</a>
                                    <a asp-page="/Belgeler/Edit" asp-route-id="@b.BelgeID"
                                       asp-route-aracId="@b.AracID" asp-route-returnUrl="/Araclar/BitenBelgeler"
                                       class="btn btn-pastel-amber">Düzenle</a>
                                    <a asp-page="/Belgeler/Delete" asp-route-id="@b.BelgeID"
                                       asp-route-aracId="@b.AracID" asp-route-returnUrl="/Araclar/BitenBelgeler"
                                       class="btn btn-pastel-red">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Belge Takip — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa, süresi dolmuş veya yakında dolacak araç belgelerini listeler. Belge takibini kolaylaştırmak için iki bölüme ayrılmıştır.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🔴 Süresi Biten Belgeler</h6>
                    <p class="text-muted mb-0">Geçerlilik tarihi bugünden önce olan belgeler. Bu belgeler acil yenileme gerektirir.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🟡 30 Gün İçinde Bitecek Belgeler</h6>
                    <p class="text-muted mb-2">Önümüzdeki 30 gün içinde süresi dolacak belgeler. Erken aksiyon almanızı hatırlatır.</p>
                    <ul class="mb-0">
                        <li><span style="color:#dc3545;">Kırmızı rozet</span> — 7 gün veya daha az kalmış.</li>
                        <li><span style="color:#b45309;">Sarı rozet</span> — 8-30 gün kalmış.</li>
                    </ul>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ İşlemler</h6>
                    <ul class="mb-0">
                        <li><strong>Detay</strong> — Belge bilgilerini görüntüleyin.</li>
                        <li><strong>Düzenle</strong> — Belgeyi yenileyin; yeni başlangıç/bitiş tarihi girin.</li>
                        <li><strong>Sil</strong> — Eski belgeyi kaldırın.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
