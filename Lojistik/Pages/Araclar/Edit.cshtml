@page "{id:int}"
@model Lojistik.Pages.Araclar.EditModel
@{
    ViewData["Title"] = "Araç Düzenle";
}

<style>
    .lj-card-hdr { font-size: 0.82rem; letter-spacing: .04em; text-transform: uppercase; }
    .lj-lbl      { font-size: 0.78rem; margin-bottom: 2px; color: #6c757d; }
</style>

<div class="lj-page-compact">

    @* ─── BAŞLIK ─────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Araç Düzenle</h2>
        <div class="d-flex gap-2">
            <button type="submit" form="mainForm" class="btn btn-pastel-green btn-sm">Kaydet</button>
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Liste</a>
        </div>
    </div>

    <form id="mainForm" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-2 small"></div>
        <input type="hidden" asp-for="Arac.AracID" />

        <div class="card mb-2">
            <div class="card-header py-1 px-3 fw-semibold lj-card-hdr">Araç Bilgileri</div>
            <div class="card-body py-2 px-3">
                <div class="row g-2">

                    @* Satır 1: Plaka · Marka · Model · Model Yılı · Araç Tipi · Durum *@
                    <div class="col-md-2">
                        <label class="form-label lj-lbl">Plaka</label>
                        <input class="form-control form-control-sm" asp-for="Arac.Plaka" />
                        <span class="text-danger small" asp-validation-for="Arac.Plaka"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label lj-lbl">Marka</label>
                        <input class="form-control form-control-sm" asp-for="Arac.Marka" />
                        <span class="text-danger small" asp-validation-for="Arac.Marka"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label lj-lbl">Model</label>
                        <input class="form-control form-control-sm" asp-for="Arac.Model" />
                        <span class="text-danger small" asp-validation-for="Arac.Model"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label lj-lbl">Model Yılı</label>
                        <input class="form-control form-control-sm" asp-for="Arac.ModelYili" />
                        <span class="text-danger small" asp-validation-for="Arac.ModelYili"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label lj-lbl">Araç Tipi</label>
                        <input class="form-control form-control-sm" asp-for="Arac.AracTipi" />
                        <span class="text-danger small" asp-validation-for="Arac.AracTipi"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label lj-lbl">Durum</label>
                        <input class="form-control form-control-sm" asp-for="Arac.Durum" />
                        <span class="text-danger small" asp-validation-for="Arac.Durum"></span>
                    </div>

                    @* Satır 2: Dorse checkbox · Notlar *@
                    <div class="col-auto d-flex align-items-end pb-1">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Arac.IsDorse" />
                            <label class="form-check-label" asp-for="Arac.IsDorse">Dorse</label>
                        </div>
                    </div>
                    <div class="col">
                        <label class="form-label lj-lbl">Notlar</label>
                        <textarea class="form-control form-control-sm" asp-for="Arac.Notlar" rows="2"></textarea>
                    </div>

                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-pastel-green btn-sm">Kaydet</button>
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">İptal</a>
        </div>
    </form>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
