@page
@model Lojistik.Pages.Araclar.CreateModel
@{
    ViewData["Title"] = "Araç Ekle";
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Yeni Araç</h2>
        <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Liste</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Plaka</label>
                        <input asp-for="Arac.Plaka" class="form-control" />
                        <span asp-validation-for="Arac.Plaka" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Marka</label>
                        <input asp-for="Arac.Marka" class="form-control" />
                        <span asp-validation-for="Arac.Marka" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Model</label>
                        <input asp-for="Arac.Model" class="form-control" />
                        <span asp-validation-for="Arac.Model" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Model Yılı</label>
                        <input asp-for="Arac.ModelYili" class="form-control" />
                        <span asp-validation-for="Arac.ModelYili" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Araç Tipi</label>
                        <select asp-for="Arac.AracTipi" class="form-select" asp-items="Model.AracTipleri">
                            <option value="">Seçiniz…</option>
                        </select>
                        <span asp-validation-for="Arac.AracTipi" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Durum</label>
                        <select asp-for="Arac.Durum" class="form-select" asp-items="Model.Durumlar">
                            <option value="">Seçiniz…</option>
                        </select>
                        <span asp-validation-for="Arac.Durum" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-3 d-flex align-items-end gap-3 pb-1">
                        <div class="form-check">
                            <input asp-for="Arac.IsDorse" class="form-check-input" />
                            <label class="form-check-label" for="Arac_IsDorse">Dorse</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="OzmalMi" class="form-check-input" />
                            <label class="form-check-label" for="OzmalMi">Özmal</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notlar</label>
                        <input asp-for="Arac.Notlar" class="form-control" />
                        <span asp-validation-for="Arac.Notlar" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-pastel-green">Kaydet</button>
                    <a asp-page="./Index" class="btn btn-pastel-blue">İptal</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
