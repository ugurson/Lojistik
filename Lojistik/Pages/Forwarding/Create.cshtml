@page
@model Lojistik.Pages.Forwarding.CreateModel
@{
    ViewData["Title"] = "Yeni Forwarding İşi";
}

<div class="lj-page-compact">

    @* ── Başlık + Hızlı Kaydet ── *@
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="mb-0 fs-5 fw-semibold">Yeni Forwarding İşi</h2>
        <div class="d-flex gap-2">
            <button type="submit" form="mainForm" class="btn btn-pastel-green btn-sm">Kaydet</button>
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Liste</a>
        </div>
    </div>

    <form method="post" id="mainForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small"></div>

        @* ══ Taraflar ══════════════════════════════════════════════════════ *@
        <div class="card mb-2">
            <div class="card-header fw-semibold py-1 px-3" style="font-size:0.82rem;letter-spacing:.03em;">TARAFLAR</div>
            <div class="card-body py-2 px-3">
                <div class="row g-2">

                    @* Yükü Veren *@
                    <div class="col-md-4">
                        <label class="form-label mb-1" style="font-size:0.78rem;">
                            Yükü Veren <span class="text-muted">· Müşteri</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <select id="sel-yukuveren" asp-for="Input.YukuVerenID"
                                    asp-items="Model.YukuVerenSelect" class="form-select form-select-sm">
                                <option value="">— Seçin —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary px-2"
                                    title="Yeni firma ekle" onclick="modalAc(0)">+</button>
                        </div>
                    </div>

                    @* Yükü Alan *@
                    <div class="col-md-4">
                        <label class="form-label mb-1" style="font-size:0.78rem;">
                            Yükü Alan <span class="text-muted">· Müşteri</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <select id="sel-yukualan" asp-for="Input.YukuAlanID"
                                    asp-items="Model.YukuAlanSelect" class="form-select form-select-sm">
                                <option value="">— Seçin —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary px-2"
                                    title="Yeni firma ekle" onclick="modalAc(0)">+</button>
                        </div>
                    </div>

                    @* Taşıyıcı *@
                    <div class="col-md-4">
                        <label class="form-label mb-1" style="font-size:0.78rem;">
                            Taşıyıcı <span class="text-muted">· Nakliyeci</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <select id="sel-tasiyici" asp-for="Input.TasiyiciMusteriID"
                                    asp-items="Model.TasiyiciSelect" class="form-select form-select-sm">
                                <option value="">— Seçin —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary px-2"
                                    title="Yeni nakliyeci ekle" onclick="modalAc(2)">+</button>
                        </div>
                    </div>

                    @* Taşıyıcı serbest *@
                    <div class="col-md-6">
                        <label asp-for="Input.TasiyiciAdi" class="form-label mb-1" style="font-size:0.78rem;">
                            Taşıyıcı Adı <span class="text-muted">(sistemde yoksa serbest metin)</span>
                        </label>
                        <input asp-for="Input.TasiyiciAdi" class="form-control form-control-sm" placeholder="Firma adı" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.TasiyiciUlke" class="form-label mb-1" style="font-size:0.78rem;">Taşıyıcı Ülke</label>
                        <input asp-for="Input.TasiyiciUlke" class="form-control form-control-sm" />
                    </div>

                </div>
            </div>
        </div>

        @* ══ Dosya & Güzergah ═══════════════════════════════════════════════ *@
        <div class="card mb-2">
            <div class="card-header fw-semibold py-1 px-3" style="font-size:0.82rem;letter-spacing:.03em;">DOSYA & GÜZERGAH</div>
            <div class="card-body py-2 px-3">
                <div class="row g-2">

                    <div class="col-6 col-sm-4 col-md-2">
                        <label asp-for="Input.DosyaNo" class="form-label mb-1" style="font-size:0.78rem;">Dosya No</label>
                        <input asp-for="Input.DosyaNo" class="form-control form-control-sm" placeholder="FWD-2024-001" />
                    </div>
                    <div class="col-6 col-sm-4 col-md-2">
                        <label asp-for="Input.YuklemeTarihi" class="form-label mb-1" style="font-size:0.78rem;">Yükleme Tarihi</label>
                        <input asp-for="Input.YuklemeTarihi" type="date" class="form-control form-control-sm" id="Input_YuklemeTarihi" />
                    </div>
                    <div class="col-6 col-sm-4 col-md-2">
                        <label asp-for="Input.TeslimTarihi" class="form-label mb-1" style="font-size:0.78rem;">Planlanan Teslim</label>
                        <input asp-for="Input.TeslimTarihi" type="date" class="form-control form-control-sm" id="Input_TeslimTarihi" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.YuklemeyeriAdi" class="form-label mb-1" style="font-size:0.78rem;">
                            Çıkış Adresi <span class="text-muted">(Yükü Veren seçilince dolar)</span>
                        </label>
                        <textarea id="txt-cikis" asp-for="Input.YuklemeyeriAdi"
                                  rows="2" class="form-control form-control-sm"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.VarisYeriAdi" class="form-label mb-1" style="font-size:0.78rem;">
                            Varış Adresi <span class="text-muted">(Yükü Alan seçilince dolar)</span>
                        </label>
                        <textarea id="txt-varis" asp-for="Input.VarisYeriAdi"
                                  rows="2" class="form-control form-control-sm"></textarea>
                    </div>

                </div>
            </div>
        </div>

        @* ══ Yük & Evraklar (Kalemler dahil) ════════════════════════════════ *@
        <div class="card mb-2">
            <div class="card-header fw-semibold py-1 px-3" style="font-size:0.82rem;letter-spacing:.03em;">YÜK & EVRAKLAR</div>
            <div class="card-body py-2 px-3">
                <div class="row g-2 align-items-end">

                    @* ── Adet & Nevi (formla birlikte kaydedilir) ── *@
                    <div class="col-sm-2 col-md-1">
                        <label class="form-label mb-1" style="font-size:0.78rem;">Adet</label>
                        <input name="Input.Kalemler[0].Adet" type="number" min="0.001" step="0.001"
                               class="form-control form-control-sm" placeholder="1" />
                    </div>
                    <div class="col-sm-4 col-md-2">
                        <label class="form-label mb-1" style="font-size:0.78rem;">Nevi</label>
                        <select name="Input.Kalemler[0].Nevi" class="form-select form-select-sm">
                            <option value="Palet">Palet</option>
                            <option value="Koli">Koli</option>
                            <option value="Kutu">Kutu</option>
                            <option value="Çuval">Çuval</option>
                            <option value="Big Bag">Big Bag</option>
                            <option value="Varil">Varil</option>
                            <option value="Konteyner">Konteyner</option>
                            <option value="Adet">Adet</option>
                            <option value="Ton">Ton</option>
                            <option value="Diğer">Diğer</option>
                        </select>
                    </div>

                    @* Separator *@
                    <div class="col-12"><hr class="my-1 opacity-25" /></div>

                    @* ── Eşya Cinsi · KG · Hacim · CMR ── *@
                    <div class="col-md-4 col-sm-6">
                        <label asp-for="Input.EsyaCinsi" class="form-label mb-1" style="font-size:0.78rem;">Eşya Cinsi</label>
                        <input asp-for="Input.EsyaCinsi" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6 col-sm-3 col-md-2">
                        <label asp-for="Input.BrutKg" class="form-label mb-1" style="font-size:0.78rem;">Brüt KG</label>
                        <input asp-for="Input.BrutKg" type="number" step="0.01" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6 col-sm-3 col-md-2">
                        <label asp-for="Input.CbmHacim" class="form-label mb-1" style="font-size:0.78rem;">Hacim (m³)</label>
                        <input asp-for="Input.CbmHacim" type="number" step="0.001" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <label asp-for="Input.CmrNo" class="form-label mb-1" style="font-size:0.78rem;">CMR No</label>
                        <input asp-for="Input.CmrNo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <label asp-for="Input.TransitNo" class="form-label mb-1" style="font-size:0.78rem;">Transit No</label>
                        <input asp-for="Input.TransitNo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <label asp-for="Input.GumrukBeyanNo" class="form-label mb-1" style="font-size:0.78rem;">Gümrük Beyan No</label>
                        <input asp-for="Input.GumrukBeyanNo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Notlar" class="form-label mb-1" style="font-size:0.78rem;">Notlar</label>
                        <textarea asp-for="Input.Notlar" rows="2" class="form-control form-control-sm"></textarea>
                    </div>

                </div>
            </div>
        </div>

        @* ── Alt Butonlar ── *@
        <div class="d-flex gap-2 mt-1 mb-3">
            <button class="btn btn-pastel-green btn-sm" type="submit">Kaydet</button>
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">İptal</a>
        </div>

    </form>
</div>

@* ── Hızlı Firma Ekle Modalı ── *@
<div class="modal fade" id="hizliModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2 px-3">
                <h6 class="modal-title fw-semibold">Hızlı Firma Ekle</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2 px-3">
                <div id="hizliHata" class="alert alert-danger d-none py-2 mb-2 small"></div>
                <div class="mb-2">
                    <label class="form-label mb-1 small fw-semibold">Kategori</label>
                    <select id="hizliKategori" class="form-select form-select-sm">
                        <option value="0">Müşteri</option>
                        <option value="2">Nakliyeci</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1 small fw-semibold">Firma Adı *</label>
                    <input id="hizliAdi" type="text" class="form-control form-control-sm" placeholder="Firma adı" />
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1 small fw-semibold">Ülke *</label>
                    <select id="hizliUlke" class="form-select form-select-sm">
                        <option value="">— Seçin —</option>
                        @foreach (var u in Model.UlkeList)
                        {
                            <option value="@u.UlkeID">@u.UlkeAdi</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1 small fw-semibold">Şehir *</label>
                    <select id="hizliSehir" class="form-select form-select-sm" disabled>
                        <option value="">Önce ülke seçin</option>
                    </select>
                </div>
                <div class="mb-1">
                    <label class="form-label mb-1 small">Adres</label>
                    <input id="hizliAdres" type="text" class="form-control form-control-sm" placeholder="Opsiyonel" />
                </div>
            </div>
            <div class="modal-footer py-2 px-3">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="hizliKaydetBtn" class="btn btn-pastel-green btn-sm">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Bugünün tarihini otomatik doldur ─────────────────────────────
        (function () {
            var d = new Date();
            var pad = function (n) { return String(n).padStart(2, '0'); };
            var today = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            var ids = ['Input_YuklemeTarihi', 'Input_TeslimTarihi'];
            ids.forEach(function (id) {
                var el = document.getElementById(id);
                if (el && !el.value) el.value = today;
            });
        })();

        // ── Adres otomatik doldurma ───────────────────────────────────────
        var _adresler    = @Html.Raw(Model.MusteriAdresJson);
        var _sehirApiUrl = '@Url.Page("./Create", null, new { handler = "Sehirler" }, Request.Scheme)';
        var _ekleApiUrl  = '@Url.Page("./Create", null, new { handler = "HizliMusteri" }, Request.Scheme)';
        var _token       = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        document.getElementById('sel-yukuveren').addEventListener('change', function () {
            document.getElementById('txt-cikis').value = _adresler[this.value] || '';
        });
        document.getElementById('sel-yukualan').addEventListener('change', function () {
            document.getElementById('txt-varis').value = _adresler[this.value] || '';
        });

        // ── Hızlı firma modal ─────────────────────────────────────────────
        function modalAc(kategori) {
            document.getElementById('hizliKategori').value = kategori;
            document.getElementById('hizliAdi').value      = '';
            document.getElementById('hizliAdres').value    = '';
            document.getElementById('hizliUlke').value     = '';
            document.getElementById('hizliSehir').innerHTML = '<option value="">Önce ülke seçin</option>';
            document.getElementById('hizliSehir').disabled  = true;
            document.getElementById('hizliHata').classList.add('d-none');
            new bootstrap.Modal(document.getElementById('hizliModal')).show();
        }

        // Ülke → Şehir cascade
        document.getElementById('hizliUlke').addEventListener('change', async function () {
            const ulkeId   = this.value;
            const sehirSel = document.getElementById('hizliSehir');
            if (!ulkeId) { sehirSel.innerHTML = '<option value="">Önce ülke seçin</option>'; sehirSel.disabled = true; return; }
            sehirSel.disabled = true;
            sehirSel.innerHTML = '<option value="">Yükleniyor…</option>';
            try {
                const res  = await fetch(_sehirApiUrl + '&ulkeId=' + ulkeId, { headers: { Accept: 'application/json' } });
                const data = await res.json();
                sehirSel.innerHTML = '<option value="">— Seçin —</option>';
                data.forEach(s => {
                    const o = document.createElement('option');
                    o.value = s.sehirID; o.textContent = s.sehirAdi;
                    sehirSel.appendChild(o);
                });
                sehirSel.disabled = false;
            } catch { sehirSel.innerHTML = '<option value="">Hata</option>'; }
        });

        // Modal kaydet
        document.getElementById('hizliKaydetBtn').addEventListener('click', async function () {
            const btn  = this;
            const hata = document.getElementById('hizliHata');
            const adi  = document.getElementById('hizliAdi').value.trim();
            const kat  = document.getElementById('hizliKategori').value;
            const ulke = document.getElementById('hizliUlke').value;
            const seh  = document.getElementById('hizliSehir').value;
            const adr  = document.getElementById('hizliAdres').value.trim();

            if (!adi || !ulke || !seh) {
                hata.textContent = 'Ad, ülke ve şehir zorunludur.';
                hata.classList.remove('d-none');
                return;
            }
            hata.classList.add('d-none');
            btn.disabled = true; btn.textContent = 'Kaydediliyor…';

            const fd = new FormData();
            fd.append('hizliAdi',      adi);
            fd.append('hizliKategori', kat);
            fd.append('hizliUlkeId',   ulke);
            fd.append('hizliSehirId',  seh);
            fd.append('hizliAdres',    adr);
            fd.append('__RequestVerificationToken', _token);

            try {
                const res  = await fetch(_ekleApiUrl, { method: 'POST', body: fd });
                const data = await res.json();
                if (!data.success) { hata.textContent = data.error || 'Hata oluştu.'; hata.classList.remove('d-none'); return; }

                _adresler[data.musteriId] = data.adres || '';

                function ekleOption(selId, id, adi) {
                    const sel = document.getElementById(selId);
                    const o = document.createElement('option');
                    o.value = id; o.textContent = adi; o.selected = true;
                    sel.appendChild(o);
                    sel.dispatchEvent(new Event('change'));
                }
                const k = parseInt(kat);
                if (k === 0) {
                    ekleOption('sel-yukuveren', data.musteriId, data.musteriAdi);
                    ekleOption('sel-yukualan',  data.musteriId, data.musteriAdi);
                }
                if (k === 2) {
                    ekleOption('sel-tasiyici', data.musteriId, data.musteriAdi);
                }
                bootstrap.Modal.getInstance(document.getElementById('hizliModal')).hide();
            } catch {
                hata.textContent = 'Sunucu hatası.'; hata.classList.remove('d-none');
            } finally {
                btn.disabled = false; btn.textContent = 'Kaydet';
            }
        });
    </script>
}
