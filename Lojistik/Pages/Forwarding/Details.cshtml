@page "{id:int}"
@model Lojistik.Pages.Forwarding.DetailsModel
@using Lojistik.Models
@{
    ViewData["Title"] = $"Forwarding — {Model.Is.DosyaNo ?? "#" + Model.Is.ForwardingID}";
    var tumPBler = Model.SatisToplam.Keys.Union(Model.AlisToplam.Keys).Distinct().OrderBy(x => x).ToList();
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">@(Model.Is.DosyaNo ?? $"Forwarding #{Model.Is.ForwardingID}")</h2>
            <small class="text-muted">
                @(Model.Is.YukuVeren?.MusteriAdi ?? Model.Is.Musteri?.MusteriAdi)
                @if (Model.Is.YukuAlan != null) { <span class="mx-1">→</span><span>@Model.Is.YukuAlan.MusteriAdi</span> }
            </small>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-id="@Model.Is.ForwardingID" class="btn btn-pastel-amber btn-sm">Düzenle</a>
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Liste</a>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string msg)
    {
        <div class="alert alert-success alert-dismissible py-2">@msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Durum bandı *@
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <span class="badge @ForwardingIs.DurumBadgeCss(Model.Is.Durum) fs-6">@ForwardingIs.DurumAdi(Model.Is.Durum)</span>
        @{
            var durumlar = new[] {
                (d: (byte)0, lbl: "Taslak"),
                (d: (byte)1, lbl: "Aktif"),
                (d: (byte)2, lbl: "Yüklendi"),
                (d: (byte)3, lbl: "Teslim Edildi"),
                (d: (byte)4, lbl: "İptal"),
            };
        }
        @foreach (var ds in durumlar.Where(x => x.d != Model.Is.Durum))
        {
            <form method="post" asp-page-handler="DurumGuncelle" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="yeniDurum" value="@ds.d" />
                <button class="btn btn-outline-secondary btn-sm" type="submit">→ @ds.lbl</button>
            </form>
        }
    </div>

    @* Tab yapısı *@
    <ul class="nav nav-tabs mb-3" id="fwdTab">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-genel">Genel Bilgi</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-fiyat">Fiyatlar</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-evrak">Evraklar</a></li>
    </ul>

    <div class="tab-content">

        @* ── Genel Bilgi ── *@
        <div class="tab-pane fade show active" id="tab-genel">
            <div class="row g-3">

                @* Yükü Veren *@
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header fw-semibold d-flex align-items-center gap-2">
                            <span class="badge bg-primary" style="font-size:0.7rem;">ÇIKIŞ</span> Yükü Veren
                        </div>
                        <div class="card-body">
                            @if (Model.Is.YukuVeren != null)
                            {
                                <div class="fw-semibold">@Model.Is.YukuVeren.MusteriAdi</div>
                                <div class="text-muted small">@(Model.Is.YukuVeren.Sehir?.SehirAdi ?? "—")</div>
                            }
                            else { <span class="text-muted">—</span> }
                            @if (!string.IsNullOrWhiteSpace(Model.Is.YuklemeyeriAdi))
                            {
                                <hr class="my-2" />
                                <div class="small" style="white-space:pre-wrap;">@Model.Is.YuklemeyeriAdi</div>
                            }
                        </div>
                    </div>
                </div>

                @* Yükü Alan *@
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header fw-semibold d-flex align-items-center gap-2">
                            <span class="badge bg-success" style="font-size:0.7rem;">VARIŞ</span> Yükü Alan
                        </div>
                        <div class="card-body">
                            @if (Model.Is.YukuAlan != null)
                            {
                                <div class="fw-semibold">@Model.Is.YukuAlan.MusteriAdi</div>
                                <div class="text-muted small">@(Model.Is.YukuAlan.Sehir?.SehirAdi ?? "—")</div>
                            }
                            else { <span class="text-muted">—</span> }
                            @if (!string.IsNullOrWhiteSpace(Model.Is.VarisYeriAdi))
                            {
                                <hr class="my-2" />
                                <div class="small" style="white-space:pre-wrap;">@Model.Is.VarisYeriAdi</div>
                            }
                        </div>
                    </div>
                </div>

                @* Taşıyıcı *@
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header fw-semibold d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark" style="font-size:0.7rem;">NAKLİYE</span> Taşıyıcı
                        </div>
                        <div class="card-body">
                            @if (Model.Is.TasiyiciMusteri != null)
                            {
                                <div class="fw-semibold">@Model.Is.TasiyiciMusteri.MusteriAdi</div>
                                <div class="text-muted small">@(Model.Is.TasiyiciMusteri.Sehir?.SehirAdi ?? "—")</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.Is.TasiyiciAdi))
                            {
                                <div class="fw-semibold">@Model.Is.TasiyiciAdi</div>
                                <div class="text-muted small">@(Model.Is.TasiyiciUlke ?? "—")</div>
                            }
                            else { <span class="text-muted">—</span> }
                        </div>
                    </div>
                </div>

                @* Tarihler *@
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header fw-semibold">Tarihler</div>
                        <div class="card-body">
                            <dl class="row mb-0" style="font-size:0.9rem;">
                                <dt class="col-5 text-muted">Yükleme Tarihi</dt>
                                <dd class="col-7">@(Model.Is.YuklemeTarihi?.ToString("dd.MM.yyyy") ?? "—")</dd>
                                <dt class="col-5 text-muted">Planlanan Teslim</dt>
                                <dd class="col-7">@(Model.Is.TeslimTarihi?.ToString("dd.MM.yyyy") ?? "—")</dd>
                                <dt class="col-5 text-muted">Gerçek Teslim</dt>
                                <dd class="col-7">
                                    @if (Model.Is.GercekTeslimTarihi.HasValue)
                                    { <span class="text-success fw-semibold">@Model.Is.GercekTeslimTarihi.Value.ToString("dd.MM.yyyy")</span> }
                                    else { <span class="text-muted">—</span> }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>

                @* Yük *@
                <div class="col-12">
                    <div class="card">
                        <div class="card-header fw-semibold">Yük</div>
                        <div class="card-body">

                            @* Genel bilgiler *@
                            <dl class="row mb-0" style="font-size:0.9rem;">
                                <dt class="col-sm-2 text-muted">Eşya Cinsi</dt>
                                <dd class="col-sm-4">@(Model.Is.EsyaCinsi ?? "—")</dd>
                                <dt class="col-sm-2 text-muted">Brüt KG</dt>
                                <dd class="col-sm-2">@(Model.Is.BrutKg?.ToString("N2") ?? "—")</dd>
                                <dt class="col-sm-1 text-muted">Hacim m³</dt>
                                <dd class="col-sm-1">@(Model.Is.CbmHacim?.ToString("N3") ?? "—")</dd>
                            </dl>

                            <hr class="my-3" />

                            @* Kalemler tablosu *@
                            <div class="mb-2 fw-semibold" style="font-size:0.88rem;">Ambalaj / Ürün Kalemleri</div>

                            @if (Model.Kalemler.Any())
                            {
                                <table class="table table-sm align-middle mb-2 lj-table lj-table-compact" style="font-size:0.88rem;">
                                    <thead>
                                        <tr>
                                            <th style="width:90px;">Adet</th>
                                            <th style="width:130px;">Nevi / Birim</th>
                                            <th>Açıklama</th>
                                            <th style="width:60px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var k in Model.Kalemler)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@(k.Adet % 1 == 0 ? k.Adet.ToString("N0") : k.Adet.ToString("N3"))</td>
                                                <td>@k.Nevi</td>
                                                <td class="text-muted">@k.Aciklama</td>
                                                <td class="text-end">
                                                    <form method="post" asp-page-handler="KalemSil" asp-route-kalemId="@k.KalemID"
                                                          onsubmit="return confirm('Bu kalem silinsin mi?');">
                                                        @Html.AntiForgeryToken()
                                                        <button class="btn btn-pastel-red btn-sm py-0 px-2" type="submit">Sil</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="4" class="text-muted small">
                                                Toplam:
                                                @{
                                                    var gruplar = Model.Kalemler.GroupBy(k => k.Nevi)
                                                        .Select(g => $"{(g.Sum(k => k.Adet) % 1 == 0 ? g.Sum(k => k.Adet).ToString("N0") : g.Sum(k => k.Adet).ToString("N2"))} {g.Key}");
                                                }
                                                @string.Join(" · ", gruplar)
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }
                            else
                            {
                                <div class="text-muted small mb-2">Henüz kalem eklenmedi.</div>
                            }

                            @* Kalem ekleme formu *@
                            <form method="post" asp-page-handler="KalemEkle" class="row g-2 align-items-end mt-1">
                                @Html.AntiForgeryToken()
                                <div class="col-sm-2">
                                    <label class="form-label form-label-sm mb-1">Adet</label>
                                    <input asp-for="YeniKalem.Adet" type="number" step="0.001" min="0.001"
                                           class="form-control form-control-sm" placeholder="2" />
                                </div>
                                <div class="col-sm-3">
                                    <label class="form-label form-label-sm mb-1">Nevi / Birim</label>
                                    <select asp-for="YeniKalem.Nevi" class="form-select form-select-sm">
                                        <option>Palet</option>
                                        <option>Koli</option>
                                        <option>Kutu</option>
                                        <option>Çuval</option>
                                        <option>Big Bag</option>
                                        <option>Varil</option>
                                        <option>Konteyner</option>
                                        <option>Adet</option>
                                        <option>Ton</option>
                                        <option>Diğer</option>
                                    </select>
                                </div>
                                <div class="col-sm-5">
                                    <label class="form-label form-label-sm mb-1">Açıklama (opsiyonel)</label>
                                    <input asp-for="YeniKalem.Aciklama" class="form-control form-control-sm"
                                           placeholder="Ör: Ahşap palet, kırılabilir..." />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-pastel-green btn-sm" type="submit">Ekle</button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Is.Notlar))
                {
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header fw-semibold">Notlar</div>
                            <div class="card-body" style="white-space:pre-wrap;font-size:0.9rem;">@Model.Is.Notlar</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ── Fiyatlar ── *@
        <div class="tab-pane fade" id="tab-fiyat">

            @* Özet kartlar *@
            @if (tumPBler.Any())
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var pb in tumPBler)
                    {
                        var satis = Model.SatisToplam.TryGetValue(pb, out var sv) ? sv : 0m;
                        var alis  = Model.AlisToplam.TryGetValue(pb, out var av) ? av : 0m;
                        var kar   = satis - alis;
                        var karCls = kar > 0 ? "text-success" : kar < 0 ? "text-danger" : "text-muted";
                        <div class="card px-3 py-2 border-0" style="background:#f0f4ff; min-width:160px;">
                            <div class="text-muted small fw-semibold">@pb</div>
                            <div class="small">Satış: <strong class="text-success">@satis.ToString("N2")</strong></div>
                            <div class="small">Alış: <strong class="text-danger">@alis.ToString("N2")</strong></div>
                            <div class="fw-bold @karCls">Kâr: @(kar > 0 ? "+" : "")@kar.ToString("N2")</div>
                        </div>
                    }
                </div>
            }

            @* Fiyat listesi *@
            <div class="lj-table-wrap mb-3">
                <table class="table table-sm align-middle mb-0 lj-table lj-table-compact">
                    <thead>
                        <tr>
                            <th>Tür</th>
                            <th>Kalem</th>
                            <th class="text-end">Tutar</th>
                            <th>PB</th>
                            <th>Açıklama</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Fiyatlar.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">Henüz fiyat eklenmedi.</td></tr>
                        }
                        @foreach (var f in Model.Fiyatlar)
                        {
                            var turCls = f.FiyatTuru == "Satis" ? "badge bg-success bg-opacity-75" : "badge bg-danger bg-opacity-75";
                            var turLbl = f.FiyatTuru == "Satis" ? "Satış" : "Alış";
                            <tr>
                                <td><span class="@turCls">@turLbl</span></td>
                                <td>@(f.Kalem ?? "—")</td>
                                <td class="text-end fw-semibold">@f.Tutar.ToString("N2")</td>
                                <td>@f.ParaBirimi</td>
                                <td class="text-muted">@f.Aciklama</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="FiyatSil" asp-route-fiyatId="@f.FiyatID"
                                          onsubmit="return confirm('Bu fiyat kalemi silinsin mi?');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-pastel-red btn-sm">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Fiyat ekleme formu *@
            <div class="card">
                <div class="card-header fw-semibold">Fiyat Ekle</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="FiyatEkle" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-sm-2">
                            <label class="form-label">Tür</label>
                            <select asp-for="YeniFiyat.FiyatTuru" class="form-select">
                                <option value="Satis">Satış</option>
                                <option value="Alis">Alış</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label">Kalem</label>
                            <select asp-for="YeniFiyat.Kalem" class="form-select">
                                <option value="Navlun">Navlun</option>
                                <option value="Gümrük">Gümrük</option>
                                <option value="Sigorta">Sigorta</option>
                                <option value="Elleçleme">Elleçleme</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label">Tutar</label>
                            <input asp-for="YeniFiyat.Tutar" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label">Para Birimi</label>
                            <select asp-for="YeniFiyat.ParaBirimi" class="form-select">
                                <option>EUR</option>
                                <option>USD</option>
                                <option>TL</option>
                                <option>GBP</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label">Açıklama</label>
                            <input asp-for="YeniFiyat.Aciklama" class="form-control" />
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-pastel-green" type="submit">Ekle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* ── Evraklar ── *@
        <div class="tab-pane fade" id="tab-evrak">
            <div class="card">
                <div class="card-body">
                    <dl class="row mb-0" style="font-size:0.92rem;">
                        <dt class="col-sm-3 text-muted">CMR No</dt>
                        <dd class="col-sm-9">@(Model.Is.CmrNo ?? "—")</dd>
                        <dt class="col-sm-3 text-muted">Transit No</dt>
                        <dd class="col-sm-9">@(Model.Is.TransitNo ?? "—")</dd>
                        <dt class="col-sm-3 text-muted">Gümrük Beyan No</dt>
                        <dd class="col-sm-9">@(Model.Is.GumrukBeyanNo ?? "—")</dd>
                    </dl>
                    <div class="mt-3">
                        <a asp-page="./Edit" asp-route-id="@Model.Is.ForwardingID" class="btn btn-pastel-amber btn-sm">Evrak Numaralarını Düzenle</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
