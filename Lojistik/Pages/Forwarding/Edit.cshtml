@page "{id:int}"
@model Lojistik.Pages.Forwarding.EditModel
@{
    ViewData["Title"] = "Forwarding Düzenle";
}

<div class="lj-page-compact">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Forwarding Düzenle</h2>
        <a asp-page="./Details" asp-route-id="@Model.Input.ForwardingID" class="btn btn-pastel-blue btn-sm">← Detay</a>
    </div>

    <form method="post" id="mainForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Input.ForwardingID" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* ── Temel Bilgi ── *@
        <div class="card mb-3">
            <div class="card-header fw-semibold">Temel Bilgi</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Input.DosyaNo" class="form-label">Dosya No</label>
                        <input asp-for="Input.DosyaNo" class="form-control" placeholder="FWD-2024-001" />
                    </div>
                </div>
            </div>
        </div>

        @* ── 3 Taraf ── *@
        <div class="card mb-3">
            <div class="card-header fw-semibold">Taraflar</div>
            <div class="card-body">
                <div class="row g-3">

                    @* Yükü Veren *@
                    <div class="col-md-4">
                        <label class="form-label">Yükü Veren <small class="text-muted">(Müşteri / Tedarikçi)</small></label>
                        <div class="input-group">
                            <select id="sel-yukuveren" asp-for="Input.YukuVerenID" asp-items="Model.YukuVerenSelect" class="form-select">
                                <option value="">— Seçin —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2"
                                    title="Yeni firma ekle" onclick="modalAc(0)">+</button>
                        </div>
                        @if (!Model.YukuVerenSelect.Any())
                        {
                            <div class="text-muted small mt-1">Henüz Müşteri / Tedarikçi yok. <button type="button" class="btn btn-link btn-sm p-0" onclick="modalAc(0)">Yeni ekle →</button></div>
                        }
                    </div>

                    @* Yükü Alan *@
                    <div class="col-md-4">
                        <label class="form-label">Yükü Alan <small class="text-muted">(Müşteri / Tedarikçi)</small></label>
                        <div class="input-group">
                            <select id="sel-yukualan" asp-for="Input.YukuAlanID" asp-items="Model.YukuAlanSelect" class="form-select">
                                <option value="">— Seçin —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2"
                                    title="Yeni firma ekle" onclick="modalAc(0)">+</button>
                        </div>
                        @if (!Model.YukuAlanSelect.Any())
                        {
                            <div class="text-muted small mt-1">Henüz Müşteri / Tedarikçi yok. <button type="button" class="btn btn-link btn-sm p-0" onclick="modalAc(0)">Yeni ekle →</button></div>
                        }
                    </div>

                    @* Taşıyıcı *@
                    <div class="col-md-4">
                        <label class="form-label">Taşıyıcı <small class="text-muted">(Nakliyeci)</small></label>
                        <div class="input-group">
                            <select id="sel-tasiyici" asp-for="Input.TasiyiciMusteriID" asp-items="Model.TasiyiciSelect" class="form-select">
                                <option value="">— Seçin —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2"
                                    title="Yeni nakliyeci ekle" onclick="modalAc(2)">+</button>
                        </div>
                        @if (!Model.TasiyiciSelect.Any())
                        {
                            <div class="text-muted small mt-1">Henüz Nakliyeci yok. <button type="button" class="btn btn-link btn-sm p-0" onclick="modalAc(2)">Yeni ekle →</button></div>
                        }
                    </div>

                    @* Taşıyıcı serbest metin *@
                    <div class="col-md-6">
                        <label asp-for="Input.TasiyiciAdi" class="form-label">Taşıyıcı Adı <small class="text-muted">(Sistemde yoksa serbest metin)</small></label>
                        <input asp-for="Input.TasiyiciAdi" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.TasiyiciUlke" class="form-label">Taşıyıcı Ülke</label>
                        <input asp-for="Input.TasiyiciUlke" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        @* ── Güzergah & Tarihler ── *@
        <div class="card mb-3">
            <div class="card-header fw-semibold">Güzergah & Tarihler</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="Input.YuklemeyeriAdi" class="form-label">
                            Çıkış Adresi
                            <small class="text-muted ms-1">(Yükü Veren seçilince otomatik güncellenir)</small>
                        </label>
                        <textarea id="txt-cikis" asp-for="Input.YuklemeyeriAdi" rows="2" class="form-control"></textarea>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Input.VarisYeriAdi" class="form-label">
                            Varış Adresi
                            <small class="text-muted ms-1">(Yükü Alan seçilince otomatik güncellenir)</small>
                        </label>
                        <textarea id="txt-varis" asp-for="Input.VarisYeriAdi" rows="2" class="form-control"></textarea>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.YuklemeTarihi" class="form-label">Yükleme Tarihi</label>
                        <input asp-for="Input.YuklemeTarihi" type="date" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.TeslimTarihi" class="form-label">Planlanan Teslim</label>
                        <input asp-for="Input.TeslimTarihi" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.GercekTeslimTarihi" class="form-label">Gerçek Teslim</label>
                        <input asp-for="Input.GercekTeslimTarihi" type="date" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        @* ── Yük & Evraklar ── *@
        <div class="card mb-3">
            <div class="card-header fw-semibold">Yük & Evraklar</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Input.EsyaCinsi" class="form-label">Eşya Cinsi</label>
                        <input asp-for="Input.EsyaCinsi" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.BrutKg" class="form-label">Brüt KG</label>
                        <input asp-for="Input.BrutKg" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.CbmHacim" class="form-label">Hacim (m³)</label>
                        <input asp-for="Input.CbmHacim" type="number" step="0.001" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.CmrNo" class="form-label">CMR No</label>
                        <input asp-for="Input.CmrNo" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.TransitNo" class="form-label">Transit No</label>
                        <input asp-for="Input.TransitNo" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.GumrukBeyanNo" class="form-label">Gümrük Beyan No</label>
                        <input asp-for="Input.GumrukBeyanNo" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        @* ── Notlar ── *@
        <div class="card mb-3">
            <div class="card-header fw-semibold">Notlar</div>
            <div class="card-body">
                <textarea asp-for="Input.Notlar" rows="3" class="form-control"></textarea>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-pastel-green" type="submit">Kaydet</button>
            <a asp-page="./Details" asp-route-id="@Model.Input.ForwardingID" class="btn btn-pastel-blue">İptal</a>
            <a asp-page="./Delete" asp-route-id="@Model.Input.ForwardingID" class="btn btn-pastel-red ms-auto">Sil</a>
        </div>
    </form>
</div>

@* ── Hızlı Firma Ekle Modalı ── *@
<div class="modal fade" id="hizliModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hızlı Firma Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="hizliHata" class="alert alert-danger d-none py-2 mb-3"></div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Kategori</label>
                    <select id="hizliKategori" class="form-select">
                        <option value="0">Müşteri</option>
                        <option value="1">Tedarikçi</option>
                        <option value="2">Nakliyeci</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Firma Adı *</label>
                    <input id="hizliAdi" type="text" class="form-control" placeholder="Firma adı" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ülke *</label>
                    <select id="hizliUlke" class="form-select">
                        <option value="">— Seçin —</option>
                        @foreach (var u in Model.UlkeList)
                        {
                            <option value="@u.UlkeID">@u.UlkeAdi</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Şehir *</label>
                    <select id="hizliSehir" class="form-select" disabled>
                        <option value="">Önce ülke seçin</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Adres</label>
                    <input id="hizliAdres" type="text" class="form-control" placeholder="Opsiyonel" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="hizliKaydetBtn" class="btn btn-pastel-green">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var _adresler    = @Html.Raw(Model.MusteriAdresJson);
        var _sehirApiUrl = '@Url.Page("./Edit", null, new { handler = "Sehirler", id = Model.Input.ForwardingID }, Request.Scheme)';
        var _ekleApiUrl  = '@Url.Page("./Edit", null, new { handler = "HizliMusteri", id = Model.Input.ForwardingID }, Request.Scheme)';
        var _token       = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        // Adres otomatik doldurma (sadece değer doluysa güncelle)
        document.getElementById('sel-yukuveren').addEventListener('change', function () {
            var adres = _adresler[this.value];
            if (adres !== undefined) document.getElementById('txt-cikis').value = adres;
        });
        document.getElementById('sel-yukualan').addEventListener('change', function () {
            var adres = _adresler[this.value];
            if (adres !== undefined) document.getElementById('txt-varis').value = adres;
        });

        // Modal aç
        function modalAc(kategori) {
            document.getElementById('hizliKategori').value = kategori;
            document.getElementById('hizliAdi').value = '';
            document.getElementById('hizliAdres').value = '';
            document.getElementById('hizliUlke').value = '';
            document.getElementById('hizliSehir').innerHTML = '<option value="">Önce ülke seçin</option>';
            document.getElementById('hizliSehir').disabled = true;
            document.getElementById('hizliHata').classList.add('d-none');
            new bootstrap.Modal(document.getElementById('hizliModal')).show();
        }

        // Ülke → Şehir cascade (modal)
        document.getElementById('hizliUlke').addEventListener('change', async function () {
            const ulkeId = this.value;
            const sehirSel = document.getElementById('hizliSehir');
            if (!ulkeId) { sehirSel.innerHTML = '<option value="">Önce ülke seçin</option>'; sehirSel.disabled = true; return; }
            sehirSel.disabled = true;
            sehirSel.innerHTML = '<option value="">Yükleniyor…</option>';
            try {
                const res  = await fetch(_sehirApiUrl + '&ulkeId=' + ulkeId, { headers: { Accept: 'application/json' } });
                const data = await res.json();
                sehirSel.innerHTML = '<option value="">— Seçin —</option>';
                data.forEach(s => {
                    const o = document.createElement('option');
                    o.value = s.sehirID; o.textContent = s.sehirAdi;
                    sehirSel.appendChild(o);
                });
                sehirSel.disabled = false;
            } catch { sehirSel.innerHTML = '<option value="">Hata</option>'; }
        });

        // Modal kaydet
        document.getElementById('hizliKaydetBtn').addEventListener('click', async function () {
            const btn  = this;
            const hata = document.getElementById('hizliHata');
            const adi  = document.getElementById('hizliAdi').value.trim();
            const kat  = document.getElementById('hizliKategori').value;
            const ulke = document.getElementById('hizliUlke').value;
            const seh  = document.getElementById('hizliSehir').value;
            const adr  = document.getElementById('hizliAdres').value.trim();

            if (!adi || !ulke || !seh) {
                hata.textContent = 'Ad, ülke ve şehir zorunludur.';
                hata.classList.remove('d-none'); return;
            }
            hata.classList.add('d-none');
            btn.disabled = true; btn.textContent = 'Kaydediliyor…';

            const form = new FormData();
            form.append('hizliAdi', adi);
            form.append('hizliKategori', kat);
            form.append('hizliUlkeId', ulke);
            form.append('hizliSehirId', seh);
            form.append('hizliAdres', adr);
            form.append('__RequestVerificationToken', _token);

            try {
                const res  = await fetch(_ekleApiUrl, { method: 'POST', body: form });
                const data = await res.json();
                if (!data.success) {
                    hata.textContent = data.error || 'Hata.'; hata.classList.remove('d-none'); return;
                }

                _adresler[data.musteriId] = data.adres || '';

                function ekleOption(selId, id, adi) {
                    const sel = document.getElementById(selId);
                    if (!sel) return;
                    const o = document.createElement('option');
                    o.value = id; o.textContent = adi; o.selected = true;
                    sel.appendChild(o);
                    sel.dispatchEvent(new Event('change'));
                }

                const k = parseInt(kat);
                if (k === 0 || k === 1) {
                    ekleOption('sel-yukuveren', data.musteriId, data.musteriAdi);
                    ekleOption('sel-yukualan',  data.musteriId, data.musteriAdi);
                }
                if (k === 2) ekleOption('sel-tasiyici', data.musteriId, data.musteriAdi);

                bootstrap.Modal.getInstance(document.getElementById('hizliModal')).hide();
            } catch {
                hata.textContent = 'Sunucu hatası.'; hata.classList.remove('d-none');
            } finally {
                btn.disabled = false; btn.textContent = 'Kaydet';
            }
        });
    </script>
}
