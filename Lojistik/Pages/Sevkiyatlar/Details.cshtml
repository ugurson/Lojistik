@* Pages/Sevkiyatlar/Details.cshtml *@
@page "{id:int}"
@model Lojistik.Pages.Sevkiyatlar.DetailsModel
@{
    ViewData["Title"] = "Sevkiyat Detayı";
    var x = Model.Data!;

    string DurumBadge(int d) => d switch {
        0 => "bg-secondary",
        1 => "bg-info text-dark",
        2 => "bg-primary",
        3 => "bg-success",
        _ => "bg-dark"
    };
    string DurumMetni(int d) => d switch {
        0 => "Yeni",
        1 => "Yüklendi",
        2 => "Yolda",
        3 => "Tamamlandı",
        _ => d.ToString()
    };
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Sevkiyat Detayı</h2>
        <div class="d-flex gap-2">
            <a asp-page="./Edit"   asp-route-id="@x.SevkiyatID" class="btn btn-pastel-amber btn-sm">Düzenle</a>
            <a asp-page="./Delete" asp-route-id="@x.SevkiyatID" class="btn btn-pastel-red btn-sm">Sil</a>
            <a asp-page="./Index"                                class="btn btn-pastel-blue btn-sm">← Liste</a>
            <a asp-page="/SeferSevkiyatlar/Create" asp-route-sevkiyatId="@x.SevkiyatID" class="btn btn-pastel-green btn-sm">+ Sefer'e Bağla</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Genel</div>
                <div class="card-body py-3">
                    <div class="row g-2" style="font-size:0.875rem;">
                        <div class="col-sm-4 text-muted">Kod</div>
                        <div class="col-sm-8 fw-semibold">
                            <span class="badge bg-light text-dark border fs-6">@(!string.IsNullOrWhiteSpace(x.SevkiyatKodu) ? x.SevkiyatKodu : $"SV-{x.SevkiyatID}")</span>
                        </div>
                        <div class="col-sm-4 text-muted">Sipariş</div>
                        <div class="col-sm-8">
                            <a asp-page="/Siparisler/Details" asp-route-id="@x.SiparisID">@x.SiparisID</a>
                            @if (!string.IsNullOrWhiteSpace(x.SiparisYukAciklamasi))
                            { <span class="text-muted ms-1">— @x.SiparisYukAciklamasi</span> }
                        </div>
                        <div class="col-sm-4 text-muted">Durum</div>
                        <div class="col-sm-8">
                            <span class="badge @DurumBadge(x.Durum)">@DurumMetni(x.Durum)</span>
                        </div>
                        <div class="col-sm-4 text-muted">Oluşturma</div>
                        <div class="col-sm-8">@x.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        <div class="col-sm-4 text-muted">Notlar</div>
                        <div class="col-sm-8 text-prewrap">@(string.IsNullOrWhiteSpace(x.Notlar) ? "—" : x.Notlar)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Araç & Müşteri</div>
                <div class="card-body py-3">
                    <div class="row g-2" style="font-size:0.875rem;">
                        <div class="col-sm-4 text-muted">Çekici</div>
                        <div class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(x.CekiciPlaka))
                            { <span class="badge bg-light text-dark border">@x.CekiciPlaka</span> }
                            else { <span class="text-muted">—</span> }
                        </div>
                        <div class="col-sm-4 text-muted">Dorse</div>
                        <div class="col-sm-8">@(string.IsNullOrWhiteSpace(x.DorsePlaka) ? "—" : x.DorsePlaka)</div>
                        <div class="col-sm-4 text-muted">Sürücü</div>
                        <div class="col-sm-8">@(string.IsNullOrWhiteSpace(x.SurucuAdi) ? "—" : x.SurucuAdi)</div>
                        <div class="col-sm-4 text-muted">Yükleme Müşteri</div>
                        <div class="col-sm-8">@x.YuklemeMusteri</div>
                        <div class="col-sm-4 text-muted">Boşaltma Müşteri</div>
                        <div class="col-sm-8">@x.BosaltmaMusteri</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-semibold">Adres & Tarihler</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <h6 class="text-muted small mb-1">Yükleme</h6>
                    <div>@(string.IsNullOrWhiteSpace(x.YuklemeAdres) ? "—" : x.YuklemeAdres)</div>
                    @if (!string.IsNullOrWhiteSpace(x.YuklemeNoktasi))
                    { <div class="text-muted small">@x.YuklemeNoktasi</div> }
                    <div class="mt-1">
                        <small class="text-muted">Planlanan:</small> @(x.PlanlananYuklemeTarihi?.ToString("dd.MM.yyyy") ?? "—")
                    </div>
                    <div>
                        <small class="text-muted">Gerçek:</small> @(x.YuklemeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "—")
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted small mb-1">Boşaltma</h6>
                    <div>@(string.IsNullOrWhiteSpace(x.BosaltmaAdres) ? "—" : x.BosaltmaAdres)</div>
                    @if (!string.IsNullOrWhiteSpace(x.BosaltmaNoktasi))
                    { <div class="text-muted small">@x.BosaltmaNoktasi</div> }
                    <div class="mt-1">
                        <small class="text-muted">Varış:</small> @(x.VarisTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "—")
                    </div>
                    <div>
                        <small class="text-muted">Gümrük Çıkış:</small> @(x.GumrukCikisTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "—")
                    </div>
                </div>
                <div class="col-12">
                    <span class="me-4"><small class="text-muted">CMR:</small> @(!string.IsNullOrWhiteSpace(x.CMRNo) ? x.CMRNo : "—")</span>
                    <span><small class="text-muted">MRN:</small> @(!string.IsNullOrWhiteSpace(x.MRN) ? x.MRN : "—")</span>
                </div>
            </div>
        </div>
    </div>

</div>
