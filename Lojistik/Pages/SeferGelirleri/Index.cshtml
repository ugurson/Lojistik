@page
@model Lojistik.Pages.SeferGelirleri.IndexModel
@{
    ViewData["Title"] = "Sefer Gelirleri";
    string tarihSort = Model.sort == "tarih_desc" ? "tarih_asc" : "tarih_desc";
    string tutarSort = Model.sort == "tutar_desc" ? "tutar_asc" : "tutar_desc";
    string acikSort  = Model.sort == "acik_desc"  ? "acik_asc"  : "acik_desc";
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Sefer Gelirleri</h2>
        <div class="d-flex gap-2">
            <partial name="_DownloadActions"
                     view-data='@(new ViewDataDictionary(ViewData) {
                         ["FileBase"] = "sefer_gelirleri",
                         ["TableSelector"] = ".lj-table"
                     })' />
            <a asp-page="./Create" class="btn btn-pastel-green btn-sm">+ Yeni Gelir</a>
            <button type="button" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#yardimModal"
                    title="Bu sayfa hakkında yardım">
                ❓ Yardım
            </button>
        </div>
    </div>

    @* ─── FİLTRE ──────────────────────────────────────────────────── *@
    <div class="card lj-filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-sm-5">
                    <label class="form-label">Ara</label>
                    <input name="q" value="@Model.q" class="form-control" placeholder="Açıklama, PB, sipariş, sefer..." />
                </div>
                <div class="col-sm-2">
                    <label class="form-label">Sefer ID</label>
                    <input name="seferId" value="@(Model.seferId?.ToString() ?? "")" class="form-control" placeholder="ID..." />
                </div>
                <div class="col-sm-2">
                    <label class="form-label">Sayfa</label>
                    <select name="pageSize" class="form-select" onchange="this.form.submit()">
                        @foreach (var s in new[] { 10, 20, 50, 100 })
                        {
                            <option value="@s" selected="@(Model.pageSize == s ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="sort" value="@Model.sort" />
                <div class="col-auto">
                    <button class="btn btn-primary">Ara</button>
                </div>
            </form>
        </div>
    </div>

    @* ─── Toplamlar ────────────────────────────────────────────────── *@
    @if (Model.Toplamlar?.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var t in Model.Toplamlar)
            {
                <div class="lj-ozet-kart">
                    <small>@t.ParaBirimi Toplam Gelir</small>
                    <span class="val text-success">@t.Toplam.ToString("N2")</span>
                </div>
            }
        </div>
    }

    @* ─── TABLO ───────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>
                        <a asp-page="./Index" asp-route-q="@Model.q" asp-route-seferId="@Model.seferId"
                           asp-route-sort="@tarihSort" asp-route-page="1" asp-route-pageSize="@Model.pageSize"
                           class="text-decoration-none text-reset">Tarih</a>
                    </th>
                    <th>
                        <a asp-page="./Index" asp-route-q="@Model.q" asp-route-seferId="@Model.seferId"
                           asp-route-sort="@acikSort" asp-route-page="1" asp-route-pageSize="@Model.pageSize"
                           class="text-decoration-none text-reset">Açıklama</a>
                    </th>
                    <th class="text-end">
                        <a asp-page="./Index" asp-route-q="@Model.q" asp-route-seferId="@Model.seferId"
                           asp-route-sort="@tutarSort" asp-route-page="1" asp-route-pageSize="@Model.pageSize"
                           class="text-decoration-none text-reset">Tutar</a>
                    </th>
                    <th>PB</th>
                    <th>Sefer</th>
                    <th>Sipariş</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items?.Count > 0)
                {
                    foreach (var g in Model.Items)
                    {
                        <tr>
                            <td>@g.Tarih.ToString("dd.MM.yyyy")</td>
                            <td>@g.Aciklama</td>
                            <td class="text-end net-pos">@g.Tutar.ToString("N2")</td>
                            <td>@g.ParaBirimi</td>
                            <td>
                                @if (g.SeferID > 0)
                                {
                                    <a asp-page="/Seferler/Details" asp-route-id="@g.SeferID">
                                        @(g.SeferKodu ?? ("SF-" + g.SeferID))
                                    </a>
                                }
                            </td>
                            <td>
                                @if (g.IlgiliSiparisID.HasValue)
                                {
                                    <a asp-page="/Siparisler/Details" asp-route-id="@g.IlgiliSiparisID.Value">
                                        @g.IlgiliSiparisID
                                    </a>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-page="./Details" asp-route-id="@g.SeferGelirID" class="btn btn-pastel-blue btn-sm">Detay</a>
                                    <a asp-page="./Edit"    asp-route-id="@g.SeferGelirID" class="btn btn-pastel-amber btn-sm">Düzenle</a>
                                    <a asp-page="./Delete"  asp-route-id="@g.SeferGelirID" class="btn btn-pastel-red btn-sm">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <div class="fs-4 mb-1">📭</div>
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── SAYFALAMA ───────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">
            Toplam <strong>@Model.TotalCount</strong> kayıt — Sayfa <strong>@Model.page</strong> / <strong>@Model.TotalPages</strong>
        </small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.page <= 1 ? "disabled" : null)">
                <a class="page-link" asp-page="./Index"
                   asp-route-q="@Model.q" asp-route-seferId="@Model.seferId"
                   asp-route-sort="@Model.sort" asp-route-page="@(Model.page - 1)"
                   asp-route-pageSize="@Model.pageSize">‹</a>
            </li>
            <li class="page-item @(Model.page >= Model.TotalPages ? "disabled" : null)">
                <a class="page-link" asp-page="./Index"
                   asp-route-q="@Model.q" asp-route-seferId="@Model.seferId"
                   asp-route-sort="@Model.sort" asp-route-page="@(Model.page + 1)"
                   asp-route-pageSize="@Model.pageSize">›</a>
            </li>
        </ul>
    </div>

</div>

<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Sefer Gelirleri — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa, seferlere ait gelir kayıtlarını listeler. Her gelir satırı hangi sefere ve siparişe ait olduğunu, tutarı ve cariye işlenme durumunu gösterir.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📊 Tablo Sütunları</h6>
                    <ul class="mb-0">
                        <li><strong>Tarih</strong> — Gelirin kayıt tarihi.</li>
                        <li><strong>Açıklama</strong> — Gelir kalemi açıklaması (navlun, hizmet bedeli vb.).</li>
                        <li><strong>Tutar / PB</strong> — Gelir tutarı ve para birimi.</li>
                        <li><strong>Sefer</strong> — İlgili sefer kodu (tıklayarak sefer detayına gidin).</li>
                        <li><strong>Sipariş</strong> — Bağlı sipariş numarası.</li>
                    </ul>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📈 Toplamlar</h6>
                    <p class="text-muted mb-0">Filtreye göre para birimi bazında toplam gelir kartları sayfanın üst kısmında gösterilir.</p>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ İşlemler</h6>
                    <ul class="mb-0">
                        <li><strong>+ Yeni Gelir</strong> — Sefere yeni gelir kaydı ekleyin.</li>
                        <li><strong>Detay / Düzenle / Sil</strong> — Gelir kaydı yönetimi.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
