@* Pages/SeferGelirleri/Details.cshtml *@
@page "{id:int}"
@model Lojistik.Pages.SeferGelirleri.DetailsModel
@{
    ViewData["Title"] = "Gelir Detayı";
    var x = Model.Data!;
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Gelir Detayı</h2>
        <div class="d-flex gap-2">
            <a asp-page="./Edit"   asp-route-id="@x.SeferGelirID" class="btn btn-pastel-amber btn-sm">Düzenle</a>
            <a asp-page="./Delete" asp-route-id="@x.SeferGelirID" class="btn btn-pastel-red btn-sm">Sil</a>
            <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID" class="btn btn-pastel-blue btn-sm">← Sefer</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-2" style="font-size:0.875rem;">
                <div class="col-sm-3 text-muted">Sefer</div>
                <div class="col-sm-9">
                    <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID">
                        @((x.SeferKodu ?? ("SF-" + x.SeferID))) — @x.CekiciPlaka
                    </a>
                </div>
                <div class="col-sm-3 text-muted">Tarih</div>
                <div class="col-sm-9">@x.Tarih.ToString("dd.MM.yyyy")</div>
                <div class="col-sm-3 text-muted">Açıklama</div>
                <div class="col-sm-9">@(!string.IsNullOrWhiteSpace(x.Aciklama) ? x.Aciklama : "—")</div>
                <div class="col-sm-3 text-muted">Tutar</div>
                <div class="col-sm-9 net-pos fw-semibold">@x.Tutar.ToString("N2") @x.ParaBirimi</div>
                <div class="col-sm-3 text-muted">İlgili Sipariş</div>
                <div class="col-sm-9">
                    @if (x.IlgiliSiparisID.HasValue)
                    {
                        <a asp-page="/Siparisler/Details" asp-route-id="@x.IlgiliSiparisID.Value">@x.IlgiliSiparisID</a>
                    }
                    else { <span class="text-muted">—</span> }
                </div>
                <div class="col-sm-3 text-muted">Oluşturma</div>
                <div class="col-sm-9">@x.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                <div class="col-sm-3 text-muted">Notlar</div>
                <div class="col-sm-9 text-prewrap">@x.Notlar</div>
            </div>
        </div>
    </div>

</div>
