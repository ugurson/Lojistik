@* Pages/SeferGelirleri/Delete.cshtml *@
@page "{id:int}"
@model Lojistik.Pages.SeferGelirleri.DeleteModel
@{
    ViewData["Title"] = "Gelir Sil";
    var x = Model.Data!;
}

<div class="lj-page-compact">

    <h2 class="mb-3 text-danger">Gelir Sil</h2>

    <div class="alert alert-danger">
        <strong>Bu geliri silmek istediğinize emin misiniz?</strong>
        Bu işlem geri alınamaz.
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold">Gelir Özeti</div>
        <div class="card-body">
            <div class="row g-2" style="font-size:0.875rem;">
                <div class="col-sm-3 text-muted">Sefer</div>
                <div class="col-sm-9">
                    <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID">
                        @((x.SeferKodu ?? ("SF-" + x.SeferID))) — @x.CekiciPlaka
                    </a>
                </div>
                <div class="col-sm-3 text-muted">Tarih</div>
                <div class="col-sm-9">@x.Tarih.ToString("dd.MM.yyyy")</div>
                <div class="col-sm-3 text-muted">Açıklama</div>
                <div class="col-sm-9">@(!string.IsNullOrWhiteSpace(x.Aciklama) ? x.Aciklama : "—")</div>
                <div class="col-sm-3 text-muted">Tutar</div>
                <div class="col-sm-9 net-pos fw-semibold">@x.Tutar.ToString("N2") @x.ParaBirimi</div>
                <div class="col-sm-3 text-muted">İlgili Sipariş</div>
                <div class="col-sm-9">
                    @if (x.IlgiliSiparisID.HasValue)
                    {
                        <a asp-page="/Siparisler/Details" asp-route-id="@x.IlgiliSiparisID.Value">@x.IlgiliSiparisID</a>
                    }
                    else { <span class="text-muted">—</span> }
                </div>
            </div>
        </div>
    </div>

    <form method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-pastel-red">Evet, Sil</button>
        <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID" class="btn btn-pastel-blue">Vazgeç</a>
    </form>

</div>
