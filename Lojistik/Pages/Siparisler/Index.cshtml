@page
@model Lojistik.Pages.Siparisler.IndexModel
@{
    ViewData["Title"] = "Siparişler";
}

@functions {
    string DurumMetni(byte d) => d switch
    {
        0 => "Taslak",
        1 => "Yüklendi",
        2 => "Araçta",
        3 => "Tamamlandı",
        7 => "Sonlandırıldı",
        _ => "Bilinmiyor"
    };
    string DurumBadge(byte d) => d switch
    {
        0 => "secondary",
        1 => "info",
        2 => "primary",
        3 => "success",
        7 => "danger",
        _ => "dark"
    };

    string SortIcon(string col)
    {
        bool isCurrent = string.Equals(Model.sortBy, col, StringComparison.OrdinalIgnoreCase)
                      || (string.IsNullOrEmpty(Model.sortBy) && col == "tarih");
        if (!isCurrent) return "↕";
        return string.Equals(Model.sortDir, "asc", StringComparison.OrdinalIgnoreCase) ? " ↑" : " ↓";
    }

    string NextDir(string col)
    {
        bool isCurrent = string.Equals(Model.sortBy, col, StringComparison.OrdinalIgnoreCase)
                      || (string.IsNullOrEmpty(Model.sortBy) && col == "tarih");
        if (!isCurrent) return col == "tarih" ? "asc" : "desc";
        return string.Equals(Model.sortDir, "asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
    }

    string Truncate(string? s, int max = 16)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        return s.Length > max ? s.Substring(0, max) + "…" : s;
    }
}

<div class="lj-page-compact">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Siparişler</h2>
    <div class="d-flex gap-2">
        <partial name="_DownloadActions"
                 view-data='@(new ViewDataDictionary(ViewData) {
                     ["FileBase"] = "siparisler",
                     ["TableSelector"] = ".lj-table"
                 })' />
        <a asp-page="./Create" class="btn btn-pastel-green btn-sm">+ Yeni Sipariş</a>
        <a asp-page="./Sonlanan" class="btn btn-pastel-red btn-sm">Sonlandırılan</a>
        <button type="button" class="btn btn-sm btn-outline-info"
                data-bs-toggle="modal" data-bs-target="#yardimModal"
                title="Bu sayfa hakkında yardım">
            ❓ Yardım
        </button>
    </div>
</div>

@* ── Özet kartlar ─────────────────────────────────────────────── *@
@{
    int toplam   = Model.TotalCount;
    int taslak   = Model.DurumSayilari.GetValueOrDefault((byte)0);
    int yuklendi = Model.DurumSayilari.GetValueOrDefault((byte)1);
    int aracta   = Model.DurumSayilari.GetValueOrDefault((byte)2);
    int tamam    = Model.DurumSayilari.GetValueOrDefault((byte)3);
}
<div class="d-flex flex-wrap gap-2 mb-3">
    <div class="lj-ozet-kart">
        <small>Toplam</small>
        <span class="val">@toplam</span>
    </div>
    @if (taslak > 0)
    {
        <div class="lj-ozet-kart">
            <small>Taslak</small>
            <span class="val text-secondary">@taslak</span>
        </div>
    }
    @if (yuklendi > 0)
    {
        <div class="lj-ozet-kart">
            <small>Yüklendi</small>
            <span class="val text-info">@yuklendi</span>
        </div>
    }
    @if (aracta > 0)
    {
        <div class="lj-ozet-kart" style="border-color:#0d6efd44;">
            <small>Araçta</small>
            <span class="val text-primary">@aracta</span>
        </div>
    }
    @if (tamam > 0)
    {
        <div class="lj-ozet-kart" style="border-color:#19875444;">
            <small>Tamamlandı</small>
            <span class="val text-success">@tamam</span>
        </div>
    }
</div>

@* ── Filtre formu ─────────────────────────────────────────────── *@
<div class="card mb-3 lj-filter-card">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-5">
                <label class="form-label">Ara</label>
                <input name="q" value="@Model.q" class="form-control" placeholder="Terim, müşteri, sipariş no..." />
            </div>

            <div class="col-sm-3">
                <label class="form-label">Tür</label>
                <div class="btn-group d-flex" role="group">
                    <a class="btn @(Model.siparisTur is null ? "btn-pastel-amber" : "btn-pastel-blue")"
                       asp-page="./Index" asp-route-q="@Model.q" asp-route-page="1"
                       asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy"
                       asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir"
                       asp-route-siparisTur="">Tümü</a>
                    <a class="btn @(Model.siparisTur == 1 ? "btn-pastel-amber" : "btn-pastel-blue")"
                       asp-page="./Index" asp-route-q="@Model.q" asp-route-page="1"
                       asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy"
                       asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir"
                       asp-route-siparisTur="1">Yurtdışı</a>
                    <a class="btn @(Model.siparisTur == 2 ? "btn-pastel-amber" : "btn-pastel-blue")"
                       asp-page="./Index" asp-route-q="@Model.q" asp-route-page="1"
                       asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy"
                       asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir"
                       asp-route-siparisTur="2">Yurtiçi</a>
                </div>
            </div>

            <div class="col-sm-2">
                <label class="form-label">Sayfa Boyutu</label>
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    @{ int[] sizes = new[] { 10, 20, 50, 100 };
                       foreach (var s in sizes)
                       { <option value="@s" selected="@(Model.pageSize == s)">@s</option> } }
                </select>
            </div>

            <input type="hidden" name="page"       value="1" />
            <input type="hidden" name="groupBy"    value="@Model.groupBy" />
            <input type="hidden" name="siparisTur" value="@(Model.siparisTur?.ToString())" />
            <input type="hidden" name="sortBy"     value="@Model.sortBy" />
            <input type="hidden" name="sortDir"    value="@Model.sortDir" />

            <div class="col-sm-2">
                <label class="form-label d-block">&nbsp;</label>
                <button class="btn btn-pastel-blue w-100">Ara</button>
            </div>
        </form>
    </div>
</div>

@{
    Func<string, string> SortUrl = col => Url.Page("./Index", new {
        q = Model.q, page = 1, pageSize = Model.pageSize, groupBy = Model.groupBy,
        siparisTur = Model.siparisTur?.ToString(), sortBy = col, sortDir = NextDir(col)
    })!;

    bool isTarihActive = string.IsNullOrEmpty(Model.sortBy) || Model.sortBy == "tarih";
    bool isTutarActive = Model.sortBy == "tutar";
    bool isDurumActive = Model.sortBy == "durum";

    string RowHref(int id) => Url.Page("./Details", new { id, siparisTur = Model.siparisTur?.ToString() })!;
}

@* ── Tablo ────────────────────────────────────────────────────── *@
@{
    // Ortak thead — her iki branch kullanır
    var theadHtml = "";
}

@if (Model.groupBy == "sefer")
{
    var groups = Model.Items
        .OrderByDescending(x => x.SiparisTarihi)
        .GroupBy(x => string.IsNullOrWhiteSpace(x.SeferKodu) ? "(Sefer yok)" : x.SeferKodu);

    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>Sp#</th>
                    <th class="sortable @(isTarihActive ? "active" : "")"><a href="@SortUrl("tarih")">Tarih <span class="sort-icon">@SortIcon("tarih")</span></a></th>
                    <th>Gönderen</th>
                    <th>Alıcı</th>
                    <th>Ülke</th>
                    <th>Şehir</th>
                    <th>Dorse</th>
                    <th>Sefer</th>
                    <th>Çekici</th>
                    <th>Sürücü</th>
                    <th class="sortable @(isTutarActive ? "active" : "")"><a href="@SortUrl("tutar")">Tutar <span class="sort-icon">@SortIcon("tutar")</span></a></th>
                    <th>PB</th>
                    <th class="sortable @(isDurumActive ? "active" : "")"><a href="@SortUrl("durum")">Durum <span class="sort-icon">@SortIcon("durum")</span></a></th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!groups.Any())
                {
                    <tr><td colspan="14" class="text-center text-muted py-3">Kayıt bulunamadı.</td></tr>
                }
                @foreach (var g in groups)
                {
                    <tr class="table-active">
                        <td colspan="14" class="fw-semibold py-1">
                            <small class="text-muted me-1">📁</small>@g.Key
                            <span class="badge bg-secondary ms-1" style="font-size:0.7em;">@g.Count()</span>
                        </td>
                    </tr>
                    @foreach (var r in g)
                    {
                        <tr class="rowlink tr-durum-@r.Durum" data-href="@RowHref(r.SiparisID)">
                            <td class="text-muted" style="font-size:0.8em;">@r.SiparisID</td>
                            <td>@r.SiparisTarihi.ToString("dd.MM.yyyy")</td>
                            <td><span title="@r.Gonderen">@Truncate(r.Gonderen)</span></td>
                            <td><span title="@r.Alici">@Truncate(r.Alici)</span></td>
                            <td>@r.AliciUlke</td>
                            <td>@r.AliciSehir</td>
                            <td>@(string.IsNullOrWhiteSpace(r.DorsePlaka)    ? "—" : r.DorsePlaka)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.SeferKodu)     ? "—" : r.SeferKodu)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.SeferAracPlaka)? "—" : r.SeferAracPlaka)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.SeferSurucuAdi)? "—" : r.SeferSurucuAdi)</td>
                            <td class="@(r.Tutar.HasValue ? "net-pos" : "text-muted")">@(r.Tutar?.ToString("N2") ?? "—")</td>
                            <td>@r.ParaBirimi</td>
                            <td><span class="badge bg-@DurumBadge(r.Durum)">@DurumMetni(r.Durum)</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-page="./Details" asp-route-id="@r.SiparisID" asp-route-siparisTur="@(Model.siparisTur?.ToString())" class="btn btn-pastel-blue btn-sm">Detay</a>
                                    <a asp-page="./Edit"    asp-route-id="@r.SiparisID" asp-route-siparisTur="@(Model.siparisTur?.ToString())" class="btn btn-pastel-amber btn-sm">Düzenle</a>
                                    <a asp-page="./Delete"  asp-route-id="@r.SiparisID" asp-route-siparisTur="@(Model.siparisTur?.ToString())" class="btn btn-pastel-red btn-sm">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
else
{
