@* ── Pagination ───────────────────────────────────────────────── *@
<nav class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">
        Toplam <strong>@Model.TotalCount</strong> kayıt — Sayfa <strong>@Model.page</strong> / <strong>@Model.TotalPages</strong>
    </div>
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.page <= 1 ? "disabled" : null)">
            <a class="page-link" asp-page="./Index"
               asp-route-q="@Model.q" asp-route-page="@(Model.page - 1)"
               asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy"
               asp-route-siparisTur="@(Model.siparisTur?.ToString())"
               asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir">‹</a>
        </li>
        @{
            int startPage = Math.Max(1, Model.page - 2);
            int endPage   = Math.Min(Model.TotalPages, Model.page + 2);
        }
        @if (startPage > 1)
        {
            <li class="page-item"><a class="page-link" asp-page="./Index" asp-route-q="@Model.q" asp-route-page="1" asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy" asp-route-siparisTur="@(Model.siparisTur?.ToString())" asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir">1</a></li>
            @if (startPage > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
        }
        @for (int p = startPage; p <= endPage; p++)
        {
            <li class="page-item @(p == Model.page ? "active" : "")">
                <a class="page-link" asp-page="./Index"
                   asp-route-q="@Model.q" asp-route-page="@p"
                   asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy"
                   asp-route-siparisTur="@(Model.siparisTur?.ToString())"
                   asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir">@p</a>
            </li>
        }
        @if (endPage < Model.TotalPages)
        {
            @if (endPage < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            <li class="page-item"><a class="page-link" asp-page="./Index" asp-route-q="@Model.q" asp-route-page="@Model.TotalPages" asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy" asp-route-siparisTur="@(Model.siparisTur?.ToString())" asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir">@Model.TotalPages</a></li>
        }
        <li class="page-item @(Model.page >= Model.TotalPages ? "disabled" : null)">
            <a class="page-link" asp-page="./Index"
               asp-route-q="@Model.q" asp-route-page="@(Model.page + 1)"
               asp-route-pageSize="@Model.pageSize" asp-route-groupBy="@Model.groupBy"
               asp-route-siparisTur="@(Model.siparisTur?.ToString())"
               asp-route-sortBy="@Model.sortBy" asp-route-sortDir="@Model.sortDir">›</a>
        </li>
    </ul>
</nav>


</div>@* /lj-page-compact *@

@* ══════════════════════════════════════════════════════
   YARDIM MODAL
══════════════════════════════════════════════════════ *@
<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Siparişler — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">

                @* GENEL BAKIŞ *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa firmanıza ait tüm aktif siparişleri listeler. Sonlandırılmış siparişler ayrı sayfada görüntülenir.</p>
                    <ul class="mb-0">
                        <li><strong>Özet kartlar</strong> — Sayfanın üstünde toplam, taslak, yüklendi, araçta ve tamamlandı sayıları görünür.</li>
                        <li>Satıra tıklamak ilgili siparişin detay sayfasını açar.</li>
                        <li><strong>Tarih</strong>, <strong>Tutar</strong> ve <strong>Durum</strong> sütunlarına tıklayarak sıralama yapılabilir (↑↓ ikon).</li>
                    </ul>
                </div>

                @* DURUM BADGE'LERİ *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🏷️ Sipariş Durumları</h6>
                    <table class="table table-sm table-bordered mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr><th>Durum</th><th>Anlamı</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="badge bg-secondary">Taslak</span></td><td>Sipariş oluşturulmuş, henüz işlem görmemiş.</td></tr>
                            <tr><td><span class="badge bg-info">Yüklendi</span></td><td>Yük araca yüklenmiş, sevkiyat başlamış.</td></tr>
                            <tr><td><span class="badge bg-primary">Araçta</span></td><td>Yük yolda, teslimat devam ediyor.</td></tr>
                            <tr><td><span class="badge bg-success">Tamamlandı</span></td><td>Teslimat başarıyla gerçekleşmiş.</td></tr>
                            <tr><td><span class="badge bg-danger">Sonlandırıldı</span></td><td>Sipariş kapatılmış. Sonlandırılanlar sayfasında görünür.</td></tr>
                        </tbody>
                    </table>
                </div>

                @* ÜST BAR BUTONLARI *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🖱️ Üst Bar Butonları</h6>
                    <table class="table table-sm table-bordered mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr><th>Buton</th><th>Ne Yapar?</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>+ Yeni Sipariş</td><td>Yeni bir sipariş oluşturma ekranını açar.</td></tr>
                            <tr><td>Sonlandırılan</td><td>Kapatılmış / sonlandırılmış siparişlerin listesini görüntüler.</td></tr>
                            <tr><td>📥 İndir (Excel/PDF)</td><td>Mevcut tablo görünümünü dışa aktarır.</td></tr>
                        </tbody>
                    </table>
                </div>

                @* FİLTRE *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🔍 Filtreleme</h6>
                    <ul class="mb-0">
                        <li><strong>Ara</strong> — Müşteri adı, sipariş no veya arama terimi ile filtrelenir.</li>
                        <li><strong>Tür</strong> — Tümü / Yurtdışı / Yurtiçi olarak sipariş türüne göre daraltılır.</li>
                        <li><strong>Sayfa Boyutu</strong> — Sayfada gösterilecek kayıt sayısı seçilir (10 / 20 / 50 / 100).</li>
                    </ul>
                </div>

                @* SATIR İŞLEMLERİ *@
                <div class="mb-1">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ Satır Üzerindeki İşlemler</h6>
                    <table class="table table-sm table-bordered mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr><th>İşlem</th><th>Ne Yapar?</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Detay</td><td>Siparişin tüm bilgilerini, bağlı sefer ve sevkiyat detaylarını görüntüler.</td></tr>
                            <tr><td>Düzenle</td><td>Sipariş bilgilerini (gönderen, alıcı, tutar, tarih vb.) günceller.</td></tr>
                            <tr><td>Sil</td><td>Siparişi kalıcı olarak siler. Bu işlem geri alınamaz.</td></tr>
                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('tr.rowlink').forEach(function (row) {
        row.addEventListener('click', function (e) {
            if (e.target.closest('a, button, form')) return;
            window.location = row.dataset.href;
        });
    });
</script>
