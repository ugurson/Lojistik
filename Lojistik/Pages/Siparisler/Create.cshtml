@* Pages/Siparisler/Create.cshtml *@
@page
@model Lojistik.Pages.Siparisler.CreateModel
@{
    ViewData["Title"] = "Yeni Sipariş";
    var tur = Model?.Input?.SiparisTur == 2 ? "Yurtiçi" : "Yurtdışı";
}

<style>
    .lj-card-hdr { font-size: 0.82rem; letter-spacing: .04em; text-transform: uppercase; }
    .lj-lbl      { font-size: 0.78rem; margin-bottom: 2px; color: #6c757d; }
</style>

<div class="lj-page-compact">

    @* ─── BAŞLIK ─────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Yeni Sipariş – <span id="sipTurLabel">@tur</span></h2>
        <div class="d-flex gap-2">
            <button type="submit" form="mainForm" class="btn btn-pastel-green btn-sm">Kaydet</button>
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Liste</a>
        </div>
    </div>

    <form id="mainForm" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-2 small"></div>

        @* ─── GENEL ──────────────────────────────────────────────── *@
        <div class="card mb-2">
            <div class="card-header py-1 px-3 fw-semibold lj-card-hdr">Genel</div>
            <div class="card-body py-2 px-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <div class="lj-lbl">Sipariş Türü</div>
                        <div class="btn-group btn-group-sm d-flex" role="group">
                            <input type="radio" class="btn-check" name="Input.SiparisTur" id="turYurtdisi" value="1"
                                   @(Model?.Input?.SiparisTur is 2 ? "" : "checked")>
                            <label class="btn btn-outline-primary" for="turYurtdisi">Yurtdışı</label>
                            <input type="radio" class="btn-check" name="Input.SiparisTur" id="turYurtici" value="2"
                                   @(Model?.Input?.SiparisTur is 2 ? "checked" : "")>
                            <label class="btn btn-outline-primary" for="turYurtici">Yurtiçi</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.SiparisTarihi" class="form-label lj-lbl">Sipariş Tarihi</label>
                        <input asp-for="Input.SiparisTarihi" type="date" class="form-control form-control-sm" />
                        <span asp-validation-for="Input.SiparisTarihi" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ─── TARAFLAR ───────────────────────────────────────────── *@
        <div class="card mb-2">
            <div class="card-header py-1 px-3 fw-semibold lj-card-hdr">Taraflar</div>
            <div class="card-body py-2 px-3">
                <div class="row g-2">
                    <div class="col-md-4">
                        <label asp-for="Input.GonderenMusteriID" class="form-label lj-lbl">Gönderen</label>
                        <div class="input-group input-group-sm">
                            <select asp-for="Input.GonderenMusteriID" asp-items="Model.MusterilerSelect" class="form-select form-select-sm">
                                <option value="">-- Seçiniz --</option>
                            </select>
                            <button type="button" class="btn btn-outline-success" onclick="quickMusteriAc('Input_GonderenMusteriID')" title="Yeni müşteri ekle">+</button>
                        </div>
                        <span asp-validation-for="Input.GonderenMusteriID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.AliciMusteriID" class="form-label lj-lbl">Alıcı</label>
                        <div class="input-group input-group-sm">
                            <select asp-for="Input.AliciMusteriID" asp-items="Model.MusterilerSelect" class="form-select form-select-sm">
                                <option value="">-- Seçiniz --</option>
                            </select>
                            <button type="button" class="btn btn-outline-success" onclick="quickMusteriAc('Input_AliciMusteriID')" title="Yeni müşteri ekle">+</button>
                        </div>
                        <span asp-validation-for="Input.AliciMusteriID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.AraTedarikciMusteriID" class="form-label lj-lbl">Ara Tedarikçi</label>
                        <div class="input-group input-group-sm">
                            <select asp-for="Input.AraTedarikciMusteriID" asp-items="Model.AraTedarikciSelect" class="form-select form-select-sm">
                                <option value="">(Yok)</option>
                            </select>
                            <button type="button" class="btn btn-outline-success" onclick="quickMusteriAc('Input_AraTedarikciMusteriID')" title="Yeni müşteri ekle">+</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ─── YÜK & FATURA ───────────────────────────────────────── *@
        <div class="card mb-2">
            <div class="card-header py-1 px-3 fw-semibold lj-card-hdr">Yük & Fatura</div>
            <div class="card-body py-2 px-3">
                <div class="row g-2">
                    <div class="col-md-1">
                        <label asp-for="Input.Adet" class="form-label lj-lbl">Adet</label>
                        <input asp-for="Input.Adet" class="form-control form-control-sm" />
                        <span asp-validation-for="Input.Adet" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.AdetCinsi" class="form-label lj-lbl">Adet Cinsi</label>
                        <input asp-for="Input.AdetCinsi" class="form-control form-control-sm" placeholder="Palet / Koli" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.Kilo" class="form-label lj-lbl">Kilo (kg)</label>
                        <input asp-for="Input.Kilo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.YukAciklamasi" class="form-label lj-lbl">
                            Yük Açıklaması <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.YukAciklamasi" class="form-control form-control-sm" placeholder="Hammadde / 1 parti" />
                        <span asp-validation-for="Input.YukAciklamasi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Input.Tutar" class="form-label lj-lbl">Tutar</label>
                        <input asp-for="Input.Tutar" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-1">
                        <label asp-for="Input.ParaBirimi" class="form-label lj-lbl">Döviz</label>
                        <select asp-for="Input.ParaBirimi" asp-items="Model.ParaBirimleriSelect" class="form-select form-select-sm">
                            <option value="">(Seç)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.FaturaNo" class="form-label lj-lbl">Fatura No</label>
                        <input asp-for="Input.FaturaNo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-9">
                        <label asp-for="Input.Notlar" class="form-label lj-lbl">Notlar</label>
                        <textarea asp-for="Input.Notlar" rows="2" class="form-control form-control-sm" placeholder="İsteğe bağlı..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-pastel-green btn-sm" type="submit">Kaydet</button>
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">Vazgeç</a>
        </div>
    </form>

</div>

@* ─── HIZLI MÜŞTERİ EKLE MODAL ─────────────────────────────── *@
<div class="modal fade" id="quickMusteriModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-bold mb-0">Yeni Müşteri / Firma Ekle</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="qmHata" class="alert alert-danger py-2 small d-none"></div>
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label lj-lbl">Firma / Müşteri Adı <span class="text-danger">*</span></label>
                        <input id="qmAd" type="text" class="form-control form-control-sm" placeholder="Ad giriniz..." maxlength="200" />
                    </div>
                    <div class="col-12">
                        <label class="form-label lj-lbl">Kategori</label>
                        <select id="qmKategori" class="form-select form-select-sm">
                            <option value="0">Müşteri</option>
                            <option value="1">Tedarikçi</option>
                            <option value="2">Nakliyeci</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label lj-lbl">Ülke <span class="text-danger">*</span></label>
                        <select id="qmUlke" class="form-select form-select-sm">
                            <option value="">-- Yükleniyor --</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label lj-lbl">Şehir <span class="text-danger">*</span></label>
                        <select id="qmSehir" class="form-select form-select-sm" disabled>
                            <option value="">-- Önce ülke seçin --</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="qmKaydetBtn" class="btn btn-success btn-sm" onclick="quickMusteriKaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Bugünün tarihini otomatik doldur
            var d   = new Date();
            var pad = function (n) { return String(n).padStart(2, '0'); };
            var today = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            var dateEl = document.getElementById('Input_SiparisTarihi');
            if (dateEl && !dateEl.value) dateEl.value = today;

            // Sipariş türü başlık güncelleme
            const labelEl = document.getElementById('sipTurLabel');
            const rdDisi  = document.getElementById('turYurtdisi');
            const rdIci   = document.getElementById('turYurtici');
            function refreshTitle() {
                if (rdIci && rdIci.checked) labelEl.textContent = 'Yurtiçi';
                else labelEl.textContent = 'Yurtdışı';
            }
            if (rdDisi) rdDisi.addEventListener('change', refreshTitle);
            if (rdIci)  rdIci.addEventListener('change', refreshTitle);
            refreshTitle();
        })();

    // ─── Hızlı Müşteri Ekle ─────────────────────────────────────────
    var _qmHedefSelectId = null;
    var _ulkelerYuklendi = false;

    function quickMusteriAc(hedefSelectId) {
        _qmHedefSelectId = hedefSelectId;
        document.getElementById('qmAd').value = '';
        document.getElementById('qmKategori').value = '0';
        document.getElementById('qmSehir').innerHTML = '<option value="">-- Önce ülke seçin --</option>';
        document.getElementById('qmSehir').disabled = true;
        document.getElementById('qmHata').classList.add('d-none');
        document.getElementById('qmKaydetBtn').disabled = false;
        document.getElementById('qmKaydetBtn').textContent = 'Kaydet';

        new bootstrap.Modal(document.getElementById('quickMusteriModal')).show();

        if (!_ulkelerYuklendi) {
            fetch('?handler=Ulkeler', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {
                    var sel = document.getElementById('qmUlke');
                    sel.innerHTML = '<option value="">-- Seçiniz --</option>';
                    data.forEach(u => {
                        var o = document.createElement('option');
                        o.value = u.ulkeID; o.textContent = u.ulkeAdi;
                        sel.appendChild(o);
                    });
                    _ulkelerYuklendi = true;
                });
        }
    }

    document.getElementById('qmUlke').addEventListener('change', function () {
        var ulkeId = this.value;
        var sehirSel = document.getElementById('qmSehir');
        sehirSel.disabled = true;
        if (!ulkeId) {
            sehirSel.innerHTML = '<option value="">-- Önce ülke seçin --</option>';
            return;
        }
        sehirSel.innerHTML = '<option value="">-- Yükleniyor --</option>';
        fetch('?handler=Sehirler&ulkeId=' + ulkeId, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                sehirSel.innerHTML = '<option value="">-- Seçiniz --</option>';
                data.forEach(s => {
                    var o = document.createElement('option');
                    o.value = s.sehirID; o.textContent = s.sehirAdi;
                    sehirSel.appendChild(o);
                });
                sehirSel.disabled = false;
            });
    });

    function quickMusteriKaydet() {
        var ad       = document.getElementById('qmAd').value.trim();
        var kategori = parseInt(document.getElementById('qmKategori').value);
        var ulkeId   = parseInt(document.getElementById('qmUlke').value) || 0;
        var sehirId  = parseInt(document.getElementById('qmSehir').value) || 0;
        var hataEl   = document.getElementById('qmHata');
        var btn      = document.getElementById('qmKaydetBtn');

        hataEl.classList.add('d-none');
        if (!ad)      { hataEl.textContent = 'Müşteri adı zorunludur.'; hataEl.classList.remove('d-none'); return; }
        if (!ulkeId)  { hataEl.textContent = 'Ülke seçimi zorunludur.'; hataEl.classList.remove('d-none'); return; }
        if (!sehirId) { hataEl.textContent = 'Şehir seçimi zorunludur.'; hataEl.classList.remove('d-none'); return; }

        btn.disabled = true;
        btn.textContent = 'Kaydediliyor...';

        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch('?handler=QuickMusteri', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ musteriAdi: ad, kategori: kategori, ulkeID: ulkeId, sehirID: sehirId })
        })
        .then(r => r.json())
        .then(data => {
            btn.disabled = false; btn.textContent = 'Kaydet';
            if (!data.ok) {
                hataEl.textContent = data.hata;
                hataEl.classList.remove('d-none');
                return;
            }
            // Tüm üç dropdown'a yeni seçeneği ekle (henüz yoksa)
            ['Input_GonderenMusteriID', 'Input_AliciMusteriID', 'Input_AraTedarikciMusteriID'].forEach(function(selId) {
                var s = document.getElementById(selId);
                if (!s) return;
                if (!s.querySelector('option[value="' + data.id + '"]')) {
                    var o = document.createElement('option');
                    o.value = data.id; o.textContent = data.ad;
                    s.appendChild(o);
                }
            });
            if (_qmHedefSelectId) {
                document.getElementById(_qmHedefSelectId).value = data.id;
            }
            bootstrap.Modal.getInstance(document.getElementById('quickMusteriModal')).hide();
        })
        .catch(function() {
            btn.disabled = false; btn.textContent = 'Kaydet';
            hataEl.textContent = 'Sunucu hatası. Lütfen tekrar deneyin.';
            hataEl.classList.remove('d-none');
        });
    }
    </script>
}
