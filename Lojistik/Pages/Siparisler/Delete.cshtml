@page "{id:int}"
@model Lojistik.Pages.Siparisler.DeleteModel
@{
    ViewData["Title"] = "Sipariş Sil";
    var s = Model.Data!;
    string DurumMetni(byte d) => d switch { 0 => "Taslak", 1 => "Yüklendi", 2 => "Araçta", 3 => "Tamamlandı", 7 => "Sonlandırıldı", _ => "—" };
    string DurumBadge(byte d) => d switch { 0 => "secondary", 1 => "info", 2 => "primary", 3 => "success", 7 => "danger", _ => "dark" };
}

<div class="lj-page-compact">

    <h2 class="mb-3 text-danger">Sipariş Sil</h2>

    <div class="alert alert-danger">
        <strong>Bu siparişi silmek istediğinize emin misiniz?</strong>
        Bu işlem geri alınamaz.
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold">Sipariş Özeti</div>
        <div class="card-body">
            <div class="row g-2" style="font-size:0.875rem;">
                <div class="col-sm-3 text-muted">Tarih</div>
                <div class="col-sm-9">@s.SiparisTarihi.ToString("dd.MM.yyyy")</div>
                <div class="col-sm-3 text-muted">Yük Açıklaması</div>
                <div class="col-sm-9">@s.YukAciklamasi</div>
                <div class="col-sm-3 text-muted">Gönderen</div>
                <div class="col-sm-9">@(!string.IsNullOrWhiteSpace(s.Gonderen) ? s.Gonderen : "—")</div>
                <div class="col-sm-3 text-muted">Alıcı</div>
                <div class="col-sm-9">@(!string.IsNullOrWhiteSpace(s.Alici) ? s.Alici : "—")</div>
                <div class="col-sm-3 text-muted">Tutar</div>
                <div class="col-sm-9">@((s.Tutar?.ToString("N2")) ?? "—") @(string.IsNullOrWhiteSpace(s.ParaBirimi) ? "" : s.ParaBirimi)</div>
                <div class="col-sm-3 text-muted">Durum</div>
                <div class="col-sm-9">
                    <span class="badge bg-@DurumBadge(s.Durum)">@DurumMetni(s.Durum)</span>
                </div>
            </div>
        </div>
    </div>

    <form method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-pastel-red">Evet, Sil</button>
        <a asp-page="./Details" asp-route-id="@s.SiparisID" class="btn btn-pastel-blue">Vazgeç</a>
    </form>

</div>
