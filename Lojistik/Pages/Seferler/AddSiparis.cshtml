@page
@model Lojistik.Pages.Seferler.AddSiparisModel
@{
    ViewData["Title"] = "Sefer Sipariş Ekle";
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Sipariş Ekle</h2>
        <a asp-page="./Details" asp-route-id="@Model.SeferID" class="btn btn-pastel-blue btn-sm">← Sefer Detayı</a>
    </div>

    <div class="card shadow-sm" style="max-width:480px;">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="SeferID" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Sipariş (Dorse – Alıcı – Ülke)</label>
                    <select asp-for="SiparisID" asp-items="Model.SiparislerSelect" class="form-select"></select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-pastel-green">Ekle</button>
                    <a asp-page="./Details" asp-route-id="@Model.SeferID" class="btn btn-pastel-blue">İptal</a>
                </div>
            </form>
        </div>
    </div>

</div>
