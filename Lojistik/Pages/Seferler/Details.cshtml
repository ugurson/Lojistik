                            <label class="form-label fw-semibold">Müşteri / Nakliyeci</label>
                            <select class="form-select" name="musteriId" required>
                                <option value="">Seçiniz...</option>
                                @foreach (var m in Model.MusteriOptions)
                                {
                                    <option value="@m.Value">@m.Text</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Para Birimi</label>
                                <input class="form-control bg-light" id="modalPB" readonly />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Tutar</label>
                                <input class="form-control bg-light" id="modalTutar" readonly />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Açıklama</label>
                            <input class="form-control" name="aciklama" id="modalAciklama" />
                            <div class="form-text" id="modalOtomatikText">Otomatik: Sefer No: ...</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-pastel-green">💾 Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════
   DATA YOKSA
══════════════════════════════════════════════════════ *@
@if (Model.Data == null)
{
    <div class="alert alert-warning">Sefer bulunamadı.</div>
    <a asp-page="./Index" class="btn btn-pastel-blue">← Listeye Dön</a>
}

<script>
document.addEventListener("DOMContentLoaded", function () {

    // ── Özel Tab Yönetimi ─────────────────────────────────
    var tabBtns = document.querySelectorAll('#sfTabsBar .sf-tab-btn');
    tabBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            tabBtns.forEach(function (b) { b.classList.remove('active'); });
            document.querySelectorAll('.sf-tab-pane').forEach(function (p) { p.classList.remove('active'); });
            btn.classList.add('active');
            var target = document.getElementById(btn.getAttribute('data-target'));
            if (target) target.classList.add('active');
        });
    });

    // ── Cariye İşle Modal ─────────────────────────────────
    var modalEl = document.getElementById('cariyeIsleModal');
    if (!modalEl) return;
    modalEl.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        if (!btn) return;

        var gelirId      = btn.getAttribute('data-gelir-id');
        var pb           = btn.getAttribute('data-pb');
        var tutar        = btn.getAttribute('data-tutar');
        var seferKodu    = btn.getAttribute('data-sefer-kodu');
        var cekiciPlaka  = btn.getAttribute('data-cekici-plaka');

        document.getElementById('modalGelirId').value  = gelirId || '';
        document.getElementById('modalPB').value       = pb || '';
        document.getElementById('modalTutar').value    = tutar || '';

        var aciklama = 'Sefer No: ' + (seferKodu || '');
        if (cekiciPlaka && cekiciPlaka.trim() !== '') aciklama += ' - ' + cekiciPlaka;

        document.getElementById('modalAciklama').value      = aciklama;
        document.getElementById('modalOtomatikText').textContent = 'Otomatik: ' + aciklama;
    });
});
</script>

</div>@* /lj-page-compact *@
