@page
@model Lojistik.Pages.Seferler.IndexModel
@using Lojistik.Models.Enums
@{
    ViewData["Title"] = "Seferler";

    string cikisSort    = Model.sort == "cikis_desc" ? "cikis_asc" : "cikis_desc";
    string kodSort      = Model.sort == "kod_desc"   ? "kod_asc"   : "kod_desc";
    string cikisIcon    = Model.sort == "cikis_asc"  ? "↑" : (Model.sort == "cikis_desc" ? "↓" : "↕");
    string kodIcon      = Model.sort == "kod_asc"    ? "↑" : (Model.sort == "kod_desc"   ? "↓" : "↕");
    string cikisIconCls = (Model.sort == "cikis_asc" || Model.sort == "cikis_desc") ? "" : "text-muted";
    string kodIconCls   = (Model.sort == "kod_asc"   || Model.sort == "kod_desc")   ? "" : "text-muted";

    var yetki2       = (int?)ViewData["Yetki2"] ?? 0;
    bool showClosed  = Model.ShowClosed;
    bool canEdit     = !showClosed || yetki2 == 2;
    string d1Str     = Model.d1?.ToString("yyyy-MM-dd") ?? "";
    string d2Str     = Model.d2?.ToString("yyyy-MM-dd") ?? "";

    // Özet kart yardımcıları
    int Sayi(byte d) => Model.DurumSayilari.GetValueOrDefault(d);

    string RowClass(SeferDurum d) => d switch {
        SeferDurum.Yeni       => "tr-sefer-yeni",
        SeferDurum.Planlandi  => "tr-sefer-planlandi",
        SeferDurum.Kapali     => "tr-sefer-kapali",
        SeferDurum.Tamamlandi => "tr-sefer-tamamlandi",
        SeferDurum.Iptal      => "tr-sefer-iptal",
        _                     => ""
    };
}

<div class="lj-page-compact">

@* ─── BAŞLIK + YENİ SEFER ────────────────────────────────────────── *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">
        Seferler
        @if (showClosed)
        {
            <span class="badge bg-dark ms-2 fs-6 align-middle">Kapalı</span>
        }
    </h2>
    <div class="d-flex gap-2">
        <partial name="_DownloadActions"
                 view-data='@(new ViewDataDictionary(ViewData) {
                     ["FileBase"] = "seferler",
                     ["TableSelector"] = ".lj-table"
                 })' />
        <a asp-page="./Index"
           asp-route-ShowClosed="@(showClosed ? "false" : "true")"
           class="btn btn-sm @(showClosed ? "btn-pastel-blue" : "btn-pastel-amber")">
            @(showClosed ? "⬅ Açık Seferler" : "🗄 Kapalı Seferler")
        </a>
        <a asp-page="./Create" class="btn btn-pastel-green btn-sm">
            <span class="me-1">+</span> Yeni Sefer
        </a>
        <button type="button" class="btn btn-sm btn-outline-info"
                data-bs-toggle="modal" data-bs-target="#yardimModal"
                title="Bu sayfa hakkında yardım">
            ❓ Yardım
        </button>
    </div>
</div>

@* ─── ÖZET KARTLAR ───────────────────────────────────────────────── *@
@if (Model.DurumSayilari.Any())
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <div class="lj-ozet-kart">
            <small>Toplam</small>
            <span class="val">@Model.TotalCount</span>
        </div>
        @if (!showClosed)
        {
            @if (Sayi(0) > 0)
            {
                <div class="lj-ozet-kart" style="border-left:3px solid #6c757d;">
                    <small>Yeni</small>
                    <span class="val" style="color:#6c757d;">@Sayi(0)</span>
                </div>
            }
            @if (Sayi(1) > 0)
            {
                <div class="lj-ozet-kart" style="border-left:3px solid #0dcaf0;">
                    <small>Planlandı</small>
                    <span class="val" style="color:#0dcaf0;">@Sayi(1)</span>
                </div>
            }
            @if (Sayi(3) > 0)
            {
                <div class="lj-ozet-kart" style="border-left:3px solid #198754;">
                    <small>Tamamlandı</small>
                    <span class="val" style="color:#198754;">@Sayi(3)</span>
                </div>
            }
            @if (Sayi(4) > 0)
            {
                <div class="lj-ozet-kart" style="border-left:3px solid #dc3545;">
                    <small>İptal</small>
                    <span class="val" style="color:#dc3545;">@Sayi(4)</span>
                </div>
            }
        }
        else
        {
            <div class="lj-ozet-kart" style="border-left:3px solid #6c757d;">
                <small>Kapalı</small>
                <span class="val" style="color:#6c757d;">@Sayi(2)</span>
            </div>
        }
    </div>
}

@* ─── FİLTRE KARTI ───────────────────────────────────────────────── *@
<div class="card lj-filter-card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="p"          value="1" />
            <input type="hidden" name="sort"       value="@Model.sort" />
            <input type="hidden" name="ShowClosed" value="@Model.ShowClosed.ToString().ToLower()" />

            <div class="col-sm-5 col-md-4">
                <label class="form-label">Arama</label>
                <input name="q" value="@Model.q" class="form-control"
                       placeholder="Kod, plaka, sürücü..." />
            </div>
            <div class="col-sm-3 col-md-2">
                <label class="form-label">Durum</label>
                <select name="durum" class="form-select" onchange="this.form.submit()">
                    <option value="">Hepsi</option>
                    @foreach (SeferDurum d in Enum.GetValues(typeof(SeferDurum)))
                    {
                        var val = (byte)d;
                        <option value="@val" selected="@(Model.durum == val)">@(d.ToAd())</option>
                    }
                </select>
            </div>
            <div class="col-sm-3 col-md-2">
                <label class="form-label">Başlangıç</label>
                <input type="date" name="d1" value="@(Model.d1?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-sm-3 col-md-2">
                <label class="form-label">Bitiş</label>
                <input type="date" name="d2" value="@(Model.d2?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-sm-2 col-md-1">
                <label class="form-label">Sayfa</label>
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    @foreach (var s in new[] { 10, 20, 50, 100 })
                    {
                        <option value="@s" selected="@(Model.pageSize == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-pastel-blue">Ara</button>
            </div>
        </form>
    </div>
</div>

@* ─── TABLO ──────────────────────────────────────────────────────── *@
<div class="lj-table-wrap">
    <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
        <thead>
            <tr>
                <th style="width:110px">
                    <a asp-page="./Index"
                       asp-route-q="@Model.q" asp-route-durum="@Model.durum"
                       asp-route-sort="@kodSort" asp-route-p="1"
                       asp-route-pageSize="@Model.pageSize"
                       asp-route-ShowClosed="@showClosed.ToString().ToLower()"
                       asp-route-d1="@d1Str" asp-route-d2="@d2Str"
                       class="text-decoration-none text-reset d-flex align-items-center gap-1">
                        <span>Kod</span><small class="@kodIconCls">@kodIcon</small>
                    </a>
                </th>
                <th style="width:105px">
                    <a asp-page="./Index"
                       asp-route-q="@Model.q" asp-route-durum="@Model.durum"
                       asp-route-sort="@cikisSort" asp-route-p="1"
                       asp-route-pageSize="@Model.pageSize"
                       asp-route-ShowClosed="@showClosed.ToString().ToLower()"
                       asp-route-d1="@d1Str" asp-route-d2="@d2Str"
                       class="text-decoration-none text-reset d-flex align-items-center gap-1">
                        <span>Çıkış</span><small class="@cikisIconCls">@cikisIcon</small>
                    </a>
                </th>
                <th>Çekici</th>
                <th>Sürücü</th>
                <th>Ülke</th>
                <th>Çıkış İli</th>
                <th>Varış İli</th>
                <th class="text-end" style="width:155px">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items?.Count > 0)
            {
                foreach (var r in Model.Items)
                {
                    var durumEnum  = (SeferDurum)r.Durum;
                    var durumAd    = durumEnum.ToAd();
                    var durumBadge = durumEnum.ToBadgeClass();
                    var rowCss     = RowClass(durumEnum);
                    var detayUrl   = Url.Page("./Details", new { id = r.SeferID });

                    <tr class="rowlink @rowCss" data-href="@detayUrl" title="Durum: @durumAd">
                        <td class="fw-semibold">@(r.SeferKodu ?? ("SF-" + r.SeferID))</td>
                        <td>@r.CikisTarihi?.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(r.CekiciPlaka))
                            {
                                <span class="badge bg-light text-dark border">@r.CekiciPlaka</span>
                            }
                        </td>
                        <td>@r.SurucuAdi</td>
                        <td>@r.Ulke</td>
                        <td>@(string.IsNullOrWhiteSpace(r.CikisIl) ? "—" : r.CikisIl)</td>
                        <td>@(string.IsNullOrWhiteSpace(r.VarisIl) ? "—" : r.VarisIl)</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-page="./Details" asp-route-id="@r.SeferID"
                                   class="btn btn-pastel-blue">Detay</a>
                                @if (canEdit)
                                {
                                    <a asp-page="./Edit" asp-route-id="@r.SeferID"
                                       class="btn btn-pastel-amber">Düzenle</a>
                                    <a asp-page="./Delete" asp-route-id="@r.SeferID"
                                       class="btn btn-pastel-red">Sil</a>
                                }
                                else
                                {
                                    <a class="btn btn-pastel-amber disabled" aria-disabled="true" tabindex="-1">Düzenle</a>
                                    <a class="btn btn-pastel-red  disabled" aria-disabled="true" tabindex="-1">Sil</a>
                                }
                                @if (showClosed && yetki2 == 2 && r.Durum == 2)
                                {
                                    <form method="post" asp-page-handler="Reopen"
                                          asp-route-id="@r.SeferID" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-pastel-green"
                                                title="Seferi yeniden aktifleştir">Aç</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <div class="fs-4 mb-1">📭</div>
                        Kayıt bulunamadı.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ─── SAYFALAMA ───────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mt-3">
    <small class="text-muted">
        Toplam <strong>@Model.TotalCount</strong> kayıt &mdash;
        Sayfa <strong>@Model.p</strong> / <strong>@Model.TotalPages</strong>
    </small>
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.p <= 1 ? "disabled" : null)">
            <a class="page-link" asp-page="./Index"
               asp-route-q="@Model.q" asp-route-durum="@Model.durum"
               asp-route-sort="@Model.sort" asp-route-p="@(Model.p - 1)"
               asp-route-pageSize="@Model.pageSize"
               asp-route-ShowClosed="@showClosed.ToString().ToLower()"
               asp-route-d1="@d1Str" asp-route-d2="@d2Str">‹ Önceki</a>
        </li>
        @{
            int start = Math.Max(1, Model.p - 2);
            int end   = Math.Min(Model.TotalPages, Model.p + 2);
        }
        @if (start > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-page="./Index"
                   asp-route-q="@Model.q" asp-route-durum="@Model.durum"
                   asp-route-sort="@Model.sort" asp-route-p="1"
                   asp-route-pageSize="@Model.pageSize"
                   asp-route-ShowClosed="@showClosed.ToString().ToLower()"
                   asp-route-d1="@d1Str" asp-route-d2="@d2Str">1</a>
            </li>
            @if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
        }
        @for (int pg = start; pg <= end; pg++)
        {
            <li class="page-item @(pg == Model.p ? "active" : null)">
                <a class="page-link" asp-page="./Index"
                   asp-route-q="@Model.q" asp-route-durum="@Model.durum"
                   asp-route-sort="@Model.sort" asp-route-p="@pg"
                   asp-route-pageSize="@Model.pageSize"
                   asp-route-ShowClosed="@showClosed.ToString().ToLower()"
                   asp-route-d1="@d1Str" asp-route-d2="@d2Str">@pg</a>
            </li>
        }
        @if (end < Model.TotalPages)
        {
            @if (end < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            <li class="page-item">
                <a class="page-link" asp-page="./Index"
                   asp-route-q="@Model.q" asp-route-durum="@Model.durum"
                   asp-route-sort="@Model.sort" asp-route-p="@Model.TotalPages"
                   asp-route-pageSize="@Model.pageSize"
                   asp-route-ShowClosed="@showClosed.ToString().ToLower()"
                   asp-route-d1="@d1Str" asp-route-d2="@d2Str">@Model.TotalPages</a>
            </li>
        }
        <li class="page-item @(Model.p >= Model.TotalPages ? "disabled" : null)">
            <a class="page-link" asp-page="./Index"
               asp-route-q="@Model.q" asp-route-durum="@Model.durum"
               asp-route-sort="@Model.sort" asp-route-p="@(Model.p + 1)"
               asp-route-pageSize="@Model.pageSize"
               asp-route-ShowClosed="@showClosed.ToString().ToLower()"
               asp-route-d1="@d1Str" asp-route-d2="@d2Str">Sonraki ›</a>
        </li>
    </ul>
</div>


</div>@* /lj-page-compact *@

@* ══════════════════════════════════════════════════════
   YARDIM MODAL
══════════════════════════════════════════════════════ *@
<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Seferler — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">

                @* GENEL BAKIŞ *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa firmanıza ait tüm seferleri listeler. Açık ve kapalı seferler ayrı ayrı görüntülenebilir.</p>
                    <ul class="mb-0">
                        <li><strong>Özet kartlar</strong> — Sayfanın üstünde toplam, yeni, planlandı, tamamlandı ve iptal sayıları görüntülenir.</li>
                        <li>Satıra tıklamak ilgili seferin detay sayfasını açar.</li>
                        <li>Tablo <strong>Kod</strong> ve <strong>Çıkış Tarihi</strong> sütunlarına göre sıralanabilir (↑↓ ikonlarına tıklayın).</li>
                    </ul>
                </div>

                @* DURUM RENKLERİ *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🎨 Satır Renk Anlamları</h6>
                    <table class="table table-sm table-bordered mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr><th>Renk</th><th>Durum</th><th>Anlamı</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><span style="display:inline-block;width:14px;height:14px;background:#6c757d;border-radius:2px;"></span></td><td><strong>Gri sol çizgi</strong></td><td>Yeni — henüz başlamamış sefer.</td></tr>
                            <tr><td><span style="display:inline-block;width:14px;height:14px;background:#0dcaf0;border-radius:2px;"></span></td><td><strong>Mavi sol çizgi</strong></td><td>Planlandı — yola çıkış planlanmış.</td></tr>
                            <tr><td><span style="display:inline-block;width:14px;height:14px;background:#198754;border-radius:2px;"></span></td><td><strong>Yeşil sol çizgi</strong></td><td>Tamamlandı — sefer başarıyla tamamlanmış.</td></tr>
                            <tr><td><span style="display:inline-block;width:14px;height:14px;background:#dc3545;border-radius:2px;"></span></td><td><strong>Kırmızı sol çizgi</strong></td><td>İptal — sefer iptal edilmiş.</td></tr>
                            <tr><td><span style="display:inline-block;width:14px;height:14px;background:#495057;border-radius:2px;"></span></td><td><strong>Koyu sol çizgi</strong></td><td>Kapalı — sefer kapatılmış, değişiklik yapılamaz.</td></tr>
                        </tbody>
                    </table>
                </div>

                @* ÜST BAR BUTONLARI *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🖱️ Üst Bar Butonları</h6>
                    <table class="table table-sm table-bordered mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr><th>Buton</th><th>Ne Yapar?</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>+ Yeni Sefer</td><td>Yeni bir sefer kaydı oluşturma ekranını açar.</td></tr>
                            <tr><td>🗄 Kapalı Seferler</td><td>Kapatılmış seferleri listeler. Düzenleme ve silme yetkiye bağlıdır.</td></tr>
                            <tr><td>⬅ Açık Seferler</td><td>Aktif (açık) seferlere geri döner.</td></tr>
                            <tr><td>📥 İndir (Excel/PDF)</td><td>Mevcut tablo görünümünü dışa aktarır.</td></tr>
                        </tbody>
                    </table>
                </div>

                @* SATIR İŞLEMLERİ *@
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ Satır Üzerindeki İşlemler</h6>
                    <table class="table table-sm table-bordered mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr><th>İşlem</th><th>Ne Yapar?</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Detay</td><td>Seferin sipariş, gelir ve masraf detaylarını görüntüler.</td></tr>
                            <tr><td>Düzenle</td><td>Sefer bilgilerini (araç, sürücü, tarih vb.) günceller.</td></tr>
                            <tr><td>Sil</td><td>Seferi kalıcı olarak siler. Bu işlem geri alınamaz.</td></tr>
                            <tr><td>Aç</td><td>Kapalı seferlerde görünür; seferi yeniden aktif hale getirir. <em>(Yalnızca yetkili kullanıcılar)</em></td></tr>
                        </tbody>
                    </table>
                </div>

                @* FİLTRE *@
                <div class="mb-1">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🔍 Filtreleme</h6>
                    <ul class="mb-0">
                        <li><strong>Arama</strong> — Sefer kodu, çekici plakası veya sürücü adına göre arama yapılır.</li>
                        <li><strong>Durum</strong> — Açılır listeden seçilen duruma göre seferler filtrelenir.</li>
                        <li><strong>Başlangıç / Bitiş</strong> — Belirli bir tarih aralığındaki seferler listelenir.</li>
                        <li><strong>Sayfa boyutu</strong> — Sayfada gösterilecek kayıt sayısı seçilir (10 / 20 / 50 / 100).</li>
                    </ul>
                </div>

            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('tr.rowlink').forEach(function (row) {
        row.addEventListener('click', function (e) {
            if (e.target.closest('a, button, form')) return;
            window.location = row.dataset.href;
        });
    });
</script>
