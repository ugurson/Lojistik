@page "{id:int}"
@model Lojistik.Pages.Soforler.DeleteModel
@{
    ViewData["Title"] = "Şoför Sil";
    var s = Model.Data;
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0 text-danger">Şoför Sil</h2>
        <a class="btn btn-pastel-blue btn-sm" asp-page="Details" asp-route-id="@s.SoforID">← Detay</a>
    </div>

    <div class="alert alert-danger py-2 mb-3">
        Bu kaydı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
    </div>

    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-3">
                <div class="col-6 col-md-4">
                    <div class="text-muted small">Ad Soyad</div>
                    <div class="fw-semibold">@s.AdSoyad</div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Durum</div>
                    <div>
                        @if (s.Durum == 1)
                        { <span class="badge bg-success bg-opacity-75">Aktif</span> }
                        else
                        { <span class="badge bg-secondary">Pasif</span> }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Telefon</div>
                    <div>@s.Telefon</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Ehliyet No</div>
                    <div>@s.EhliyetNo</div>
                </div>
            </div>
        </div>
    </div>

    <form method="post">
        <div class="d-flex gap-2">
            <button class="btn btn-pastel-red">Evet, Sil</button>
            <a class="btn btn-pastel-blue" asp-page="Details" asp-route-id="@s.SoforID">İptal</a>
        </div>
    </form>

</div>
