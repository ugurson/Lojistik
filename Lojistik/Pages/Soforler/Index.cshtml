@page
@model Lojistik.Pages.Soforler.IndexModel
@{
    ViewData["Title"] = "Şoförler";

    string TarihBadge(DateTime? dt)
    {
        if (dt == null) return "";
        var days = (dt.Value.Date - DateTime.Today).TotalDays;
        if (days < 0)   return "badge bg-danger";
        if (days <= 30) return "badge bg-warning text-dark";
        return "badge bg-success bg-opacity-75";
    }
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Şoförler</h2>
        <div class="d-flex gap-2">
            <partial name="_DownloadActions"
                     view-data='@(new ViewDataDictionary(ViewData) {
                         ["FileBase"] = "soforler",
                         ["TableSelector"] = ".lj-table"
                     })' />
            <a class="btn btn-pastel-green btn-sm" asp-page="Create">+ Yeni Şoför</a>
            <button type="button" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#yardimModal"
                    title="Bu sayfa hakkında yardım">
                ❓ Yardım
            </button>
        </div>
    </div>

    @* ─── FİLTRE KARTI ──────────────────────────────────────────── *@
    <div class="card lj-filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="sort" value="@Model.sort" />
                <div class="col-sm-6 col-md-5">
                    <label class="form-label">Arama</label>
                    <input name="q" value="@Model.q" class="form-control" placeholder="Ad, TCKN, telefon, kart no..." />
                </div>
                <div class="col-sm-4 col-md-2">
                    <label class="form-label">Durum</label>
                    <select name="durum" class="form-select" onchange="this.form.submit()">
                        <option value="">Tümü</option>
                        <option value="Aktif" selected="@(Model.durum == "Aktif")">Aktif</option>
                        <option value="Pasif" selected="@(Model.durum == "Pasif")">Pasif</option>
                    </select>
                </div>
                <div class="col-auto d-flex gap-1">
                    <button class="btn btn-pastel-blue" type="submit">Ara</button>
                    <a class="btn btn-pastel-blue" asp-page="./Index">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    @* ─── ÖZET BAR ───────────────────────────────────────────────── *@
    <div class="mb-2">
        <small class="text-muted">Toplam <strong>@Model.Items.Count</strong> şoför</small>
    </div>

    @* ─── TABLO ─────────────────────────────────────────────────── *@
    <div class="lj-table-wrap">
        <table class="table table-sm table-hover align-middle mb-0 lj-table lj-table-compact">
            <thead>
                <tr>
                    <th>
                        <a asp-page="./Index" asp-route-q="@Model.q" asp-route-durum="@Model.durum" asp-route-sort="ad"
                           class="text-decoration-none text-reset">
                            Ad Soyad @(Model.sort == "ad" ? "↑" : "↕")
                        </a>
                    </th>
                    <th>Telefon</th>
                    <th>Ehliyet Sınıfı</th>
                    <th>Takograf Kart</th>
                    <th>Geçerlilikler</th>
                    <th>
                        <a asp-page="./Index" asp-route-q="@Model.q" asp-route-durum="@Model.durum" asp-route-sort="durum"
                           class="text-decoration-none text-reset">
                            Durum @(Model.sort == "durum" ? "↑" : "↕")
                        </a>
                    </th>
                    <th class="text-end" style="width:160px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">
                        <div class="fs-4 mb-1">📭</div>Kayıt bulunamadı.
                    </td></tr>
                }
                @foreach (var r in Model.Items)
                {
                    var detayUrl = Url.Page("./Details", new { id = r.SoforID });
                    <tr class="rowlink" data-href="@detayUrl">
                        <td class="fw-semibold">@r.AdSoyad</td>
                        <td>@r.Telefon</td>
                        <td>@r.EhliyetSinifi</td>
                        <td>@r.SurucuKartNo</td>
                        <td>
                            @if (r.PasaportBitisTarihi.HasValue)
                            {
                                <span class="@TarihBadge(r.PasaportBitisTarihi) me-1"
                                      title="Pasaport">P: @r.PasaportBitisTarihi.Value.ToString("dd.MM.yy")</span>
                            }
                            @if (r.VizeBitisTarihi.HasValue)
                            {
                                <span class="@TarihBadge(r.VizeBitisTarihi)"
                                      title="Vize">V: @r.VizeBitisTarihi.Value.ToString("dd.MM.yy")</span>
                            }
                        </td>
                        <td>
                            @if (r.Durum == 1)
                            { <span class="badge bg-success bg-opacity-75">Aktif</span> }
                            else
                            { <span class="badge bg-secondary">Pasif</span> }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-pastel-blue"  asp-page="Details" asp-route-id="@r.SoforID">Detay</a>
                                <a class="btn btn-pastel-amber" asp-page="Edit"    asp-route-id="@r.SoforID">Düzenle</a>
                                <a class="btn btn-pastel-red"   asp-page="Delete"  asp-route-id="@r.SoforID">Sil</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Şoförler — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa, firmaya bağlı tüm şoförleri listeler. Şoför bilgilerini görüntüleyebilir, düzenleyebilir ve belge geçerlilik tarihlerini takip edebilirsiniz.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📊 Tablo Sütunları</h6>
                    <ul class="mb-0">
                        <li><strong>Ad Soyad</strong> — Şoförün tam adı.</li>
                        <li><strong>Telefon</strong> — İletişim numarası.</li>
                        <li><strong>Ehliyet Sınıfı</strong> — Sürücü belgesi sınıfı (CE, D vb.).</li>
                        <li><strong>Takograf Kart</strong> — Dijital takograf kart numarası.</li>
                        <li><strong>Geçerlilikler</strong> — Pasaport (P) ve Vize (V) son kullanma tarihleri. Renk kodu: 🟢 Geçerli · 🟡 30 gün içinde bitiyor · 🔴 Süresi dolmuş.</li>
                        <li><strong>Durum</strong> — Aktif veya Pasif.</li>
                    </ul>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ İşlemler</h6>
                    <ul class="mb-0">
                        <li><strong>Detay</strong> — Şoförün tüm bilgilerini görüntüleyin.</li>
                        <li><strong>Düzenle</strong> — Şoför bilgilerini güncelleyin.</li>
                        <li><strong>Sil</strong> — Şoförü sistemden kaldırın.</li>
                        <li><strong>+ Yeni Şoför</strong> — Sisteme yeni şoför ekleyin.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    document.querySelectorAll('tr.rowlink').forEach(function (row) {
        row.addEventListener('click', function (e) {
            if (e.target.closest('a, button, form')) return;
            window.location = row.dataset.href;
        });
    });
</script>
