@page
@model Lojistik.Pages.Cari.EkstreModel
@{
    ViewData["Title"] = "Cari Ekstre";
    var yetki2 = (int?)ViewData["Yetki2"] ?? 0;
}
<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Cari Ekstre — @Model.MusteriAdi</h2>
        <div class="d-flex gap-2">
            <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Cari Özeti</a>
            <button type="button" class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal" data-bs-target="#yardimModal"
                    title="Bu sayfa hakkında yardım">
                ❓ Yardım
            </button>
        </div>
    </div>


    @{
        var kapanis2Class = Model.KapanisBakiye >= 0 ? "bky-pos" : "bky-neg";
        var kapanisCardBorder = Model.KapanisBakiye >= 0
            ? "border: 1px solid #198754 !important; background:rgba(25,135,84,0.07)!important;"
            : "border: 1px solid #dc3545 !important; background:rgba(220,53,69,0.07)!important;";
    }
    <div class="d-flex align-items-center gap-2 mb-3 lj-filter-card flex-wrap">
        <div class="lj-ozet-kart me-2" style="@kapanisCardBorder">
            <small>Net Bakiye</small>
            <span class="val @kapanis2Class">@Model.KapanisBakiye.ToString("N2") <span style="font-size:0.8em;font-weight:400;">@Model.pb</span></span>
        </div>
        <a asp-page-handler="ExportExcel"
           asp-route-musteriId="@Model.musteriId"
           asp-route-pb="@Model.pb"
           asp-route-d1="@(Model.d1?.ToString("yyyy-MM-dd"))"
           asp-route-d2="@(Model.d2?.ToString("yyyy-MM-dd"))"
           asp-route-showClosed="@(Model.showClosed ? "true" : "false")"
           class="btn" style="background:#f5f5f0;border:1px solid #ccc;color:#333;">
            Excel (CSV)
        </a>

        <a asp-page-handler="ExportPdf"
           asp-route-musteriId="@Model.musteriId"
           asp-route-pb="@Model.pb"
           asp-route-d1="@(Model.d1?.ToString("yyyy-MM-dd"))"
           asp-route-d2="@(Model.d2?.ToString("yyyy-MM-dd"))"
           asp-route-showClosed="@(Model.showClosed ? "true" : "false")"
           class="btn" style="background:#f5f5f0;border:1px solid #ccc;color:#333;">
            PDF
        </a>

@{
    var toggleText = Model.onlyBorclar ? "Hepsi" : "Sadece Borçlar";
    var toggleClass = Model.onlyBorclar
        ? "btn btn-pastel-amber"
        : "btn btn-pastel-green";


}
<button type="button" class="btn btn-pastel-blue"
        data-bs-toggle="modal" data-bs-target="#arsivModal">
    📦 Arşiv
    @if (Model.ArsivGroups.Any())
    {
        <span class="badge bg-secondary ms-1">@Model.ArsivGroups.Count</span>
    }
</button>

@{
    int odenmemisCount = Model.OdenmemisFaturalar.Count;
    var odenmemisBtnClass = odenmemisCount > 0 ? "btn btn-pastel-red" : "btn btn-pastel-blue";
}
<button type="button"
        class="btn btn-pastel-green"
        data-bs-toggle="modal"
        data-bs-target="#tahsilatModal">
    Tahsilat Yap
</button>

<button type="button"
        class="@odenmemisBtnClass"
        data-bs-toggle="modal"
        data-bs-target="#odenmemisModal">
    🔴 Ödenmemiş Faturalar
    @if (odenmemisCount > 0)
    {
        <span class="badge bg-white text-danger ms-1">@odenmemisCount</span>
    }
</button>

<div class="ms-auto d-flex gap-2">
    @if (yetki2 == 2)
    {
        <a asp-page="./DevirAl"
           asp-route-musteriId="@Model.musteriId"
           asp-route-pb="@Model.pb"
           class="btn btn-pastel-amber"
           onclick="return confirm('Devir Al işlemi seçilen tarihe kadar tüm hareketleri arşivler. Devam etmek istiyor musunuz?');">
            Devir Al
        </a>
    }
</div>

</div>

<div class="lj-table-wrap">
    <table class="table table-sm table-hover align-middle lj-table">
        <thead>
            <tr>
                <th style="width:105px;">Tarih</th>
                <th style="width:120px;">İşlem</th>
                <th style="width:130px;">Evrak No</th>
                <th>Açıklama</th>
                <th class="text-end" style="width:110px;">Borç (@Model.pb)</th>
                <th class="text-end" style="width:110px;">Alacak (@Model.pb)</th>
                <th class="text-end" style="width:115px;">Bakiye (@Model.pb)</th>
                <th style="width:80px;" class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted">Seçili aralıkta hareket yok.</td></tr>
            }
            else
            {
                foreach (var r in Model.Items)
                {
                        var siparisTahsilatli =
                            r.IslemTuru == "Sipariş"
                            && !string.IsNullOrWhiteSpace(r.EvrakNo)
                            && Model.TahsilatEvrakSet.Contains(r.EvrakNo.Trim().ToUpperInvariant());

                        var manuelTahsilatli =
                            r.IslemTuru == "Manuel"
                            && !string.IsNullOrWhiteSpace(r.EvrakNo)
                            && Model.TahsilatEvrakSet.Contains(r.EvrakNo.Trim().ToUpperInvariant());

                        var isDevirBakiye = r.IslemTuru == "DevirBakiye";
                        var isTahsilatSatir = r.IslemTuru == "Tahsilat" && r.Alacak > 0;
                        var isBorcSatir = !isDevirBakiye && !isTahsilatSatir
                            && !(siparisTahsilatli || manuelTahsilatli)
                            && r.Borc > 0;

                        var rowCss = isDevirBakiye          ? "tr-devir"
                                   : (siparisTahsilatli || manuelTahsilatli) ? "tr-kapali"
                                   : isTahsilatSatir        ? "tr-tahsilat"
                                   : isBorcSatir            ? "tr-borc"
                                   : "";

                        var bkyClass = r.Bakiye > 0 ? "bky-pos" : r.Bakiye < 0 ? "bky-neg" : "bky-zero";

                        <tr class="@rowCss">
                        <td>@r.Tarih.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (isDevirBakiye)
                            {
                                <span class="badge bg-primary bg-opacity-75" style="font-size:0.78em;">📦 Devir Bakiyesi</span>
                            }
                            else if (isTahsilatSatir)
                            {
                                <span class="text-success fw-semibold">✔ @r.IslemTuru</span>
                            }
                            else
                            {
                                @r.IslemTuru
                            }
                        </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.EvrakNo))
                                {
                                    <span>@r.EvrakNo</span>
                                    @if (r.Tahsilatlar?.Any() == true)
                                    {
                                        <button type="button" class="btn btn-link btn-sm ms-1 p-0"
                                                data-bs-toggle="modal" data-bs-target="#evrakModal-@r.CariHareketID">
                                            Detay
                                        </button>
                                    }
                                    @if (r.Kapandi && r.KapanisTarihi.HasValue)
                                    {
                                        <span class="badge bg-success ms-1">Kapandı: @r.KapanisTarihi.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    @if (siparisTahsilatli || manuelTahsilatli)
                                    {
                                        <span class="badge bg-success bg-opacity-75 ms-1" style="font-size:0.72em;">✔ Tahsil</span>
                                    }
                                }
                            </td>
                        <td>@r.Aciklama</td>
                        <td class="text-end @(r.Borc > 0 ? "text-danger" : "text-muted")">
                            @(r.Borc > 0 ? r.Borc.ToString("N2") : "–")
                            @if (r.Borc > 0 && Model.pb != "TL" && r.Kur > 0)
                            {
                                <div style="font-size:0.7rem;color:#888;" title="Kur: @r.Kur?.ToString("N4")">≈ @((r.Borc * r.Kur!.Value).ToString("N0")) TL</div>
                            }
                        </td>
                        <td class="text-end @(r.Alacak > 0 ? "text-success" : "text-muted")">
                            @(r.Alacak > 0 ? r.Alacak.ToString("N2") : "–")
                            @if (r.Alacak > 0 && Model.pb != "TL" && r.Kur > 0)
                            {
                                <div style="font-size:0.7rem;color:#888;" title="Kur: @r.Kur?.ToString("N4")">≈ @((r.Alacak * r.Kur!.Value).ToString("N0")) TL</div>
                            }
                        </td>
                        <td class="text-end @bkyClass">@r.Bakiye.ToString("N2")</td>
                            @* İptal butonu: sadece Tahsilat satırlarında *@
                            <td class="text-end">
                                @* Tahsilat butonu: sadece Sipariş + Alacak>0 + tahsil edilmemiş *@
                                @if (r.IslemTuru == "Sipariş" && r.Borc > 0 && !siparisTahsilatli)
                                {
                                    if (yetki2 == 2)
                                    {
                                        <form method="post" asp-page-handler="TahsilEt"
                                              class="d-inline me-1"
                                              onsubmit="return confirm('Bu siparişi otomatik tahsil edeyim mi?');">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@r.CariHareketID" />
                                            <input type="hidden" name="musteriId" value="@Model.musteriId" />
                                            <input type="hidden" name="pb" value="@Model.pb" />
                                            <input type="hidden" name="d1" value="@(Model.d1?.ToString("yyyy-MM-dd"))" />
                                            <input type="hidden" name="d2" value="@(Model.d2?.ToString("yyyy-MM-dd"))" />

                                            <button class="btn btn-pastel-green btn-sm">Tahsil</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-pastel-green btn-sm me-1" disabled>Tahsilat</button>
                                    }
                                }

                                @if (r.IptalEdilebilir)
                                {
                                    if (yetki2 == 2)
                                    {
                                        <form method="post" asp-page-handler="Iptal"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu tahsilatı silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.CariHareketID" />
                                            <input type="hidden" name="musteriId" value="@Model.musteriId" />
                                            <input type="hidden" name="pb" value="@Model.pb" />
                                            <input type="hidden" name="d1" value="@(Model.d1?.ToString("yyyy-MM-dd"))" />
                                            <input type="hidden" name="d2" value="@(Model.d2?.ToString("yyyy-MM-dd"))" />
                                            <button class="btn btn-pastel-red btn-sm">Sil</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-danger btn-sm" disabled>Sil</button>
                                    }
                                }
                            </td>

                        
                    </tr>
                }
            }
        </tbody>

        <tfoot>
            <tr class="table-light fw-semibold">
                <td colspan="4" class="text-end">Dönem Toplamı</td>
                <td class="text-end text-danger">@Model.ToplamBorc.ToString("N2")</td>
                <td class="text-end text-success">@Model.ToplamAlacak.ToString("N2")</td>
                <td class="text-end @kapanis2Class">@Model.KapanisBakiye.ToString("N2")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>
    @foreach (var r in Model.Items.Where(x => !string.IsNullOrWhiteSpace(x.EvrakNo) && x.Tahsilatlar?.Any() == true))
    {
        <div class="modal fade" id="evrakModal-@r.CariHareketID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Evrak Detayı – @r.EvrakNo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <span class="badge bg-secondary me-2">Belge: @r.Alacak.ToString("N2") @Model.pb</span>
                            <span class="badge bg-info me-2">Tahsilat Toplamı: @r.Borc.ToString("N2")</span>
                            @if (r.Kapandi && r.KapanisTarihi.HasValue)
                            {
                                <span class="badge bg-success">Kapanış: @r.KapanisTarihi.Value.ToString("dd.MM.yyyy")</span>
                            }
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:110px;">Tarih</th>
                                        <th>Tutar (@Model.pb)</th>
                                        <th>Kaynak</th>
                                        <th>Açıklama</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        decimal cum = 0m;
                                        foreach (var p in r.Tahsilatlar!)
                                        {
                                            cum += p.Tutar;
                                            bool kapanisAnimi = r.KapanisTarihi.HasValue && p.Tarih.Date == r.KapanisTarihi.Value.Date && cum >= r.Alacak;
                                        }
                                    }
                                    @foreach (var p in r.Tahsilatlar!)
                                    {
                                        cum += 0; // yukarıda hesaplandı; burada sadece satır yazıyoruz
                                                  <tr>
                                                      <td>@p.Tarih.ToString("dd.MM.yyyy")</td>
                                                      <td class="text-end">@p.Tutar.ToString("N2")</td>
                                                      <td>@p.Kaynak</td>
                                                      <td>@p.Aciklama</td>
                                                  </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    }

@* ── Ödenmemiş Faturalar Modal ───────────────────────────────────────── *@
<div class="modal fade" id="odenmemisModal" tabindex="-1" aria-labelledby="odenmemisModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="odenmemisModalLabel">
                    🔴 Ödenmemiş / Kısmi Ödenmiş Faturalar
                    <span class="badge bg-white text-danger ms-2">@Model.OdenmemisFaturalar.Count</span>
                    <small class="fw-normal ms-2" style="font-size:0.78rem; opacity:.85;">Aktif + Arşiv</small>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                @if (!Model.OdenmemisFaturalar.Any())
                {
                    <div class="alert alert-success m-3">✔ Bu para biriminde tüm faturalar ödenmiş.</div>
                }
                else
                {
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.875rem;">
                        <thead class="table-light" style="position:sticky;top:0;z-index:1;">
                            <tr>
                                <th style="width:100px;">Tarih</th>
                                <th style="width:95px;">İşlem</th>
                                <th style="width:135px;">Evrak No</th>
                                <th>Açıklama</th>
                                <th class="text-end" style="width:105px;">Tutar (@Model.pb)</th>
                                <th class="text-end" style="width:100px;">Ödenen</th>
                                <th class="text-end" style="width:100px;">Kalan</th>
                                <th style="width:75px;" class="text-center">Durum</th>
                                @if ((int?)ViewData["Yetki2"] == 2)
                                {
                                    <th style="width:100px;"></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.OdenmemisFaturalar.OrderBy(x => x.Tarih))
                            {
                                var kismi   = f.OdenenTutar > 0;
                                var rowStyle = f.IsArsiv ? "opacity:0.6; font-style:italic;" : "";
                                <tr style="@rowStyle">
                                    <td>@f.Tarih.ToString("dd.MM.yyyy")</td>
                                    <td>@f.IslemTuru</td>
                                    <td>
                                        @f.EvrakNo
                                        @if (f.IsArsiv)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size:0.65em;">ARŞİV</span>
                                        }
                                    </td>
                                    <td class="text-truncate" style="max-width:200px;" title="@f.Aciklama">@f.Aciklama</td>
                                    <td class="text-end">@f.Tutar.ToString("N2")</td>
                                    <td class="text-end @(f.OdenenTutar > 0 ? "text-success" : "text-muted")">
                                        @(f.OdenenTutar > 0 ? f.OdenenTutar.ToString("N2") : "–")
                                    </td>
                                    <td class="text-end fw-semibold text-danger">@f.KalanTutar.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (kismi)
                                        {
                                            <span class="badge bg-warning text-dark">Kısmi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Açık</span>
                                        }
                                    </td>
                                    @if ((int?)ViewData["Yetki2"] == 2)
                                    {
                                        <td class="text-center">
                                            <form method="post" asp-page-handler="Odendiyap"
                                                  onsubmit="return confirm('@f.EvrakNo — @f.KalanTutar.ToString("N2") @Model.pb tahsil edilsin mi?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id"        value="@f.CariHareketID" />
                                                <input type="hidden" name="musteriId" value="@Model.musteriId" />
                                                <input type="hidden" name="pb"        value="@Model.pb" />
                                                <input type="hidden" name="d1"        value="@(Model.d1?.ToString("yyyy-MM-dd"))" />
                                                <input type="hidden" name="d2"        value="@(Model.d2?.ToString("yyyy-MM-dd"))" />
                                                <button class="btn btn-pastel-green btn-sm">✔ Ödendi</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light fw-semibold">
                                <td colspan="4" class="text-end">Toplam</td>
                                <td class="text-end">@Model.OdenmemisFaturalar.Sum(x => x.Tutar).ToString("N2")</td>
                                <td class="text-end text-success">@Model.OdenmemisFaturalar.Sum(x => x.OdenenTutar).ToString("N2")</td>
                                <td class="text-end text-danger">@Model.OdenmemisFaturalar.Sum(x => x.KalanTutar).ToString("N2")</td>
                                <td colspan="@((int?)ViewData["Yetki2"] == 2 ? 2 : 1)"></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@* ── Arşiv Modal ─────────────────────────────────────────────────── *@
<div class="modal fade" id="arsivModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f8f9fa;">
                <h5 class="modal-title fw-bold">📦 Arşivlenmiş Hareketler — @Model.MusteriAdi <span class="badge bg-secondary ms-1">@Model.pb</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                @if (!Model.ArsivGroups.Any())
                {
                    <div class="alert alert-secondary m-3">Bu müşteri için arşivlenmiş hareket bulunamadı.</div>
                }
                else
                {
                    var _maxDevirNo = Model.ArsivGroups.Where(g => g.DevirNo.HasValue).Select(g => g.DevirNo).Max();

                    @* Liste görünümü *@
                    <div id="arsiv-list">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light" style="position:sticky;top:0;z-index:1;">
                                <tr>
                                    <th>Devir</th>
                                    <th>Kapanış Tarihi</th>
                                    <th class="text-end">Kayıt Sayısı</th>
                                    <th class="text-end">Borç Toplamı</th>
                                    <th class="text-end">Alacak Toplamı</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grp in Model.ArsivGroups.OrderBy(g => g.DevirNo))
                                {
                                    var isSon = grp.DevirNo.HasValue && grp.DevirNo == _maxDevirNo;
                                    <tr>
                                        <td class="fw-semibold">
                                            Devir @(grp.DevirNo?.ToString() ?? "—")
                                            @if (isSon) { <span class="badge bg-primary ms-1" style="font-size:0.7em;">Son</span> }
                                        </td>
                                        <td>@(grp.KapanmaTarihi.HasValue ? grp.KapanmaTarihi.Value.ToString("dd.MM.yyyy") : "—")</td>
                                        <td class="text-end">@grp.KayitSayisi</td>
                                        <td class="text-end text-success">@grp.Rows.Sum(x => x.Borc).ToString("N2")</td>
                                        <td class="text-end text-danger">@grp.Rows.Sum(x => x.Alacak).ToString("N2")</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-pastel-blue btn-sm"
                                                    onclick="arsivDetayGoster(@(grp.DevirNo ?? 0))">
                                                Detay
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @* Detay görünümleri (her devir için) *@
                    @foreach (var grp in Model.ArsivGroups.OrderBy(g => g.DevirNo))
                    {
                        var isSon = grp.DevirNo.HasValue && grp.DevirNo == _maxDevirNo;
                        <div id="arsiv-detay-@(grp.DevirNo ?? 0)" style="display:none;">
                            <div class="d-flex align-items-center gap-2 p-3 border-bottom flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="arsivListeyeDon()">
                                    ← Listeye Dön
                                </button>
                                <span class="fw-semibold">
                                    Devir @(grp.DevirNo?.ToString() ?? "—")
                                    @if (grp.KapanmaTarihi.HasValue)
                                    {
                                        <span class="text-muted ms-1" style="font-size:0.85rem;">(@grp.KapanmaTarihi.Value.ToString("dd.MM.yyyy") kapanışı)</span>
                                    }
                                </span>
                                <span class="badge bg-secondary">@grp.KayitSayisi kayıt</span>
                                @if (isSon && yetki2 == 2)
                                {
                                    <form method="post" asp-page-handler="DevirGeriAl" class="d-inline ms-auto"
                                          onsubmit="return confirm('Devir #@grp.DevirNo geri alınacak. Tüm arşivlenmiş kayıtlar yeniden aktive edilecek.\n\nDevam etmek istiyor musunuz?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="devirNo"   value="@grp.DevirNo" />
                                        <input type="hidden" name="musteriId" value="@Model.musteriId" />
                                        <input type="hidden" name="pb"        value="@Model.pb" />
                                        <button class="btn btn-pastel-amber btn-sm">↩ Geri Al</button>
                                    </form>
                                }
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0" style="opacity:0.75; font-size:0.875rem;">
                                    <thead class="table-secondary" style="position:sticky;top:0;z-index:1;">
                                        <tr>
                                            <th style="width:100px;">Tarih</th>
                                            <th style="width:110px;">İşlem</th>
                                            <th style="width:130px;">Evrak No</th>
                                            <th>Açıklama</th>
                                            <th class="text-end" style="width:110px;">Borç (@Model.pb)</th>
                                            <th class="text-end" style="width:110px;">Alacak (@Model.pb)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in grp.Rows)
                                        {
                                            <tr>
                                                <td>@r.Tarih.ToString("dd.MM.yyyy")</td>
                                                <td>@r.IslemTuru</td>
                                                <td>@r.EvrakNo</td>
                                                <td>@r.Aciklama</td>
                                                <td class="text-end @(r.Borc > 0 ? "text-success" : "text-muted")">
                                                    @(r.Borc > 0 ? r.Borc.ToString("N2") : "–")
                                                </td>
                                                <td class="text-end @(r.Alacak > 0 ? "text-danger" : "text-muted")">
                                                    @(r.Alacak > 0 ? r.Alacak.ToString("N2") : "–")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-secondary fw-semibold">
                                            <td colspan="4" class="text-end">Grup Toplamı</td>
                                            <td class="text-end text-success">@grp.Rows.Sum(x => x.Borc).ToString("N2")</td>
                                            <td class="text-end text-danger">@grp.Rows.Sum(x => x.Alacak).ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    function arsivDetayGoster(devirNo) {
        document.getElementById('arsiv-list').style.display = 'none';
        document.querySelectorAll('[id^="arsiv-detay-"]').forEach(el => el.style.display = 'none');
        var detay = document.getElementById('arsiv-detay-' + devirNo);
        if (detay) detay.style.display = '';
    }
    function arsivListeyeDon() {
        document.querySelectorAll('[id^="arsiv-detay-"]').forEach(el => el.style.display = 'none');
        document.getElementById('arsiv-list').style.display = '';
    }
    document.getElementById('arsivModal').addEventListener('hidden.bs.modal', function () {
        arsivListeyeDon();
    });
</script>

</div>

@* ── Yardım Modal ──────────────────────────────────────────────── *@
<div class="modal fade" id="yardimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f0f7ff;border-bottom:1px solid #cce0ff;">
                <h5 class="modal-title fw-bold">❓ Cari Ekstre — Kullanım Kılavuzu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:14px;line-height:1.7;">
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📋 Genel Bakış</h6>
                    <p class="text-muted mb-2">Bu sayfa, seçili müşterinin belirli bir tarih aralığındaki tüm cari hareketlerini (borç, alacak, tahsilat) kronolojik sırayla listeler ve dönem bakiyesini hesaplar.</p>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">📊 Özet Kartlar</h6>
                    <ul class="mb-0">
                        <li><strong>Açılış Bakiyesi</strong> — Seçilen dönem başındaki bakiye.</li>
                        <li><strong>Dönem Borç</strong> — Dönem içinde oluşan toplam borç.</li>
                        <li><strong>Dönem Alacak</strong> — Dönem içinde yapılan toplam tahsilat/alacak.</li>
                        <li><strong>Kapanış Bakiyesi</strong> — Dönem sonu net bakiye.</li>
                    </ul>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">🎨 Satır Renk Kodları</h6>
                    <ul class="mb-0">
                        <li><strong>Mavi</strong> — Devir bakiyesi satırı.</li>
                        <li><strong>Yeşil arka plan</strong> — Tahsilat satırı.</li>
                        <li><strong>Kırmızı arka plan</strong> — Ödenmemiş borç satırı.</li>
                        <li><strong>Soluk / üstü çizik</strong> — Tahsil edilmiş borç (kapalı).</li>
                    </ul>
                </div>
                <div class="mb-0">
                    <h6 class="fw-bold border-bottom pb-1 mb-2" style="color:#1d4ed8;">⚙️ İşlemler</h6>
                    <ul class="mb-0">
                        <li><strong>Excel / PDF</strong> — Ekstreyi dışa aktarın.</li>
                        <li><strong>Tahsilat Yap</strong> — Müşteriden tahsilat kaydedin.</li>
                        <li><strong>Ödenmemiş Faturalar</strong> — Açık ve kısmen ödenmiş faturaları görün.</li>
                        <li><strong>Devir Al</strong> — Seçilen tarihe kadar hareketleri arşivleyin.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" style="background:#f8f9fa;">
                <button type="button" class="btn btn-pastel-blue" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@* ── Tahsilat Yap Modal ─────────────────────────────────────────── *@
<div class="modal fade" id="tahsilatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tahsilat Yap — @Model.MusteriAdi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="TahsilatYap">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Müşteri</label>
                        <input type="text" class="form-control" value="@Model.MusteriAdi" readonly />
                        <input type="hidden" name="musteriId" value="@Model.musteriId" />
                        <input type="hidden" name="pb" value="@Model.pb" />
                        <input type="hidden" name="d1" value="@(Model.d1?.ToString("yyyy-MM-dd"))" />
                        <input type="hidden" name="d2" value="@(Model.d2?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tarih</label>
                        <input type="date" name="tahsilatTarihi" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tutar (@Model.pb)</label>
                        <input type="number" step="0.01" min="0" name="tutar" class="form-control" placeholder="0.00" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <input type="text" name="aciklama" class="form-control" placeholder="Tahsilat açıklaması (opsiyonel)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-pastel-green">✔ Tahsil Et</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* "Ödendi Yap" sonrası modalı otomatik aç *@
@if (TempData["ReopenOdenmemis"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = new bootstrap.Modal(document.getElementById('odenmemisModal'));
            modal.show();
        });
    </script>
}