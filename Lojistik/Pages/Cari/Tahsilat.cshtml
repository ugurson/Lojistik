@page
@model Lojistik.Pages.Cari.TahsilatModel
@{
    ViewData["Title"] = "Tahsilat Ekle";
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Tahsilat Ekle</h2>
        <a asp-page="./Index" class="btn btn-pastel-blue btn-sm">← Cari Özeti</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }
    @if (TempData["StatusMessage"] is string msg)
    {
        <div class="alert alert-success">@msg</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Input.MusteriID" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Müşteri</label>
                        <input class="form-control" value="@Model.SeciliMusteri?.MusteriAdi" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tarih</label>
                        <input asp-for="Input.Tarih" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Para Birimi</label>
                        <select asp-for="Input.ParaBirimi" class="form-select">
                            <option>TL</option>
                            <option>EUR</option>
                            <option>USD</option>
                            <option>GBP</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tutar</label>
                        <input asp-for="Input.Tutar" type="text" inputmode="decimal" class="form-control tutar-input" placeholder="0,00" autocomplete="off" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Kur (opsiyonel)</label>
                        <input asp-for="Input.Kur" type="text" inputmode="decimal" class="form-control tutar-input" placeholder="0,000000" autocomplete="off" />
                        <div class="form-text">PB TL değilse boş bırakabilirsiniz.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Evrak No (opsiyonel)</label>
                        <input asp-for="Input.EvrakNo" class="form-control" maxlength="50" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Açıklama</label>
                        <input asp-for="Input.Aciklama" class="form-control" maxlength="300" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-pastel-green">Kaydet</button>
                    <a asp-page="./Index" class="btn btn-pastel-blue">Geri</a>
                </div>
            </form>

            <script>
                // Form gönderilmeden önce Türkçe formatlı tutarları normalize et
                // Örnek: "2.600,50" → "2600.50" | "2.600" → "2600"
                document.querySelector('form').addEventListener('submit', function () {
                    document.querySelectorAll('.tutar-input').forEach(function (input) {
                        var val = input.value.trim();
                        if (val === '') return;
                        // Binlik nokta ayıraçlarını kaldır, ondalık virgülü noktaya çevir
                        val = val.replace(/\./g, '').replace(',', '.');
                        input.value = val;
                    });
                });
            </script>
        </div>
    </div>

</div>
