@page "{id:int}"
@model Lojistik.Pages.Musteriler.DeleteModel
@{
    ViewData["Title"] = "Müşteri Sil";
    var m = Model.Musteri;
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0 text-danger">Müşteri Sil</h2>
        <a class="btn btn-pastel-blue btn-sm" asp-page="./Index">← Liste</a>
    </div>

    <div class="alert alert-danger py-2 mb-3">
        Bu kaydı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
    </div>

    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-3">
                <div class="col-6 col-md-4">
                    <div class="text-muted small">Müşteri Adı</div>
                    <div class="fw-semibold">@m.MusteriAdi</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Ülke</div>
                    <div>@m.Ulke?.UlkeAdi</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Şehir</div>
                    <div>@m.Sehir?.SehirAdi</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Telefon</div>
                    <div>@m.Telefon</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="text-muted small">E-posta</div>
                    <div>@m.Email</div>
                </div>
            </div>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Musteri.MusteriID" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-pastel-red">Evet, Sil</button>
            <a asp-page="./Index" class="btn btn-pastel-blue">İptal</a>
        </div>
    </form>

</div>
