@page "{id:int}"
@model Lojistik.Pages.Musteriler.DetailsModel
@{
    ViewData["Title"] = "Müşteri Detay";
    var m = Model.Musteri;
}

<div class="lj-page-compact">

    @* ─── BAŞLIK ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">@m.MusteriAdi</h2>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-pastel-amber" asp-page="./Edit"  asp-route-id="@m.MusteriID">Düzenle</a>
            <a class="btn btn-pastel-red"   asp-page="./Delete" asp-route-id="@m.MusteriID">Sil</a>
            <a class="btn btn-pastel-blue"  asp-page="./Index">← Liste</a>
        </div>
    </div>

    @* ─── MÜŞTERİ BİLGİLERİ ────────────────────────────────────── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold">Müşteri Bilgileri</div>
        <div class="card-body py-3">
            <div class="row g-3">
                <div class="col-6 col-md-4">
                    <div class="text-muted small">Müşteri Adı</div>
                    <div class="fw-semibold">@m.MusteriAdi</div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Durum</div>
                    <div>
                        @if (m.IsActive)
                        { <span class="badge bg-success bg-opacity-75">Aktif</span> }
                        else
                        { <span class="badge bg-secondary">Pasif</span> }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Ülke</div>
                    <div>@m.Ulke?.UlkeAdi</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Şehir</div>
                    <div>@m.Sehir?.SehirAdi</div>
                </div>
                <div class="col-6 col-md-5">
                    <div class="text-muted small">Adres</div>
                    <div>@m.Adres</div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Posta Kodu</div>
                    <div>@m.PostaKodu</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Telefon</div>
                    <div>@m.Telefon</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="text-muted small">E-posta</div>
                    <div>@m.Email</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="text-muted small">Yetkili İsim</div>
                    <div>@m.YetkiliIsim</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="text-muted small">Vergi Dairesi</div>
                    <div>@m.VergiDairesi</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Vergi No</div>
                    <div>@m.VergiNo</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Gümrük Kodu</div>
                    <div>@m.GumrukKod</div>
                </div>
            </div>
        </div>
    </div>

</div>
