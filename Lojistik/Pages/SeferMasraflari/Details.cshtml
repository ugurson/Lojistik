@* Pages/SeferMasraflari/Details.cshtml *@
@page "{id:int}"
@model Lojistik.Pages.SeferMasraflari.DetailsModel
@{
    ViewData["Title"] = "Masraf Detayı";
    var x = Model.Data!;
}

<div class="lj-page-compact">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Masraf Detayı</h2>
        <div class="d-flex gap-2">
            <a asp-page="./Edit"   asp-route-id="@x.SeferMasrafID" class="btn btn-pastel-amber btn-sm">Düzenle</a>
            <a asp-page="./Delete" asp-route-id="@x.SeferMasrafID" class="btn btn-pastel-red btn-sm">Sil</a>
            <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID" class="btn btn-pastel-blue btn-sm">← Sefer</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-2" style="font-size:0.875rem;">
                <div class="col-sm-3 text-muted">Sefer</div>
                <div class="col-sm-9">
                    <a asp-page="/Seferler/Details" asp-route-id="@x.SeferID">SF-@x.SeferID</a>
                </div>
                <div class="col-sm-3 text-muted">Tarih</div>
                <div class="col-sm-9">@x.Tarih.ToString("dd.MM.yyyy")</div>
                <div class="col-sm-3 text-muted">Tip</div>
                <div class="col-sm-9">
                    <span class="badge bg-light text-dark border">@x.MasrafTipi</span>
                </div>
                <div class="col-sm-3 text-muted">Tutar</div>
                <div class="col-sm-9 net-neg fw-semibold">@x.Tutar.ToString("N2") @x.ParaBirimi</div>
                <div class="col-sm-3 text-muted">Fatura/Belge</div>
                <div class="col-sm-9">@(!string.IsNullOrWhiteSpace(x.FaturaBelgeNo) ? x.FaturaBelgeNo : "—")</div>
                <div class="col-sm-3 text-muted">Yer</div>
                <div class="col-sm-9">@(!string.IsNullOrWhiteSpace(x.Yer) ? x.Yer : "—")</div>
                <div class="col-sm-3 text-muted">Ülke</div>
                <div class="col-sm-9">@(!string.IsNullOrWhiteSpace(x.Ulke) ? x.Ulke : "—")</div>
                <div class="col-sm-3 text-muted">Notlar</div>
                <div class="col-sm-9 text-prewrap">@x.Notlar</div>
            </div>
        </div>
    </div>

</div>
